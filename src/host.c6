/* host.c6 —— 宿主无关的日志出口（native 与 wasm 都可用） */
#include <stdio.h>
#include "c6sim.h"

void host_diag(const char *msg)
{
    puts(msg);
}

void diag_u64(const char *tag, u64 value)
{
    char buf[128] = {0};
    u32 i = 0, j = 0;
    const char hex[] = "0123456789abcdef";
    while (tag[i] != 0 && i < 80) {
        buf[j++] = tag[i];
        i++;
    }
    buf[j++] = ':';
    buf[j++] = ' ';
    buf[j++] = '0';
    buf[j++] = 'x';
    for (i = 0; i < 16; i++) {
        u32 shift = (15 - i) * 4;
        buf[j++] = hex[(value >> shift) & 15];
    }
    buf[j] = 0;
    puts(buf);
}
