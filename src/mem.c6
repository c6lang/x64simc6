/* mem.c6 —— 客户机物理内存、MMIO 分派与 4 级分页 */
#if !defined(C6_WASM)
#include <stdio.h>
#include <unistd.h>
#endif
#include "c6sim.h"

#define TLB_BITS 13
#define TLB_SIZE 8192
#define TLB_MASK (TLB_SIZE - 1)

static u64 tlb_tag[TLB_SIZE];
static u64 tlb_val[TLB_SIZE];

/* tlb_val 位：bit0=P, bit1=W, bit2=U, bit3=X，高位是 4KiB 对齐的物理页基址 */
#define TV_P 0x1ull
#define TV_W 0x2ull
#define TV_U 0x4ull
#define TV_X 0x8ull

void mem_tlb_flush(void)
{
    u32 i = 0;
    for (i = 0; i < TLB_SIZE; i++) {
        tlb_tag[i] = ~((u64)0);
        tlb_val[i] = 0;
    }
}

static u8 phys_r8(u64 a)
{
    /* MMIO 窗口都在 0xfeb00000 以上，先判 RAM 可以省掉三次区间比较 */
    if (a < RAM_SIZE)
        return g_m.ram[(u32)a];
    if (a >= LAPIC_PA && a < LAPIC_PA + 0x1000)
        return (u8)mmio_r(a, 1);
    if (a >= VIRTIO_NET_PA && a < VIRTIO_NET_PA + 0x1000)
        return (u8)mmio_r(a, 1);
    if (a >= C6BLK_PA && a < C6BLK_PA + 0x1000)
        return (u8)mmio_r(a, 1);
    return 0xff;
}

static u16 phys_r16(u64 a)
{
    if (a < RAM_SIZE - 1) {
        u32 p = (u32)a;
        return (u16)g_m.ram[p] | ((u16)g_m.ram[p + 1] << 8);
    }
    if (a >= LAPIC_PA && a < LAPIC_PA + 0x1000)
        return (u16)mmio_r(a, 2);
    if (a >= VIRTIO_NET_PA && a < VIRTIO_NET_PA + 0x1000)
        return (u16)mmio_r(a, 2);
    if (a >= C6BLK_PA && a < C6BLK_PA + 0x1000)
        return (u16)mmio_r(a, 2);
    return 0xffff;
}

static u32 phys_r32(u64 a)
{
    if (a < RAM_SIZE - 3) {
        u32 p = (u32)a;
        return (u32)g_m.ram[p] | ((u32)g_m.ram[p + 1] << 8) |
               ((u32)g_m.ram[p + 2] << 16) | ((u32)g_m.ram[p + 3] << 24);
    }
    if (a >= LAPIC_PA && a < LAPIC_PA + 0x1000)
        return (u32)mmio_r(a, 4);
    if (a >= VIRTIO_NET_PA && a < VIRTIO_NET_PA + 0x1000)
        return (u32)mmio_r(a, 4);
    if (a >= C6BLK_PA && a < C6BLK_PA + 0x1000)
        return (u32)mmio_r(a, 4);
    return 0xffffffff;
}

static u64 phys_r64(u64 a)
{
    if (a < RAM_SIZE - 7) {
        u32 p = (u32)a;
        u64 v = 0;
        v = (u64)g_m.ram[p] | ((u64)g_m.ram[p + 1] << 8) |
            ((u64)g_m.ram[p + 2] << 16) | ((u64)g_m.ram[p + 3] << 24);
        v |= ((u64)g_m.ram[p + 4] | ((u64)g_m.ram[p + 5] << 8) |
              ((u64)g_m.ram[p + 6] << 16) | ((u64)g_m.ram[p + 7] << 24)) << 32;
        return v;
    }
    return (u64)phys_r32(a) | ((u64)phys_r32(a + 4) << 32);
}

static void phys_w8(u64 a, u8 v)
{
    if (a < RAM_SIZE) {
        g_m.ram[(u32)a] = v;
        return;
    }
    if (a >= LAPIC_PA && a < LAPIC_PA + 0x1000) {
        mmio_w(a, 1, v);
        return;
    }
    if (a >= VIRTIO_NET_PA && a < VIRTIO_NET_PA + 0x1000) {
        mmio_w(a, 1, v);
        return;
    }
    if (a >= C6BLK_PA && a < C6BLK_PA + 0x1000) {
        mmio_w(a, 1, v);
        return;
    }
}

static void phys_w16(u64 a, u16 v)
{
    if (a < RAM_SIZE - 1) {
        u32 p = (u32)a;
        g_m.ram[p] = (u8)v;
        g_m.ram[p + 1] = (u8)(v >> 8);
        return;
    }
    if (a >= LAPIC_PA && a < LAPIC_PA + 0x1000) {
        mmio_w(a, 2, v);
        return;
    }
    if (a >= VIRTIO_NET_PA && a < VIRTIO_NET_PA + 0x1000) {
        mmio_w(a, 2, v);
        return;
    }
    if (a >= C6BLK_PA && a < C6BLK_PA + 0x1000) {
        mmio_w(a, 2, v);
        return;
    }
}

static void phys_w32(u64 a, u32 v)
{
    if (a < RAM_SIZE - 3) {
        u32 p = (u32)a;
        g_m.ram[p] = (u8)v;
        g_m.ram[p + 1] = (u8)(v >> 8);
        g_m.ram[p + 2] = (u8)(v >> 16);
        g_m.ram[p + 3] = (u8)(v >> 24);
        return;
    }
    if (a >= LAPIC_PA && a < LAPIC_PA + 0x1000) {
        mmio_w(a, 4, v);
        return;
    }
    if (a >= VIRTIO_NET_PA && a < VIRTIO_NET_PA + 0x1000) {
        mmio_w(a, 4, v);
        return;
    }
    if (a >= C6BLK_PA && a < C6BLK_PA + 0x1000) {
        mmio_w(a, 4, v);
        return;
    }
}

static void phys_w64(u64 a, u64 v)
{
    if (a < RAM_SIZE - 7) {
        phys_w32(a, (u32)v);
        phys_w32(a + 4, (u32)(v >> 32));
        return;
    }
    phys_w32(a, (u32)v);
    phys_w32(a + 4, (u32)(v >> 32));
}

static void pg_fault(u64 va, u32 wr, u32 us, u32 *pf_ec)
{
    u32 ec = (wr ? 2 : 0) | (us ? 4 : 0);
    u32 sup0 = g_m.emu_sup;
    if (pf_ec)
        *pf_ec = ec;
    g_m.cpu.fault_abort = 1;
    /* 已经有一条同步异常等着投递时，后续访问故障属于同一条指令的连带效应，
     * 不能覆盖 CR2/错误码（否则内核看到的是错的故障地址）。 */
    if (g_m.cpu.exc_pending)
        return;
    g_m.cpu.cr[2] = va;
#if !defined(C6_WASM)
    g_m.emu_sup = 1;   /* dump 里的探针读取按内核权限，不能被当成用户缺页 */
    if (g_m.rip_dump_en && va < 0x8000000000000000ull && g_m.ppt_count < 400) {
        g_m.ppt_count++;
        printf("[PPT] va=%llx wr=%u us=%u rip=%llx\n",
               (unsigned long long)va, wr, us,
               (unsigned long long)g_m.cpu.rip);
        /* 前面几个用户缺页都是正常的（入口栈页按需分配）；这里专门抓
         * 高地址共享库（musl/ld）里的缺页，那才是真正的异常。 */
        if (g_m.cpu.rip >= 0x700000000000ull && g_m.ppt_dumps < 3) {
            u32 k = 0;
            u32 i = 0;
            g_m.ppt_dumps++;
            printf("[PPR] user_entries=%llu cr3=%llx sel_cs=%llx sel_ss=%llx\n",
                   (unsigned long long)g_m.user_entries,
                   (unsigned long long)g_m.cpu.cr[3],
                   (unsigned long long)g_m.cpu.sel[1],
                   (unsigned long long)g_m.cpu.sel[2]);
            for (i = 0; i < 16; i++)
                printf("[PPG] r%u=%llx\n", i,
                       (unsigned long long)g_m.cpu.r[i]);
            printf("[PPS] rsp=%llx\n", (unsigned long long)g_m.cpu.r[4]);
            for (k = 0; k < 40; k++) {
                u64 sv = 0;
                if (g_m.cpu.r[4] + k * 8 < RAM_SIZE)
                    sv = mem_r64(g_m.cpu.r[4] + k * 8);
                printf("[PPK] %2u %llx\n", k, (unsigned long long)sv);
            }
            for (k = 0; k < 400; k++) {
                u32 idx = (g_m.rip_ring_i + k) & 4095u;
                printf("[PPR] %2u %llx\n", k,
                       (unsigned long long)g_m.rip_ring[idx]);
            }
        }
        fflush(stdout);
    }
#endif
    g_m.emu_sup = sup0;  /* 恢复调用者状态：可能本来就在 cpu_deliver 内部 */
    raise_exception(&g_m.cpu, EXC_PF, 1, ec);
}


/* ---- 展开式翻译快路径 ----
 * c6c 不做内联，以前「取指/读写」每次都要经过
 *   mem_fetch8 -> pg_check -> pg_fast -> phys_r*
 * 四层真实函数调用。这里把与 mem_translate() **严格同序**的快路径
 * （未开分页 -> direct map -> 高半区两窗口 -> TLB）和一个 RAM 直读
 * 合成宏展开，只有 MMIO/缺页/调试对拍才落回函数调用。
 * 权限语义、缺页时机、g_cc/g_no_fetch/g_no_data 开关都与慢路径一致。 */
#define DM_BASE 0xffff888000000000ull

#define TR_PA(va, wr, user, no, outpa) do { \
    u64 _v = (u64)(va); \
    u64 _pa = 0; \
    if ((g_m.cpu.cr[0] & CR0_PG) != 0) { \
        /* 三个互不重叠的线性窗口按命中率排序：direct map、内核高半区两段 */ \
        _pa = _v - DM_BASE; \
        if (_pa >= RAM_SIZE) { \
            _pa = _v - 0xffffffff80000000ull; \
            if (_pa >= RAM_SIZE) { \
                _pa = _v - 0xffffffff00000000ull; \
                if (_pa >= RAM_SIZE) { \
                    _pa = PG_FAST_MISS; \
                    if (no) { \
                        /* 调试开关：跳过 TLB 快路径 */ \
                    } else if (g_cc) { \
                        _pa = pg_check(_v, (wr), (user), pg_fast(_v, (wr), (user))); \
                    } else { \
                        u64 _vpn = _v >> 12; \
                        u32 _ti = (u32)(_vpn & TLB_MASK); \
                        if (tlb_tag[_ti] == _vpn) { \
                            u64 _tv = tlb_val[_ti]; \
                            u32 _fl = (u32)(_tv & 15); \
                            if ((_fl & TV_P) && (!(wr) || (_fl & TV_W)) && \
                                (!((((g_m.cpu.sel[1] & 3) != 0) && !g_m.emu_sup) || (user) == 1) || \
                                 (_fl & TV_U)) && \
                                ((user) != 2 || (_fl & TV_X))) \
                                _pa = (_tv & ~((u64)15)) | (_v & 0xfff); \
                        } \
                    } \
                    if (_pa == PG_FAST_MISS) \
                        _pa = mem_translate(_v, (wr), (user), 0); \
                } \
            } \
        } \
    } else { \
        _pa = _v; \
    } \
    (outpa) = _pa; \
} while (0)

/* RAM 直读/直写（pa 已确定且不越界）：一步到 g_m.ram，不再调 phys_* */
#define RAM_R8(pa)   ((u8)g_m.ram[(u32)(pa)])
#define RAM_R16(pa)  ((u16)((u32)g_m.ram[(u32)(pa)] | ((u32)g_m.ram[(u32)(pa)+1] << 8)))
#define RAM_R32(pa)  ((u32)((u32)g_m.ram[(u32)(pa)] | ((u32)g_m.ram[(u32)(pa)+1] << 8) | \
                      ((u32)g_m.ram[(u32)(pa)+2] << 16) | ((u32)g_m.ram[(u32)(pa)+3] << 24)))
#define RAM_R64(pa)  ((u64)RAM_R32(pa) | ((u64)RAM_R32((pa)+4) << 32))
#define RAM_W16(pa, v) do { \
    g_m.ram[(u32)(pa)] = (u8)(v); \
    g_m.ram[(u32)(pa)+1] = (u8)((u64)(v) >> 8); \
} while (0)
#define RAM_W32(pa, v) do { \
    g_m.ram[(u32)(pa)] = (u8)(v); \
    g_m.ram[(u32)(pa)+1] = (u8)((u64)(v) >> 8); \
    g_m.ram[(u32)(pa)+2] = (u8)((u64)(v) >> 16); \
    g_m.ram[(u32)(pa)+3] = (u8)((u64)(v) >> 24); \
} while (0)
#define RAM_W64(pa, v) do { RAM_W32((pa), (u64)(v)); RAM_W32((pa)+4, (u64)(v) >> 32); } while (0)

/* user: 0=内核数据, 1=用户数据, 2=取指 */
u64 mem_translate(u64 va, u32 wr, u32 user, u32 *pf_ec)
{
    u64 vpn = 0, idx = 0, e = 0, pa = 0, flags = 0;
    /* user: 0=内核数据, 1=显式用户访问, 2=取指（查 NX）。
     * SDM：U/S 位和 #PF 错误码 bit2 都取决于 CPL——CPL3 的任何访问都要求
     * U/S=1；CPL0 的 copy_from_user 之类不要求。 */
    u32 level = 0, shift = 0, is_user = 0;
    u32 cpl3 = ((g_m.cpu.sel[1] & 3) != 0 && !g_m.emu_sup) ? 1 : 0;

    is_user = cpl3 | (user == 1);
    g_m.mt_calls++;
#if !defined(C6_WASM)
    if ((g_m.mt_calls & 0x3fffu) == 0 && g_m.watch_fd >= 0) {
        u64 mb[3] = {0, 0, 0};
        mb[0] = g_m.mt_calls;
        mb[1] = va;
        mb[2] = g_m.cur_rip;
        write(g_m.watch_fd, mb, 24);
    }
#endif

    if (!(g_m.cpu.cr[0] & CR0_PG))
        return va;

    /* 内核早期 direct map（page_offset_base=0xffff888000000000）按物理地址直映 */
    if (va >= 0xffff888000000000ull && va < 0xffff888000000000ull + RAM_SIZE)
        return va - 0xffff888000000000ull;

    /* 内核早期有两个高半区窗口；页表遍历失败时按物理地址直接回退。 */
    if (va >= 0xffffffff00000000ull) {
        u64 p = va - 0xffffffff00000000ull;
        if (p < RAM_SIZE) return p;
        p = va - 0xffffffff80000000ull;
        if (p < RAM_SIZE) return p;
    }

    vpn = va >> 12;
    idx = vpn & TLB_MASK;
    if (tlb_tag[idx] == vpn) {
        flags = tlb_val[idx] & 15;
        if ((flags & TV_P) && (!wr || (flags & TV_W)) &&
            (!is_user || (flags & TV_U)) && (!user || 1) &&
            (user != 2 || (flags & TV_X)))   /* TV_X = 该页可执行：取指必须要求它 */
            return (tlb_val[idx] & ~((u64)15)) | (va & 0xfff);
    }

    pa = g_m.cpu.cr[3] & ~((u64)0xfff);
    for (level = 0; level < 4; level++) {
        shift = 39 - level * 9;
        e = phys_r64(pa + (((va >> shift) & 0x1ff) << 3));
        if (!(e & 1)) {
            pg_fault(va, wr, is_user, pf_ec);
            return 0;
        }
        if (is_user && !(e & 4)) {
            pg_fault(va, wr, 1, pf_ec);
            return 0;
        }
        if (wr && !(e & 2)) {
            pg_fault(va, wr, is_user, pf_ec);
            return 0;
        }
        if (level == 3 && (e & 0x80)) {
            /* 1 GiB 页 */
            if ((g_m.cpu.efer & EFER_NXE) && (e & ((u64)1 << 63)) && user == 2) {
                pg_fault(va, wr, is_user, pf_ec);
                return 0;
            }
            flags = TV_P;
            if (e & 2) flags |= TV_W;
            if (e & 4) flags |= TV_U;
            if (!(e & ((u64)1 << 63))) flags |= TV_X;
            pa = (e & 0x000fffffc0000000ull) | (va & 0x3fffffff);
            tlb_tag[idx] = vpn;
            tlb_val[idx] = (pa & ~((u64)0xfff)) | flags;
            return pa;
        }
        if (level == 2 && (e & 0x80)) {
            /* 2 MiB 页 */
            if ((g_m.cpu.efer & EFER_NXE) && (e & ((u64)1 << 63)) && user == 2) {
                pg_fault(va, wr, is_user, pf_ec);
                return 0;
            }
            flags = TV_P;
            if (e & 2) flags |= TV_W;
            if (e & 4) flags |= TV_U;
            if (!(e & ((u64)1 << 63))) flags |= TV_X;
            pa = (e & 0x000fffffffe00000ull) | (va & 0x1fffff);
            tlb_tag[idx] = vpn;
            tlb_val[idx] = (pa & ~((u64)0xfff)) | flags;
            return pa;
        }
        pa = e & 0x000ffffffffff000ull;
    }
    if ((g_m.cpu.efer & EFER_NXE) && (e & ((u64)1 << 63)) && user == 2) {
        pg_fault(va, wr, is_user, pf_ec);
        return 0;
    }
    /* 4 KiB 页：TV_X 表示「该页可执行」，必须按 PTE 的 NX 位来置；TV_U
     * 表示「用户可访问」，必须按 U/S 位来置。历史上这里写死成
     * TV_P|TV_U|TV_X（等于所有页都「可执行」），而取指要求 TV_X 存在，
     * 于是**每次取指都 TLB 不命中**、每条指令都走一遍四级页表
     * （实测 hits=0 / walks=20,000,002，10M 条指令 31 秒）。 */
    flags = TV_P;
    if (e & 2) flags |= TV_W;
    if (e & 4) flags |= TV_U;
    if (!(e & ((u64)1 << 63))) flags |= TV_X;
    pa = (e & 0x000ffffffffff000ull) | (va & 0xfff);
    tlb_tag[idx] = vpn;
    tlb_val[idx] = (pa & ~((u64)0xfff)) | flags;
    return pa;
}

/* ---- 页表快通道（(c) 的安全形态）----
 * pg_fast() 是 mem_translate() 前半段的**逐行等价副本**，顺序完全一致：
 *   1) 未开分页 -> 恒等映射
 *   2) 内核 direct map 窗口 -> va - 0xffff888000000000
 *   3) 内核高半区两个窗口 -> 物理直映
 *   4) TLB 命中 -> (tlb_val & ~15) | 页内偏移（含 TV_P/TV_W/TV_U/TV_X 四项判断）
 * 不命中返回 PG_FAST_MISS，调用方原样落回 mem_translate()，所以不会出现
 * "快路径和慢路径结论不同"这一类 bug；失效仍然只由 mem_tlb_flush() 负责，
 * 不额外持有一份翻译状态。
 * 教训：最初实现时把 TLB 判断放在了三条快捷路径**前面**，于是 direct map
 * 上存在陈旧 TLB 项时快路径返回的物理页与慢路径不同，整机引导里表现为
 * init 起来后 kernel panic（CPL3 取指 va=0 命中、慢路径本该缺页）。
 * 现在顺序与慢路径严格一致。 */
#define PG_FAST_MISS (~((u64)0))

static u64 pg_fast(u64 va, u32 wr, u32 user)
{
    u64 vpn = 0, ti = 0, tv = 0;
    u32 fl = 0, isu = 0;
    if (!(g_m.cpu.cr[0] & CR0_PG))
        return va;
    if (va >= 0xffff888000000000ull && va < 0xffff888000000000ull + RAM_SIZE)
        return va - 0xffff888000000000ull;
    if (va >= 0xffffffff00000000ull) {
        u64 p = va - 0xffffffff00000000ull;
        if (p < RAM_SIZE) return p;
        p = va - 0xffffffff80000000ull;
        if (p < RAM_SIZE) return p;
    }
    vpn = va >> 12;
    ti = vpn & TLB_MASK;
    if (tlb_tag[ti] != vpn)
        return PG_FAST_MISS;
    tv = tlb_val[ti];
    fl = (u32)(tv & 15);
    isu = (((g_m.cpu.sel[1] & 3) != 0) && !g_m.emu_sup) ? 1 : 0;
    if ((fl & TV_P) && (!wr || (fl & TV_W)) &&
        (!isu || (fl & TV_U)) && (user != 2 || (fl & TV_X)))
        return (tv & ~((u64)15)) | (va & 0xfff);
    return PG_FAST_MISS;
}

/* --cachecheck：把快路径的结果和慢路径对拍，一旦不同就打印现场并停机。
 * 只在定位问题时打开（约 1.5x 变慢），默认关闭。 */
static u64 pg_check(u64 va, u32 wr, u32 user, u64 pa_fast)
{
    u64 pa_slow = 0;
    if (!g_cc) return pa_fast;
    if (pa_fast == PG_FAST_MISS) return pa_fast;
    pa_slow = mem_translate(va, wr, user, 0);
    if (pa_slow != pa_fast) {
        printf("[CC] pa mismatch va=%llx fast=%llx slow=%llx wr=%u user=%u rip=%llx\n",
               (unsigned long long)va, (unsigned long long)pa_fast,
               (unsigned long long)pa_slow, wr, user,
               (unsigned long long)g_m.cur_rip);
        g_m.halted = 1;
    }
    g_m.cpu.fault_abort = 0;
    return pa_fast;
}

u8 mem_fetch8(u64 a)
{
    u64 pa = 0;
    TR_PA(a, 0, 2, g_no_fetch, pa);
    if (pa < RAM_SIZE)
        return RAM_R8(pa);
    return phys_r8(pa);
}

u8 mem_r8(u64 a)
{
    u64 pa = 0;
    TR_PA(a, 0, 0, g_no_data, pa);
    if (pa < RAM_SIZE)
        return RAM_R8(pa);
    return phys_r8(pa);
}

u16 mem_r16(u64 a)
{
    u64 pa = 0;
    TR_PA(a, 0, 0, g_no_data, pa);
    if ((pa & 0xfff) > 0xffe)
        return (u16)mem_r8(a) | ((u16)mem_r8(a + 1) << 8);
    if (pa < RAM_SIZE - 1)
        return RAM_R16(pa);
    return phys_r16(pa);
}

u32 mem_r32(u64 a)
{
    u64 pa = 0;
    TR_PA(a, 0, 0, g_no_data, pa);
    /* 跨页访问必须按字节绕行：4 个字节可能分属两个物理页 */
    if ((pa & 0xfff) > 0xffc) {
        u32 v = 0;
        u32 i = 0;
        for (i = 0; i < 4; i++)
            v |= (u32)mem_r8(a + i) << (i * 8);
        return v;
    }
    if (pa < RAM_SIZE - 3)
        return RAM_R32(pa);
    return phys_r32(pa);
}

u64 mem_r64(u64 a)
{
    u64 pa = 0;
    TR_PA(a, 0, 0, g_no_data, pa);
    if ((pa & 0xfffull) > 0xff8ull)
        return (u64)mem_r32(a) | ((u64)mem_r32(a + 4) << 32);
    if (pa < RAM_SIZE - 7)
        return RAM_R64(pa);
    return phys_r64(pa);
}

void mem_w8(u64 a, u8 v)
{
    u64 pa = 0;
    if (g_m.cpu.fault_abort) return;   /* 指令已因缺页中止，写操作一律丢弃 */
    TR_PA(a, 1, 0, g_no_data, pa);
    if (pa < RAM_SIZE) {
        g_m.ram[(u32)pa] = v;
        return;
    }
    phys_w8(pa, v);
}

void mem_w16(u64 a, u16 v)
{
    u64 pa = 0;
    if (g_m.cpu.fault_abort) return;   /* 指令已因缺页中止，写操作一律丢弃 */
    TR_PA(a, 1, 0, g_no_data, pa);
    if ((pa & 0xfff) > 0xffe) {
        mem_w8(a, (u8)v);
        mem_w8(a + 1, (u8)(v >> 8));
        return;
    }
    if (pa < RAM_SIZE - 1) {
        RAM_W16(pa, v);
        return;
    }
    phys_w16(pa, v);
}

void mem_w32(u64 a, u32 v)
{
    u64 pa = 0;
    if (g_m.cpu.fault_abort) return;   /* 指令已因缺页中止，写操作一律丢弃 */
    TR_PA(a, 1, 0, g_no_data, pa);
    if ((pa & 0xfff) > 0xffc) {
        u32 i = 0;
        for (i = 0; i < 4; i++)
            mem_w8(a + i, (u8)(v >> (i * 8)));
        return;
    }
    if (pa < RAM_SIZE - 3) {
        RAM_W32(pa, v);
        return;
    }
    phys_w32(pa, v);
}

void mem_w64(u64 a, u64 v)
{
    u64 pa = 0;
    if (g_m.cpu.fault_abort) return;   /* 指令已因缺页中止，写操作一律丢弃 */
    TR_PA(a, 1, 0, g_no_data, pa);
    if ((pa & 0xfffull) > 0xff8ull) {
        mem_w32(a, (u32)v);
        mem_w32(a + 4, (u32)(v >> 32));
        return;
    }
    if (pa < RAM_SIZE - 7) {
        RAM_W64(pa, v);
        return;
    }
    phys_w64(pa, v);
}

void mem_copy_from(u64 dst, const u8 *src, u64 n)
{
    u64 i = 0;
    for (i = 0; i < n; i++)
        mem_w8(dst + i, src[i]);
}
