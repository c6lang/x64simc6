/* mem.c6 —— 客户机物理内存、MMIO 分派与 4 级分页 */
#if !defined(C6_WASM)
#include <stdio.h>
#endif
#include "c6sim.h"

#define TLB_BITS 13
#define TLB_SIZE (1 << TLB_BITS)
#define TLB_MASK (TLB_SIZE - 1)

static u64 tlb_tag[TLB_SIZE];
static u64 tlb_val[TLB_SIZE];

/* tlb_val 位：bit0=P, bit1=W, bit2=U, bit3=X，高位是 4KiB 对齐的物理页基址 */
#define TV_P ((u64)1 << 0)
#define TV_W ((u64)1 << 1)
#define TV_U ((u64)1 << 2)
#define TV_X ((u64)1 << 3)

void mem_tlb_flush(void)
{
    u32 i = 0;
    for (i = 0; i < TLB_SIZE; i++) {
        tlb_tag[i] = ~((u64)0);
        tlb_val[i] = 0;
    }
}

static u8 phys_r8(u64 a)
{
    /* MMIO 窗口都在 0xfeb00000 以上，先判 RAM 可以省掉三次区间比较 */
    if (a < RAM_SIZE)
        return g_m.ram[(u32)a];
    if (a >= LAPIC_PA && a < LAPIC_PA + 0x1000)
        return (u8)mmio_r(a, 1);
    if (a >= VIRTIO_NET_PA && a < VIRTIO_NET_PA + 0x1000)
        return (u8)mmio_r(a, 1);
    if (a >= C6BLK_PA && a < C6BLK_PA + 0x1000)
        return (u8)mmio_r(a, 1);
    return 0xff;
}

static u16 phys_r16(u64 a)
{
    if (a < RAM_SIZE - 1) {
        u32 p = (u32)a;
        return (u16)g_m.ram[p] | ((u16)g_m.ram[p + 1] << 8);
    }
    if (a >= LAPIC_PA && a < LAPIC_PA + 0x1000)
        return (u16)mmio_r(a, 2);
    if (a >= VIRTIO_NET_PA && a < VIRTIO_NET_PA + 0x1000)
        return (u16)mmio_r(a, 2);
    if (a >= C6BLK_PA && a < C6BLK_PA + 0x1000)
        return (u16)mmio_r(a, 2);
    return 0xffff;
}

static u32 phys_r32(u64 a)
{
    if (a < RAM_SIZE - 3) {
        u32 p = (u32)a;
        return (u32)g_m.ram[p] | ((u32)g_m.ram[p + 1] << 8) |
               ((u32)g_m.ram[p + 2] << 16) | ((u32)g_m.ram[p + 3] << 24);
    }
    if (a >= LAPIC_PA && a < LAPIC_PA + 0x1000)
        return (u32)mmio_r(a, 4);
    if (a >= VIRTIO_NET_PA && a < VIRTIO_NET_PA + 0x1000)
        return (u32)mmio_r(a, 4);
    if (a >= C6BLK_PA && a < C6BLK_PA + 0x1000)
        return (u32)mmio_r(a, 4);
    return 0xffffffff;
}

static u64 phys_r64(u64 a)
{
    if (a < RAM_SIZE - 7) {
        u32 p = (u32)a;
        u64 v = 0;
        v = (u64)g_m.ram[p] | ((u64)g_m.ram[p + 1] << 8) |
            ((u64)g_m.ram[p + 2] << 16) | ((u64)g_m.ram[p + 3] << 24);
        v |= ((u64)g_m.ram[p + 4] | ((u64)g_m.ram[p + 5] << 8) |
              ((u64)g_m.ram[p + 6] << 16) | ((u64)g_m.ram[p + 7] << 24)) << 32;
        return v;
    }
    return (u64)phys_r32(a) | ((u64)phys_r32(a + 4) << 32);
}

static void phys_w8(u64 a, u8 v)
{
    if (a < RAM_SIZE) {
        g_m.ram[(u32)a] = v;
        return;
    }
    if (a >= LAPIC_PA && a < LAPIC_PA + 0x1000) {
        mmio_w(a, 1, v);
        return;
    }
    if (a >= VIRTIO_NET_PA && a < VIRTIO_NET_PA + 0x1000) {
        mmio_w(a, 1, v);
        return;
    }
    if (a >= C6BLK_PA && a < C6BLK_PA + 0x1000) {
        mmio_w(a, 1, v);
        return;
    }
}

static void phys_w16(u64 a, u16 v)
{
    if (a < RAM_SIZE - 1) {
        u32 p = (u32)a;
        g_m.ram[p] = (u8)v;
        g_m.ram[p + 1] = (u8)(v >> 8);
        return;
    }
    if (a >= LAPIC_PA && a < LAPIC_PA + 0x1000) {
        mmio_w(a, 2, v);
        return;
    }
    if (a >= VIRTIO_NET_PA && a < VIRTIO_NET_PA + 0x1000) {
        mmio_w(a, 2, v);
        return;
    }
    if (a >= C6BLK_PA && a < C6BLK_PA + 0x1000) {
        mmio_w(a, 2, v);
        return;
    }
}

static void phys_w32(u64 a, u32 v)
{
    if (a < RAM_SIZE - 3) {
        u32 p = (u32)a;
        g_m.ram[p] = (u8)v;
        g_m.ram[p + 1] = (u8)(v >> 8);
        g_m.ram[p + 2] = (u8)(v >> 16);
        g_m.ram[p + 3] = (u8)(v >> 24);
        return;
    }
    if (a >= LAPIC_PA && a < LAPIC_PA + 0x1000) {
        mmio_w(a, 4, v);
        return;
    }
    if (a >= VIRTIO_NET_PA && a < VIRTIO_NET_PA + 0x1000) {
        mmio_w(a, 4, v);
        return;
    }
    if (a >= C6BLK_PA && a < C6BLK_PA + 0x1000) {
        mmio_w(a, 4, v);
        return;
    }
}

static void phys_w64(u64 a, u64 v)
{
    if (a < RAM_SIZE - 7) {
        phys_w32(a, (u32)v);
        phys_w32(a + 4, (u32)(v >> 32));
        return;
    }
    phys_w32(a, (u32)v);
    phys_w32(a + 4, (u32)(v >> 32));
}

static void pg_fault(u64 va, u32 wr, u32 us, u32 *pf_ec)
{
    u32 ec = (wr ? 2 : 0) | (us ? 4 : 0);
    u32 sup0 = g_m.emu_sup;
    if (pf_ec)
        *pf_ec = ec;
    g_m.cpu.cr[2] = va;
#if !defined(C6_WASM)
    g_m.emu_sup = 1;   /* dump 里的探针读取按内核权限，不能被当成用户缺页 */
    if (g_m.rip_dump_en && va < 0x8000000000000000ull && g_m.ppt_count < 400) {
        g_m.ppt_count++;
        printf("[PPT] va=%llx wr=%u us=%u rip=%llx\n",
               (unsigned long long)va, wr, us,
               (unsigned long long)g_m.cpu.rip);
        if (g_m.ppt_dumps < 2) {
            u32 k = 0;
            u32 i = 0;
            g_m.ppt_dumps++;
            printf("[PPR] user_entries=%llu cr3=%llx sel_cs=%llx sel_ss=%llx\n",
                   (unsigned long long)g_m.user_entries,
                   (unsigned long long)g_m.cpu.cr[3],
                   (unsigned long long)g_m.cpu.sel[1],
                   (unsigned long long)g_m.cpu.sel[2]);
            for (i = 0; i < 16; i++)
                printf("[PPG] r%u=%llx\n", i,
                       (unsigned long long)g_m.cpu.r[i]);
            printf("[PPS] rsp=%llx\n", (unsigned long long)g_m.cpu.r[4]);
            for (k = 0; k < 40; k++) {
                u64 sv = 0;
                if (g_m.cpu.r[4] + k * 8 < RAM_SIZE)
                    sv = mem_r64(g_m.cpu.r[4] + k * 8);
                printf("[PPK] %2u %llx\n", k, (unsigned long long)sv);
            }
            for (k = 0; k < 200; k++) {
                u32 idx = (g_m.rip_ring_i + k) & 4095u;
                printf("[PPR] %2u %llx\n", k,
                       (unsigned long long)g_m.rip_ring[idx]);
            }
        }
        fflush(stdout);
    }
#endif
    g_m.emu_sup = sup0;  /* 恢复调用者状态：可能本来就在 cpu_deliver 内部 */
    raise_exception(&g_m.cpu, EXC_PF, 1, ec);
}

/* user: 0=内核数据, 1=用户数据, 2=取指 */
u64 mem_translate(u64 va, u32 wr, u32 user, u32 *pf_ec)
{
    u64 vpn = 0, idx = 0, e = 0, pa = 0, flags = 0;
    /* user: 0=内核数据, 1=显式用户访问, 2=取指（查 NX）。
     * SDM：U/S 位和 #PF 错误码 bit2 都取决于 CPL——CPL3 的任何访问都要求
     * U/S=1；CPL0 的 copy_from_user 之类不要求。 */
    u32 level = 0, shift = 0, is_user = 0;
    u32 cpl3 = ((g_m.cpu.sel[1] & 3) != 0 && !g_m.emu_sup) ? 1 : 0;

    is_user = cpl3 | (user == 1);
    g_m.mt_calls++;
#if !defined(C6_WASM)
    if ((g_m.mt_calls & 0x3fffu) == 0 && g_m.watch_fd >= 0) {
        u64 mb[3] = {0, 0, 0};
        mb[0] = g_m.mt_calls;
        mb[1] = va;
        mb[2] = g_m.cur_rip;
        write(g_m.watch_fd, mb, 24);
    }
#endif

    if (!(g_m.cpu.cr[0] & CR0_PG))
        return va;

    /* 内核早期 direct map（page_offset_base=0xffff888000000000）按物理地址直映 */
    if (va >= 0xffff888000000000ull && va < 0xffff888000000000ull + RAM_SIZE)
        return va - 0xffff888000000000ull;

    /* 内核早期有两个高半区窗口；页表遍历失败时按物理地址直接回退。 */
    if (va >= 0xffffffff00000000ull) {
        u64 p = va - 0xffffffff00000000ull;
        if (p < RAM_SIZE) return p;
        p = va - 0xffffffff80000000ull;
        if (p < RAM_SIZE) return p;
    }

    vpn = va >> 12;
    idx = vpn & TLB_MASK;
    if (tlb_tag[idx] == vpn) {
        flags = tlb_val[idx] & 15;
        if ((flags & TV_P) && (!wr || (flags & TV_W)) &&
            (!is_user || (flags & TV_U)) && (!user || 1) &&
            (user != 2 || !(flags & TV_X)))
            return (tlb_val[idx] & ~((u64)15)) | (va & 0xfff);
    }

    pa = g_m.cpu.cr[3] & ~((u64)0xfff);
    for (level = 0; level < 4; level++) {
        shift = 39 - level * 9;
        e = phys_r64(pa + (((va >> shift) & 0x1ff) << 3));
        if (!(e & 1)) {
            pg_fault(va, wr, is_user, pf_ec);
            return 0;
        }
        if (is_user && !(e & 4)) {
            pg_fault(va, wr, 1, pf_ec);
            return 0;
        }
        if (wr && !(e & 2)) {
            pg_fault(va, wr, is_user, pf_ec);
            return 0;
        }
        if (level == 3 && (e & 0x80)) {
            /* 1 GiB 页 */
            if ((g_m.cpu.efer & EFER_NXE) && (e & ((u64)1 << 63)) && user == 2) {
                pg_fault(va, wr, is_user, pf_ec);
                return 0;
            }
            flags = TV_P | TV_U;
            if (e & 2) flags |= TV_W;
            if (!(e & ((u64)1 << 63))) flags |= TV_X;
            pa = (e & 0x000fffffc0000000ull) | (va & 0x3fffffff);
            tlb_tag[idx] = vpn;
            tlb_val[idx] = (pa & ~((u64)0xfff)) | flags;
            return pa;
        }
        if (level == 2 && (e & 0x80)) {
            /* 2 MiB 页 */
            if ((g_m.cpu.efer & EFER_NXE) && (e & ((u64)1 << 63)) && user == 2) {
                pg_fault(va, wr, is_user, pf_ec);
                return 0;
            }
            flags = TV_P | TV_U;
            if (e & 2) flags |= TV_W;
            if (!(e & ((u64)1 << 63))) flags |= TV_X;
            pa = (e & 0x000fffffffe00000ull) | (va & 0x1fffff);
            tlb_tag[idx] = vpn;
            tlb_val[idx] = (pa & ~((u64)0xfff)) | flags;
            return pa;
        }
        pa = e & 0x000ffffffffff000ull;
    }
    if ((g_m.cpu.efer & EFER_NXE) && (e & ((u64)1 << 63)) && user == 2) {
        pg_fault(va, wr, is_user, pf_ec);
        return 0;
    }
    flags = TV_P | TV_U | TV_X;
    if (e & 2) flags |= TV_W;
    pa = (e & 0x000ffffffffff000ull) | (va & 0xfff);
    tlb_tag[idx] = vpn;
    tlb_val[idx] = (pa & ~((u64)0xfff)) | flags;
    return pa;
}

u8 mem_fetch8(u64 a)
{
    u64 pa = mem_translate(a, 0, 2, 0);
    return phys_r8(pa);
}

u8 mem_r8(u64 a)
{
    u64 pa = mem_translate(a, 0, 0, 0);
    return phys_r8(pa);
}

u16 mem_r16(u64 a)
{
    u64 pa = mem_translate(a, 0, 0, 0);
    if ((pa & 0xfff) > 0xffe)
        return (u16)mem_r8(a) | ((u16)mem_r8(a + 1) << 8);
    return phys_r16(pa);
}

u32 mem_r32(u64 a)
{
    u64 pa = mem_translate(a, 0, 0, 0);
    if ((pa & 0xfff) > 0xffc) {
        u32 v = 0;
        u32 i = 0;
        for (i = 0; i < 4; i++)
            v |= (u32)mem_r8(a + i) << (i * 8);
        return v;
    }
    return phys_r32(pa);
}

u64 mem_r64(u64 a)
{
    u64 pa = mem_translate(a, 0, 0, 0);
    if ((pa & 0xfffull) > 0xff8ull)
        return (u64)mem_r32(a) | ((u64)mem_r32(a + 4) << 32);
    return phys_r64(pa);
}

void mem_w8(u64 a, u8 v)
{
    phys_w8(mem_translate(a, 1, 0, 0), v);
}

void mem_w16(u64 a, u16 v)
{
    u64 pa = mem_translate(a, 1, 0, 0);
    if ((pa & 0xfff) > 0xffe) {
        mem_w8(a, (u8)v);
        mem_w8(a + 1, (u8)(v >> 8));
        return;
    }
    phys_w16(pa, v);
}

void mem_w32(u64 a, u32 v)
{
    u64 pa = mem_translate(a, 1, 0, 0);
    if ((pa & 0xfff) > 0xffc) {
        u32 i = 0;
        for (i = 0; i < 4; i++)
            mem_w8(a + i, (u8)(v >> (i * 8)));
        return;
    }
    phys_w32(pa, v);
}

void mem_w64(u64 a, u64 v)
{
    u64 pa = mem_translate(a, 1, 0, 0);
    if ((pa & 0xfffull) > 0xff8ull) {
        mem_w32(a, (u32)v);
        mem_w32(a + 4, (u32)(v >> 32));
        return;
    }
    phys_w64(pa, v);
}

void mem_copy_from(u64 dst, const u8 *src, u64 n)
{
    u64 i = 0;
    for (i = 0; i < n; i++)
        mem_w8(dst + i, src[i]);
}
