/* machine.c6 —— 整机组装与运行循环（c6 方法：m->run()） */
#include "c6sim.h"

struct Machine g_m = {0};

static const char default_cmdline[] =
    "console=ttyS0,115200 earlycon=uart8250,io,0x3f8,115200 "
    "loglevel=7 panic=-1 reboot=k acpi=off noapic nolapic pci=off";

void machine_reset(void)
{
    struct Machine *m = &g_m;
    u32 i = 0;
    /* tcc-c6 的 wasm 后端在用局部指针取大偏移成员地址时会算错偏移，
       这里直接整块清零全局结构，绕开该问题 */
    for (i = 0; i < sizeof(g_m); i++)
        ((u8 *)&g_m)[i] = 0;
    m->serial.lsr = 0x60;
    m->serial.msr = 0xb0;
    m->instructions = 0;
    m->tsc = 0;
    m->pit_ticks = 0;
    m->last_pit_tsc = 0;
    m->halted = 0;
    m->exit_code = 0;
    m->fw_kernel = 0;
    m->fw_initrd = 0;
    m->fw_kernel_len = 0;
    m->fw_initrd_len = 0;
    cpu_init(&m->cpu);
    dev_init();
    mem_tlb_flush();
    machine_set_cmdline(default_cmdline);
}

/* 差分测试用：不复位 128MiB RAM（新进程本来全是 0），只清 CPU/设备状态 */
void machine_reset_noram(void)
{
    struct Machine *m = &g_m;
    u32 i = 0;
    for (i = 0; i < (u32)sizeof(m->cpu); i++)
        ((u8 *)&m->cpu)[i] = 0;
    m->instructions = 0;
    m->tsc = 0;
    m->pit_ticks = 0;
    m->last_pit_tsc = 0;
    m->halted = 0;
    m->exit_code = 0;
    m->serial.lsr = 0x60;
    m->serial.msr = 0xb0;
    cpu_init(&m->cpu);
    dev_init();
    mem_tlb_flush();
}

/* 差分测试用：不复位 128MiB RAM（新进程本来全是 0），只清 CPU/设备状态 */
void machine_reset_noram(void)
{
    struct Machine *m = &g_m;
    u32 i = 0;
    for (i = 0; i < (u32)sizeof(m->cpu); i++)
        ((u8 *)&m->cpu)[i] = 0;
    m->instructions = 0;
    m->tsc = 0;
    m->pit_ticks = 0;
    m->last_pit_tsc = 0;
    m->halted = 0;
    m->exit_code = 0;
    m->serial.lsr = 0x60;
    m->serial.msr = 0xb0;
    cpu_init(&m->cpu);
    dev_init();
    mem_tlb_flush();
}

void machine_init(void)
{
    machine_reset();
}

static int machine_step_loop(u64 count)
{
    u32 n = (u32)count;
    while (n > 0) {
        n--;
        if (g_m.halted || g_m.cpu.halted)
            break;
        g_m.instructions++;
        g_m.tsc++;
        cpu_step(&g_m.cpu);
        if (g_m.cpu.exc_pending)
            cpu_deliver(&g_m.cpu);
        if (g_m.cpu.halted || g_m.halted) {
            g_m.halted = 1;
            break;
        }
        if ((g_m.instructions & 0x1fffu) == 0)
            dev_tick();
    }
    return g_m.halted ? 0 : 1;
}

int machine_run(u64 count)
{
    return machine_step_loop(count);
}
