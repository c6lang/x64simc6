/* machine.c6 —— 整机组装与运行循环（c6 方法：m->run()） */
#include <string.h>
#include "c6sim.h"

struct Machine g_m = {0};

static const char default_cmdline[] =
    "console=ttyS0,115200 earlycon=uart8250,io,0x3f8,115200 "
    "loglevel=7 panic=-1 reboot=k acpi=off noapic nolapic pci=off";

void machine_reset(void)
{
    struct Machine *m = &g_m;
    u32 i = 0;
    for (i = 0; i < sizeof(m->ram); i++)
        m->ram[i] = 0;
    memset(&m->cpu, 0, sizeof(m->cpu));
    memset(&m->serial, 0, sizeof(m->serial));
    memset(&m->pic, 0, sizeof(m->pic));
    memset(&m->pit, 0, sizeof(m->pit));
    memset(&m->pci, 0, sizeof(m->pci));
    m->serial.lsr = 0x60;
    m->serial.msr = 0xb0;
    m->instructions = 0;
    m->tsc = 0;
    m->pit_ticks = 0;
    m->last_pit_tsc = 0;
    m->halted = 0;
    m->exit_code = 0;
    m->fw_kernel = 0;
    m->fw_initrd = 0;
    m->fw_kernel_len = 0;
    m->fw_initrd_len = 0;
    cpu_init(&m->cpu);
    dev_init();
    mem_tlb_flush();
    machine_set_cmdline(default_cmdline);
}

void machine_init(void)
{
    machine_reset();
}

int run(struct Machine *self, u64 count)
{
    u64 i = 0;
    struct CPUState *c = &self->cpu;
    for (i = 0; i < count; i++) {
        if (self->halted || c->halted)
            break;
        self->instructions++;
        self->tsc++;
        c->step();
        if (c->exc_pending)
            c->deliver();
        if (c->halted || self->halted) {
            self->halted = 1;
            break;
        }
        if ((self->instructions & 0x1fffu) == 0)
            dev_tick();
    }
    return self->halted ? 0 : 1;
}

int machine_run(u64 count)
{
    return run(&g_m, count);
}
