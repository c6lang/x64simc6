/* machine.c6 —— 整机组装与运行循环（c6 方法：m->run()） */
#if !defined(C6_WASM)
#include <stdio.h>
#include <unistd.h>
#endif
#include "c6sim.h"

#if !defined(C6_WASM)
struct host_timespec { long tv_sec; long tv_nsec; };
extern int clock_gettime(int clk, struct host_timespec *ts);
#define HOST_CLOCK_MONOTONIC 1

static u64 pace_wall_ns(void)
{
    struct host_timespec ts = {0, 0};
    if (clock_gettime(HOST_CLOCK_MONOTONIC, &ts) != 0)
        return 0;
    return (u64)ts.tv_sec * 1000000000ull + (u64)ts.tv_nsec;
}
#else
/* wasm 没有 CLOCK_MONOTONIC：页面/Node 前端用 sim_set_host_ms() 每帧写入
 * 宿主毫秒，pace_ahead() 用同一套逻辑把 guest 钟对齐到墙钟。 */
extern u32 g_host_ms;
static u64 pace_wall_ns(void)
{
    return (u64)g_host_ms * 1000000ull;
}
#endif

static u32 g_tsc_acc = 0;      /* TSC 分频累加器 */
static u32 g_tsc_div = 17;     /* 每多少条指令走 1 个 TSC；交互模式按实测速率校准 */
static u32 g_calib = 0;
static u64 g_calib_w = 0;
static u64 g_calib_i = 0;
static u64 g_pace_w0 = 0;      /* 墙钟基准（ns） */
static u64 g_pace_t0 = 0;      /* 对应时刻的 TSC */

/* 空闲快进前调用：guest 钟（TSC≈1.19MHz）是否已比墙钟超前 20ms 以上。
 * 超前就不再推进这一跳，直接回主循环（stdin 照样被 poll），等墙钟追上。
 * 这样空闲时 guest 时间和墙钟基本一致，busybox login 的 60 秒 SIGALRM
 * 不会三四秒就到、把 getty 反复重启（"login:" 反复输出）；wasm 里还
 * 避免 ping RTT 被空闲快进撑大、DNS 查询提前超时。 */
static int g_pace_idle = 0;    /* 交互模式（native tty / wasm 页面）才节流 */
static int pace_ahead(void)
{
    u64 w = 0;
    if (!g_pace_idle)
        return 0;
    w = pace_wall_ns();
    u64 wall_el = 0;
    u64 guest_el = 0;
    if (w == 0)
        return 0;
    if (g_pace_w0 == 0) {
        g_pace_w0 = w;
        g_pace_t0 = g_m.tsc;
        return 0;
    }
    wall_el = w - g_pace_w0;
    guest_el = (g_m.tsc - g_pace_t0) * 838ull;   /* 1 TSC ≈ 838ns */
    if (guest_el > wall_el + 20000000ull)
        return 1;
    if (wall_el > guest_el + 2000000000ull) {    /* 落后 2 秒以上：重设基准 */
        g_pace_w0 = w;
        g_pace_t0 = g_m.tsc;
    }
    return 0;
}

static u64 g_ring[16] = {0};
static int g_reset_once = 0;
static u32 g_ring_i = 0;

struct Machine g_m = {0};
int g_no_fast = 0;
int g_no_fetch = 0;
int g_no_data = 0;
int g_cc = 0;   /* --cachecheck：每次快路径命中都与慢路径对拍 */
int g_ud_trace = 0;   /* --udtrace：遇到 #UD 时打印指令地址与字节 */
int g_rsp_check = 0;  /* --rspcheck：RSP 跳进内核 text/模块区时打印 RIP 环并停机 */
#if !defined(C6_WASM)
static u64 g_lastrip[64] = {0};
static u64 g_lastrsp[64] = {0};
static u32 g_lastrip_i = 0;

/* RSP 是否可能在合法的内核栈上：vmalloc 栈 / CEA（入口栈与 IST）/ 直接映射 */
static int bad_stack_ptr(u64 rsp)
{
    if (rsp >= 0xffffc90000000000ull && rsp < 0xffffca0000000000ull) return 0;
    if (rsp >= 0xfffffe0000000000ull && rsp < 0xfffffe0000100000ull) return 0;
    if (rsp >= 0xffff888000000000ull && rsp < 0xffff888800000000ull) return 0;
    return 1;
}
#endif

static const char default_cmdline[] =
    "console=ttyS0,115200 earlycon=uart8250,io,0x3f8,115200 "
    "loglevel=7 panic=-1 reboot=k acpi=off pci=conf1";

void machine_reset(void)
{
    struct Machine *m = &g_m;
    /* g_m 有 128MiB RAM：逐字节清零在新进程里要 1.7 秒（6.4G 条宿主指令）。
       首次调用时 BSS 本来就是全 0，直接跳过；后续（reboot）按 4 字节批量清。 */
    if (g_reset_once != 0) {
        /* 按 4 字节块清：wasm32 下指针 32 位，用 u32 指针最稳 */
        u32 *zp = (u32 *)&g_m;
        u32 zn = (u32)(sizeof(g_m) / 4u);
        u32 zk = 0;
        for (zk = 0; zk < zn; zk++) zp[zk] = 0;
    }
    g_reset_once = 1;
    m->serial.lsr = 0x60;
    m->serial.msr = 0xb0;
    m->instructions = 0;
    m->tsc = 0;
    m->pit_ticks = 0;
    m->last_pit_tsc = 0;
    m->halted = 0;
    m->exit_code = 0;
    m->fw_kernel = 0;
    m->fw_initrd = 0;
    m->fw_kernel_len = 0;
    m->fw_initrd_len = 0;
    cpu_init(&m->cpu);
    dev_init();
    mem_tlb_flush();
    machine_set_cmdline(default_cmdline);
}

/* 差分测试用：不复位 128MiB RAM（新进程本来全是 0），只清 CPU/设备状态 */
void machine_reset_noram(void)
{
    struct Machine *m = &g_m;
    u32 i = 0;
    for (i = 0; i < (u32)sizeof(m->cpu); i++)
        ((u8 *)&m->cpu)[i] = 0;
    m->instructions = 0;
    m->tsc = 0;
    m->pit_ticks = 0;
    m->last_pit_tsc = 0;
    m->halted = 0;
    m->exit_code = 0;
    m->serial.lsr = 0x60;
    m->serial.msr = 0xb0;
    cpu_init(&m->cpu);
    dev_init();
    mem_tlb_flush();
}

/* 测试/对拍用：强制固定 1/17、关闭按墙钟的 TSC 校准。
 * 浏览器/交互仍走 paced（machine_init 里自动置 1），wasm 对拍在
 * sim_init 之后调用本函数即可恢复逐字节确定性。 */
void machine_set_paced(int v)
{
    g_pace_idle = v ? 1 : 0;
    g_calib = 0;
    g_tsc_div = 17;
    g_tsc_acc = 0;
}

void machine_init(void)
{
#if !defined(C6_WASM)
    g_pace_idle = isatty(0);   /* 批处理/对拍不节流，吞吐和结果都保持原样 */
#else
    g_pace_idle = 1;           /* 宿主毫秒由 sim_set_host_ms() 提供 */
#endif
    if (g_pace_idle) {
        g_calib = 1;
        g_calib_w = pace_wall_ns();
        g_calib_i = g_m.instructions;
    }
    machine_reset();
}

static int machine_step_loop(u64 count)
{
    u32 n = (u32)count;
    u32 ri = 0;
    /* ---- 每指令开销的关键：把「每轮都读、整轮不变」的全局先提到循环外 ----
     * c6c 每次读全局都要过一次基址，下面这些判断曾经逐条摊在热路径上
     * （实测纯循环 0.33µs/条）。提到外面 + 调试开关合成一个 bool 之后，
     * 每轮只剩 halt/停机/取指三条检查。 */
    u64 stopt = g_m.stopt;
    int dbg_any = g_m.sample_on || g_m.rip_dump_en || g_m.snap_step != 0 ||
                  g_m.watch_fd >= 0;
    while (n > 0) {
        n--;
        if (g_m.halted)
            break;
        if (stopt != 0 && g_m.instructions >= stopt) {
            g_m.halted = 1;
            break;
        }
        if (g_m.cpu.halted) {
            /* HLT 状态：IF=1 时等待设备中断唤醒，IF=0 则永久停机 */
            if (!cpu_if_enabled()) {
#if !defined(C6_WASM)
                printf("[HALT] rip=%llx flags=%llx cr3=%llx insns=%llu rsp=%llx"
                       " exc=%d vec=%d abort=%d\n",
                       (unsigned long long)g_m.cpu.rip,
                       (unsigned long long)g_m.cpu.flags,
                       (unsigned long long)g_m.cpu.cr[3],
                       (unsigned long long)g_m.instructions,
                       (unsigned long long)g_m.cpu.r[4],
                       (int)g_m.cpu.exc_pending, (int)g_m.cpu.exc_vec,
                       (int)g_m.cpu.fault_abort);
                printf("[RING]");
                for (ri = 0; ri < 16; ri++)
                    printf(" %llx",
                           (unsigned long long)g_ring[(g_ring_i + ri) & 15]);
                printf("\n");
                fflush(stdout);
#endif
                g_m.halted = 1;
                break;
            }
            /* 先轮询设备再快进：网络/串口事件必须能立刻唤醒。否则快进会把
             * guest 时钟一次性推到下一个 PIT（tickless idle 下可达数秒），
             * 定时器"提前"到期——表现为 guest 里 ping 的 RTT 是 2 秒、
             * DNS 查询 1 秒超时（外网访问直接失败）。 */
            dev_tick();
            if (g_m.cpu.exc_pending) {
                g_m.cpu.halted = 0;
                cpu_deliver(&g_m.cpu);
                continue;
            }
            /* idle 快进：跳到下一次 PIT 到期，但设上限，保证设备事件
             * 最多晚 0x40000 条指令被发现。 */
            {
                u64 step = 0x2000;
                /* 跑在墙钟前面就先不推进时间（但仍然要 dev_tick，
                 * 否则挂起的串口中断永远投递不出去，敲键没反应）。 */
                if (pace_ahead())
                    step = 0;
                if (g_m.pit.reload[0] > 0 &&
                    (g_m.pit.mode[0] == 2 || g_m.pit.mode[0] == 3) &&
                    g_m.pit.count[0] > 0x2000) {
                    u64 want = (u64)g_m.pit.count[0];
                    if (want > 0x40000ull) want = 0x40000ull;
                    if (want > step) step = want;
                }
                if (step > 0) {
                    if (g_pace_idle) {
                        g_tsc_acc = g_tsc_acc + (u32)step;
                        g_m.tsc += (u64)(g_tsc_acc / g_tsc_div);
                        g_tsc_acc = g_tsc_acc % g_tsc_div;
                    } else {
                        g_m.tsc += step;
                    }
                    g_m.instructions += step;
                }
            }
            continue;
        }
#if defined(C6_JIT)
        /* wasm JIT：执行一个已翻译的内核直线块。块内不含设备访问/分支外跳
         * 以外的副作用，也不跨 dev_tick 边界，所以只在这里补指令数、TSC
         * 分频和循环配额。取指/异常/调试模式一律回退解释器。 */
        if (g_jit_on && !dbg_any && !g_m.cpu.exc_pending && !g_m.cpu.halted &&
            !g_m.cpu.fault_abort &&
            (g_m.instructions & 0x3ffffull) != 0x3ffffull) {
            u64 jlim = (u64)n + 1ull;
            u64 bdist = 0x40000ull - (g_m.instructions & 0x3ffffull);
            u32 jn = 0;
            /* 停在 dev_tick 边界/ stopt 前一条，让解释器执行最后一条并
             * 在循环尾部按原时序调 dev_tick。 */
            if ((bdist - 1ull) < jlim)
                jlim = bdist - 1ull;
            if (stopt != 0 && stopt > g_m.instructions &&
                (stopt - g_m.instructions - 1ull) < jlim)
                jlim = stopt - g_m.instructions - 1ull;
            {
                u64 jb = (g_m.cpu.rip >> 3) & 0x3fffffull;
                u32 jbyte = (u32)(jb >> 3);
                u8 jbit = (u8)(1u << (jb & 7));
                int jgood = (g_jit_good[jbyte] & jbit) != 0;
                if (jlim > 0) {
                    if (jgood)
                        jn = (u32)jit_try2(g_m.cpu.rip, (u32)jlim);
                    else if ((g_m.instructions & 0x3full) == 0 &&
                             (g_jit_bad[jbyte] & jbit) == 0)
                        jn = (u32)jit_try_sample(g_m.cpu.rip, (u32)jlim);
                }
            }
            if (jn > 0) {
                if ((u64)jn > jlim) g_jit_bad_budget++;
                g_m.cur_rip = g_m.cpu.rip;
                g_m.instructions += (u64)jn;
                g_tsc_acc += jn;
                g_m.tsc += g_tsc_acc / 17u;
                g_tsc_acc %= 17u;
                if ((g_m.instructions & 0x3ffffull) == 0) g_jit_bad_boundary++;
                /* 块的最后一条可能缺页（栈/call/ret 最常见）：补上解释器
                 * 循环尾部的投递，不能留到下一轮再重试一条指令。 */
                if (g_m.cpu.exc_pending) {
                    g_m.cpu.halted = 0;
                    cpu_deliver(&g_m.cpu);
                }
                n -= (jn - 1u);
                continue;
            }
        }
#endif
        g_m.instructions++;
        /* TSC 每 17 条指令加 1：内核用 PIT 标定出的 TSC 频率约 1.19MHz，
         * 1 指令 1 TSC 会让 guest 时间比墙钟快 15 倍（login 超时 4 秒就到）。
         * 17:1 之后忙时 guest 时间和墙钟一致，配和上面的空闲节流，
         * 空闲时也不跑快。 */
        g_tsc_acc++;
        if (g_tsc_acc >= g_tsc_div) {
            g_tsc_acc = 0;
            g_m.tsc++;
        }
        if (dbg_any) {
        if (g_m.sample_on) {   /* 只在 --sample 时记录，避免每指令两次写 */
            g_ring[g_ring_i & 15] = g_m.cpu.rip;
            g_ring_i = g_ring_i + 1;
        }
#if !defined(C6_WASM)
        if (g_m.sample_on && g_m.instructions - g_m.sample_marks >= 20000000ull) {
            g_m.sample_marks = g_m.instructions;
            printf("[SMP] n=%llu rip=%llx cpl=%u cr3=%llx ue=%llu\n",
                   (unsigned long long)g_m.instructions,
                   (unsigned long long)g_m.cpu.rip,
                   (unsigned)(g_m.cpu.sel[1] & 3),
                   (unsigned long long)g_m.cpu.cr[3],
                   (unsigned long long)g_m.user_entries);
            fflush(stdout);
        }
#endif
        if (g_m.rip_dump_en) {
            g_m.rip_ring[g_m.rip_ring_i & 4095u] = g_m.cpu.rip;
            g_m.rip_ring_i++;
        }
#if !defined(C6_WASM)
        /* 第一次进入 CPL3 时开一个 600 步的全量窗口，记录内核/用户交替顺序 */
        if (g_m.watch_fd >= 0 && g_m.trace_win == 0 && (g_m.cpu.sel[1] & 3) != 0)
            g_m.trace_win = 1;
        if (g_m.watch_fd >= 0 && g_m.trace_win != 0 && g_m.trace_win <= 600) {
            u64 tb[3] = {0, 0, 0};
            tb[0] = g_m.cpu.rip;
            tb[1] = g_m.instructions;
            tb[2] = 0x100u + (u64)(g_m.cpu.sel[1] & 3);
            write(g_m.watch_fd, tb, 24);
            g_m.trace_win++;
        }
        if (g_m.watch_fd >= 0 && !g_m.sys_trace &&
            (g_m.instructions & 0xfffu) == 0) {
            u64 wb[3] = {0, 0, 0};
            wb[0] = g_m.cur_rip;
            wb[1] = g_m.instructions;
            write(g_m.watch_fd, wb, 24);
        }
#endif
        }
#if !defined(C6_WASM)
        if (g_rsp_check) {
            g_lastrip[g_lastrip_i & 63u] = g_m.cpu.rip;
            g_lastrsp[g_lastrip_i & 63u] = g_m.cpu.r[4];
            g_lastrip_i = g_lastrip_i + 1;
        }
        /* 页错误入口第一次落在非法栈上时立刻停：这时 RSP 就是那个坏值，
         * 环里最后几条是把它带飞的 iret/栈切换指令。 */
        if (g_rsp_check && g_m.instructions > 500000000ull &&
            g_m.cpu.rip == 0xffffffff81c01340ull &&
            bad_stack_ptr(g_m.cpu.r[4])) {
            u32 rk = 0;
            printf("[RSPFIRST] insns=%llu rip=%llx rsp=%llx cpl=%u"
                   " rax=%llx rdi=%llx gs=%llx\n",
                   (unsigned long long)g_m.instructions,
                   (unsigned long long)g_m.cpu.rip,
                   (unsigned long long)g_m.cpu.r[4],
                   (unsigned)(g_m.cpu.sel[1] & 3),
                   (unsigned long long)g_m.cpu.r[0],
                   (unsigned long long)g_m.cpu.r[7],
                   (unsigned long long)g_m.cpu.msr_gs_base);
            printf("[RING8]");
            for (rk = 0; rk < 8; rk++) {
                u32 kk = (g_lastrip_i + 64u - 8u + rk) & 63u;
                printf(" %llx/%llx", (unsigned long long)g_lastrip[kk],
                       (unsigned long long)g_lastrsp[kk]);
            }
            printf("\n");
            fflush(stdout);
            g_m.halted = 1;
            break;
        }
#endif
        cpu_step(&g_m.cpu);
#if !defined(C6_WASM)
        /* 调试：RSP 落进 0xffffffff8…/c…（内核 text / 模块区）不可能是栈，
         * 一出现就打印最近 64 条 (RIP,RSP) 并停机。 */
        if (g_rsp_check && g_m.instructions > 500000000ull &&
            (g_m.cpu.r[4] >= 0xffffffffc0000000ull ||
             (g_m.cpu.r[4] > 0 && g_m.cpu.r[4] < 0x10000ull))) {
            u32 ri2 = 0;
            printf("[RSPBAD] insns=%llu rip=%llx rsp=%llx rax=%llx"
                   " rcx=%llx rdx=%llx rdi=%llx flags=%llx"
                   " gs=%llx kgs=%llx fs=%llx\n",
                   (unsigned long long)g_m.instructions,
                   (unsigned long long)g_m.cpu.rip,
                   (unsigned long long)g_m.cpu.r[4],
                   (unsigned long long)g_m.cpu.r[0],
                   (unsigned long long)g_m.cpu.r[1],
                   (unsigned long long)g_m.cpu.r[2],
                   (unsigned long long)g_m.cpu.r[7],
                   (unsigned long long)g_m.cpu.flags,
                   (unsigned long long)g_m.cpu.msr_gs_base,
                   (unsigned long long)g_m.cpu.msr_kgs_base,
                   (unsigned long long)g_m.cpu.msr_fs_base);
            printf("[RING]");
            for (ri2 = 0; ri2 < 64; ri2++) {
                u32 k2 = (g_lastrip_i + 64u - 64u + ri2) & 63u;
                printf(" %llx/%llx", (unsigned long long)g_lastrip[k2],
                       (unsigned long long)g_lastrsp[k2]);
            }
            printf("\n");
            {
                u64 toff = g_m.cpu.tr_sel & 0xfff8u;
                u64 d0 = mem_r64(g_m.cpu.gdtr_base + toff);
                u64 d1 = mem_r64(g_m.cpu.gdtr_base + toff + 8);
                u64 tb = ((d0 >> 16) & 0xffffffu) |
                         (((d0 >> 56) & 0xffu) << 24) |
                         ((d1 & 0xffffffffu) << 32);
                printf("[TSS] sel=%llx base=%llx sp0=%llx sp1=%llx sp2=%llx"
                       " cr3=%llx cpl=%u\n",
                       (unsigned long long)g_m.cpu.tr_sel,
                       (unsigned long long)tb,
                       (unsigned long long)mem_r64(tb + 4),
                       (unsigned long long)mem_r64(tb + 12),
                       (unsigned long long)mem_r64(tb + 20),
                       (unsigned long long)g_m.cpu.cr[3],
                       (unsigned)(g_m.cpu.sel[1] & 3));
                {
                    u64 gsa = g_m.cpu.msr_gs_base + 0x6004ull;
                    u64 pa_a = mem_translate(gsa, 0, 0, 0);
                    u64 pa_b = mem_translate(tb + 4, 0, 0, 0);
                    u64 va = 0, vb = 0;
                    int q = 0;
                    if (pa_a + 8 < (u64)RAM_SIZE) {
                        for (q = 0; q < 8; q++)
                            va |= (u64)g_m.ram[(u32)(pa_a + (u64)q)] << (q * 8);
                    }
                    if (pa_b + 8 < (u64)RAM_SIZE) {
                        for (q = 0; q < 8; q++)
                            vb |= (u64)g_m.ram[(u32)(pa_b + (u64)q)] << (q * 8);
                    }
                    printf("[SP0] per_va=%llx per_pa=%llx per_val=%llx"
                           " cea_pa=%llx cea_val=%llx\n",
                           (unsigned long long)gsa,
                           (unsigned long long)pa_a,
                           (unsigned long long)va,
                           (unsigned long long)pa_b,
                           (unsigned long long)vb);
                }
            }
            {
                /* 最后一条执行前记录：如果它是 iretq，把它要弹出的 5 槽
                 * 帧原样打出来（用 mem_translate 读，避免再触发缺页）。 */
                u32 kp = (g_lastrip_i + 63u) & 63u;
                u64 prsp = g_lastrsp[kp];
                printf("[PREV] rip=%llx rsp=%llx\n",
                       (unsigned long long)g_lastrip[kp],
                       (unsigned long long)prsp);
                if (g_lastrip[kp] == 0xffffffff81c0198cull) {
                    u64 fv[5] = {0};
                    u32 fi = 0;
                    for (fi = 0; fi < 5; fi++) {
                        u64 pa = mem_translate(prsp + (u64)fi * 8ull, 0, 0, 0);
                        u64 vv = 0;
                        u32 qq = 0;
                        if (pa + 8 < (u64)RAM_SIZE) {
                            for (qq = 0; qq < 8; qq++)
                                vv |= (u64)g_m.ram[(u32)(pa + (u64)qq)] << (qq * 8);
                        }
                        fv[fi] = vv;
                    }
                    printf("[IRETFRAME] %llx %llx %llx %llx %llx\n",
                           (unsigned long long)fv[0],
                           (unsigned long long)fv[1],
                           (unsigned long long)fv[2],
                           (unsigned long long)fv[3],
                           (unsigned long long)fv[4]);
                }
            }
            fflush(stdout);
            g_m.halted = 1;
            break;
        }
#endif
        if (g_m.cpu.exc_pending) {
            /* HLT 之后立刻投递挂起中断：CPU 被唤醒，必须清 halted，
             * 否则下一轮会被「halted 且 IF=0」误判成永久停机
             * （实测 2261778433 条处 idle 的 sti;hlt 就撞在这条路径上）。 */
            g_m.cpu.halted = 0;
            cpu_deliver(&g_m.cpu);
        }
#if !defined(C6_WASM)
        if (g_m.snap_step != 0 && g_m.instructions >= g_m.snap_start &&
            (g_m.stopt == 0 || g_m.instructions <= g_m.stopt) &&
            (g_m.instructions % g_m.snap_step) == 0) {
            u32 si = 0;
            printf("[SNAP] %llu %llx %llx",
                   (unsigned long long)g_m.instructions,
                   (unsigned long long)g_m.cpu.rip,  /* 执行完第 N 条之后的下一条指令 */
                   (unsigned long long)g_m.cpu.flags);
            for (si = 0; si < 16; si++)
                printf(" %llx", (unsigned long long)g_m.cpu.r[si]);
            printf(" clk=%llx rsn=%llx pit=%llx",
                   (unsigned long long)clock_state_pack(),
                   (unsigned long long)raise_state_pack(),
                   (unsigned long long)pit_phase_pack());
            printf(" pic=%llx\n",
                   (unsigned long long)(pic_state_pack() |
                                        ((u64)(g_m.cpu.exc_pending & 0xff) << 48)));
            fflush(stdout);
        }
#endif
        if (g_m.halted)
            break;
        if ((g_m.instructions & 0x3ffffu) == 0)
            dev_tick();
    }
    return g_m.halted ? 0 : 1;
}

/* 交互/wasm 下按实测指令速率校准 TSC 分频：guest 时间 ≈ 墙钟。
 * 固定 1/17 是按 ~20M 条/秒调的；pty/终端模拟只有 ~10M 条/秒，
 * guest 钟会慢一半，top 的刷新间隔被拉长到“看起来不刷新”。 */
static void pace_calibrate(void)
{
    u64 w = 0;
    u64 dt = 0;
    u64 di = 0;
    u64 div = 0;
    if (!g_calib)
        return;
    w = pace_wall_ns();
    if (w == 0)
        return;
    if (g_calib_w == 0) {
        g_calib_w = w;
        g_calib_i = g_m.instructions;
        return;
    }
    dt = w - g_calib_w;
    if (dt < 150000000ull)
        return;
    di = g_m.instructions - g_calib_i;
    g_calib = 0;
    if (di == 0)
        return;
    div = di * 1000000000ull / dt / 1190000ull;
    if (div < 4ull) div = 4ull;
    if (div > 64ull) div = 64ull;
    g_tsc_div = (u32)div;
}

int machine_run(u64 count)
{
    int rc = machine_step_loop(count);
    pace_calibrate();
    return rc;
}
