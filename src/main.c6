/* main.c6 —— native CLI
 * 注意：这里刻意只用最朴素的 C6 写法（不用 defer/errdefer/try/catch/f-string），
 * 这样同一个文件既能被 c6c 直接编译，也能走 `c6c --emit-ctu` + 宿主 cc 的
 * 快速构建路径（-O2 的寄存器分配对这种解释器循环有 ~10x 的差距）。 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
/* 不用 <poll.h>：c6c 没有自带该头，会落到系统 glibc 头并把 struct timespec
 * 等类型带进来，和 c6c 自带的 <sys/stat.h> 打架（--emit-ctu 路径会编不过）。
 * 这里只用到 pollfd 和 poll()，手写声明即可。 */
struct pollfd { int fd; short events; short revents; };
extern int poll(struct pollfd *fds, unsigned long nfds, int timeout);
#include <unistd.h>
#include <fcntl.h>
#include "c6sim.h"

/* ---------------- 交互终端 ----------------
 * 只在 stdin 是 tty 时把宿主终端切到 raw：否则敲一条 `ls` 屏幕上会出现两遍
 * （宿主终端的本地回显 + guest 的串口回显）。另外 busybox ash 每个提示符都
 * 会发 ESC[6n 问光标位置，真实终端的应答 ESC[数字;数字R 会被当成用户输入塞进
 * 命令行（表现为提示符后出现 ^[[24;11R，后面敲的命令全被这串垃圾污染）。
 * 这里手写 struct termios（glibc x86-64 布局，实测 sizeof 60）而不是
 * include <termios.h>：c6c 没有该头，系统头会和 c6c 的 <sys/stat.h> 抢
 * struct timespec，--emit-ctu 路径编不过（与 <poll.h> 同一个坑）。
 * 关掉 ISIG 后 Ctrl-C 原样送给 guest；退出用 Ctrl-]（screen 的习惯）。
 */
struct host_termios {
    unsigned int c_iflag;
    unsigned int c_oflag;
    unsigned int c_cflag;
    unsigned int c_lflag;
    unsigned char c_line;
    unsigned char c_cc[32];
    unsigned int c_ispeed;
    unsigned int c_ospeed;
};
extern int tcgetattr(int fd, struct host_termios *t);
extern int tcsetattr(int fd, int act, const struct host_termios *t);

#define HOST_TCSANOW 0
#define HOST_ICANON 0x2u
#define HOST_ECHO 0x8u
#define HOST_ISIG 0x1u
#define HOST_IEXTEN 0x8000u
#define HOST_IXON 0x400u
#define HOST_ICRNL 0x100u
#define HOST_OPOST 0x1u

static struct host_termios g_tio_saved = {0};
static int g_tio_raw = 0;

static void tty_restore(void)
{
    if (g_tio_raw) {
        tcsetattr(0, HOST_TCSANOW, &g_tio_saved);
        g_tio_raw = 0;
    }
}

static void tty_raw(void)
{
    struct host_termios t = {0};
    if (!isatty(0))
        return;
    if (sizeof(struct host_termios) != 60)
        return;   /* 不是 glibc x86-64 的布局就别动终端 */
    if (tcgetattr(0, &g_tio_saved) != 0)
        return;
    t = g_tio_saved;
    t.c_lflag &= ~(HOST_ICANON | HOST_ECHO | HOST_ISIG | HOST_IEXTEN);
    t.c_iflag &= ~(HOST_IXON | HOST_ICRNL);
    t.c_oflag &= ~HOST_OPOST;
    t.c_cc[6] = 1;   /* VMIN：读一个字节就返回 */
    t.c_cc[5] = 0;   /* VTIME：不超时 */
    if (tcsetattr(0, HOST_TCSANOW, &t) == 0)
        g_tio_raw = 1;
}

/* 输入过滤：丢掉宿主终端对 ESC[6n 的应答（ESC [ 数字 ; 数字 R），
 * 其余字节（含方向键这类 ESC 序列）原样喂给 guest。 */
static u8 g_cpr[8] = {0};
static int g_cpr_n = 0;
static int g_quit = 0;

static void cpr_flush(void)
{
    int i = 0;
    for (i = 0; i < g_cpr_n; i++) {
        u8 one = g_cpr[i];
        serial_feed(&one, 1);
    }
    g_cpr_n = 0;
}

static int cpr_byte(u8 b)
{
    if (g_cpr_n == 0) {
        if (b == 0x1b) {
            g_cpr[0] = b;
            g_cpr_n = 1;
            return 1;
        }
        return 0;
    }
    if (g_cpr_n == 1) {
        if (b == '[') {
            g_cpr[1] = b;
            g_cpr_n = 2;
            return 1;
        }
        cpr_flush();
        return 0;
    }
    if ((b >= '0' && b <= '9') && g_cpr_n < 7) {
        g_cpr[g_cpr_n] = b;
        g_cpr_n = g_cpr_n + 1;
        return 1;
    }
    if (b == ';' && g_cpr_n < 7) {
        g_cpr[g_cpr_n] = b;
        g_cpr_n = g_cpr_n + 1;
        return 1;
    }
    if (b == 'R') {   /* 完整应答：整条丢掉 */
        g_cpr_n = 0;
        return 1;
    }
    cpr_flush();
    return 0;
}

static void feed_input(const u8 *buf, int n)
{
    int i = 0;
    for (i = 0; i < n; i++) {
        u8 b = buf[i];
        if (g_tio_raw && b == 0x1d) {   /* Ctrl-]：退出模拟器 */
            g_quit = 1;
            cpr_flush();
            return;
        }
        if (!cpr_byte(b)) {
            u8 one = b;
            serial_feed(&one, 1);
        }
    }
}

/* 读固件到内存；失败返回非 0 并打印原因 */
static int read_firmware(const char *path, u8 **out, u32 *len)
{
    FILE *f = fopen(path, "rb");
    long n = 0;
    u8 *buf = 0;
    size_t got = 0;
    if (!f) {
        printf("load error: cannot open %s\n", path);
        return 1;
    }
    if (fseek(f, 0, SEEK_END) != 0) {
        fclose(f);
        printf("load error: seek failed\n");
        return 1;
    }
    n = ftell(f);
    if (n <= 0 || n > (64 << 20)) {
        fclose(f);
        printf("load error: bad firmware size %ld\n", n);
        return 1;
    }
    if (fseek(f, 0, SEEK_SET) != 0) {
        fclose(f);
        printf("load error: rewind failed\n");
        return 1;
    }
    buf = (u8 *)malloc((size_t)n);
    if (!buf) {
        fclose(f);
        printf("load error: out of memory\n");
        return 1;
    }
    got = fread(buf, 1, (size_t)n, f);
    fclose(f);
    if (got != (size_t)n) {
        free(buf);
        printf("load error: short read\n");
        return 1;
    }
    *out = buf;
    *len = (u32)n;
    return 0;
}

/* ---- 指令级差分测试：在裸长模式下执行一段机器码并导出状态 ---- */
static u64 blob_hash(u64 h, u64 v)
{
    u32 i = 0;
    for (i = 0; i < 8; i++)
        h = (h ^ ((v >> (i * 8)) & 0xff)) * 0x100000001b3ULL;
    return h;
}

/* 架构顺序 rax,rbx,rcx,rdx,rsi,rdi,rbp,rsp -> CPUState.r[] 顺序
 * rax,rcx,rdx,rbx,rsp,rbp,rsi,rdi */
static const u8 arch2cpu[16] = {0, 3, 1, 2, 6, 7, 5, 4, 8, 9, 10, 11, 12, 13, 14, 15};

static int run_blob(const char *path, u64 limit)
{
    FILE *f = fopen(path, "rb");
    u8 hdr[160] = {0};
    u8 code[4096] = {0};
    u64 *q = 0;
    u32 i = 0, n = 0;
    u64 h = 0xcbf29ce484222325ULL;
    if (!f) {
        printf("cannot open %s\n", path);
        return 1;
    }
    if (fread(hdr, 1, 160, f) != 160) {
        fclose(f);
        return 1;
    }
    n = (u32)fread(code, 1, sizeof(code), f);
    fclose(f);
    q = (u64 *)hdr;
    machine_reset_noram();
    /* 恒等映射 0..1GiB（2MiB 大页） */
    for (i = 0; i < 512; i++)
        mem_w64(0x3000 + (u64)i * 8, ((u64)i << 21) | 0x83);
    mem_w64(0x2000, 0x3000 | 3);
    mem_w64(0x1000, 0x2000 | 3);
    g_m.cpu.cr[3] = 0x1000;
    g_m.cpu.cr[4] = 0x20;
    g_m.cpu.cr[0] = 0x80000001;
    g_m.cpu.efer = 0x500;
    g_m.cpu.sel[1] = 0x10;
    g_m.cpu.sel[2] = 0x10;
    g_m.cpu.seg_base[1] = 0;
    g_m.cpu.seg_base[2] = 0;
    for (i = 0; i < 16; i++)
        g_m.cpu.r[arch2cpu[i]] = q[i];
    g_m.cpu.rip = q[16];
    g_m.cpu.flags = q[17];
    for (i = 0; i < 4096; i++)
        mem_w8(0x200000 + (u64)i, (u8)((i * 37 + 11) & 0xff));
    for (i = 0; i < n; i++)
        mem_w8(g_m.cpu.rip + (u64)i, code[i]);
    machine_run(limit);
    for (i = 0; i < 4096; i++)
        h = blob_hash(h, (u64)mem_r8(0x200000 + (u64)i));
    printf("RES");
    for (i = 0; i < 16; i++)
        printf(" %llx", (unsigned long long)g_m.cpu.r[arch2cpu[i]]);
    printf(" %llx %llx %llx %u\n",
           (unsigned long long)g_m.cpu.rip, (unsigned long long)g_m.cpu.flags,
           (unsigned long long)h, (u32)g_m.halted);
    return 0;
}

static void parse_memrange(const char *s, u64 *st, u64 *len)
{
    int k = 0;
    u64 a = 0, b = 0;
    while (s[k] >= '0' && s[k] <= '9') { a = a * 10ull + (u64)(s[k] - '0'); k++; }
    if (s[k] == ',') k++;
    while (s[k] >= '0' && s[k] <= '9') { b = b * 10ull + (u64)(s[k] - '0'); k++; }
    *st = a;
    *len = b;
}

static u64 parse_u64(const char *s)
{
    u64 v = 0;
    int k = 0;
    while (s[k] >= '0' && s[k] <= '9') {
        v = v * 10ull + (u64)(s[k] - '0');
        k++;
    }
    return v;
}

int main(int argc, char **argv)
{
    const char *path = 0;
    const char *cmdline = 0;
    u8 *fw = 0;
    u32 len = 0;
    u8 out[8192] = {0};
    int a = 1;
    (void)0;
    int payload = 0;
    int ppt = 0;
    int sample = 0;
    int sys_trace = 0;
    int riptrace = 0;
    int dumpregs = 0;
    u64 dumpmem_start = 0;
    u64 dumpmem_len = 0;
    u64 snap_start = 0;
    u64 snap_step = 0;
    u64 memhash_start = 0;
    u64 memhash_len = 0;
    u64 stopt = 0;
    const char *blob = 0;

    for (a = 1; a < argc; a++) {
        if (strcmp(argv[a], "--payload") == 0)
            payload = 1;
        else if (strncmp(argv[a], "--cmdline=", 10) == 0)
            cmdline = argv[a] + 10;
        else if (strcmp(argv[a], "--ppt") == 0)
            ppt = 1;
        else if (strncmp(argv[a], "--stopt=", 8) == 0)
            stopt = parse_u64(argv[a] + 8);
        else if (strncmp(argv[a], "--snap=", 7) == 0)
            parse_memrange(argv[a] + 7, &snap_start, &snap_step);
        else if (strncmp(argv[a], "--memhash=", 10) == 0)
            parse_memrange(argv[a] + 10, &memhash_start, &memhash_len);
        else if (strncmp(argv[a], "--dumpmem=", 10) == 0)
            parse_memrange(argv[a] + 10, &dumpmem_start, &dumpmem_len);
        else if (strcmp(argv[a], "--dumpregs") == 0)
            dumpregs = 1;
        else if (strcmp(argv[a], "--riptrace") == 0)
            riptrace = 1;
        else if (strcmp(argv[a], "--sys") == 0)
            sys_trace = 1;
        else if (strcmp(argv[a], "--sample") == 0)
            sample = 1;
        else if (strcmp(argv[a], "--cachecheck") == 0)
            g_cc = 1;
        else if (strcmp(argv[a], "--nofast") == 0)
            g_no_fast = 1;
        else if (strcmp(argv[a], "--nofetch") == 0)
            g_no_fetch = 1;
        else if (strcmp(argv[a], "--nodata") == 0)
            g_no_data = 1;
        else if (strcmp(argv[a], "--udtrace") == 0)
            g_ud_trace = 1;
        else if (strcmp(argv[a], "--blob") == 0 && a + 1 < argc)
            blob = argv[++a];
        else if (argv[a][0] == '-') {
            printf("unknown option: %s\n", argv[a]);
            return 4;
        } else
            path = argv[a];
    }
    if (blob != 0)
        return run_blob(blob, 1000);
    if (path == 0) {
        printf("usage: %s [--cmdline=...] firmware.bin\n", argv[0]);
        return 4;
    }

    {
        int rc = read_firmware(path, &fw, &len);
        if (rc != 0 || fw == 0)
            return 1;
    }

    machine_init();
    if (ppt)
        g_m.rip_dump_en = 1;
    if (sys_trace)
        g_m.sys_trace = 1;
    if (riptrace)
        g_m.rip_trace_on = 1;
    g_m.stopt = stopt;
    g_m.snap_start = snap_start;
    g_m.snap_step = snap_step;
    if (sample)
        g_m.sample_on = 1;   /* 调试：低地址 #PF 时打印最近 64 条 RIP */
    if (payload) {
        int rc = machine_boot_payload(fw, len, 0x10000);
        if (rc != 0) {
            printf("payload boot failed: %d\n", rc);
            return 1;
        }
    } else {
        int rc = machine_load_firmware(fw, len);
        if (rc == 0) {
            if (cmdline != 0)
                machine_set_cmdline(cmdline);
            rc = machine_boot();
        }
        if (rc != 0) {
            printf("boot error: rc=%d\n", rc);
            free(fw);
            return 1;
        }
    }

    g_m.watch_fd = -1;
#if !defined(C6_WASM)
    g_m.watch_fd = open("/tmp/simwatch.bin", 1 | 0x40 | 0x200 | 0x400, 0644);
#endif
    tty_raw();
    if (g_tio_raw)
        fprintf(stderr, "[c6sim] 串口交互：Ctrl-] 退出，Ctrl-C 送给 guest\n");
    while (!g_m.halted && !g_quit) {
        struct pollfd pfd[1] = {0};
        machine_run(200000);
        {
            int n = serial_take_output(out, (int)sizeof(out));
            if (n > 0) {
                fwrite(out, 1, (size_t)n, stdout);
                fflush(stdout);
            }
        }
        pfd[0].fd = 0;
        pfd[0].events = 1; /* POLLIN */
        if (poll(pfd, 1, 0) > 0) {
            u8 in[256] = {0};
            ssize_t got = read(0, in, sizeof(in) - 1);
            if (got > 0)
                feed_input(in, (int)got);
        }
    }
    tty_restore();
    {
        int n = serial_take_output(out, (int)sizeof(out));
        if (n > 0)
            fwrite(out, 1, (size_t)n, stdout);
    }

#if !defined(C6_WASM)
    if (dumpregs) {
        u32 k3 = 0;
        for (k3 = 0; k3 < 16; k3++)
            printf("[REG] %u %llx\n", k3, (unsigned long long)g_m.cpu.r[k3]);
        printf("[REG] rip %llx\n", (unsigned long long)g_m.cpu.rip);
        printf("[REG] flags %llx\n", (unsigned long long)g_m.cpu.flags);
        printf("[REG] insns %llu\n", (unsigned long long)g_m.instructions);
        {
            u32 i6 = 0;
            printf("[BYTE] ");
            for (i6 = 0; i6 < 24; i6++)
                printf("%02x", (u32)g_m.ram[0x7000 + i6]);
            printf(" | ");
            for (i6 = 0; i6 < 32; i6++)
                printf("%02x", (u32)g_m.ram[0x9200 + i6]);
            printf(" | ");
            for (i6 = 0; i6 < 256; i6++)
                printf("%02x", (u32)g_m.ram[0x9000 + i6]);
            printf("\n");
        }
        if (dumpmem_len > 0) {
            u64 o = 0;
            for (o = 0; o + 16 <= dumpmem_len; o += 16) {
                u32 j = 0;
                printf("[MEM] %llx ", (unsigned long long)(dumpmem_start + o));
                for (j = 0; j < 16; j++)
                    printf("%02x", (u32)g_m.ram[dumpmem_start + o + j]);
                printf("\n");
            }
        }
        if (memhash_len > 0) {
            u64 h = 0xcbf29ce484222325ull;
            u64 i5 = 0;
            for (i5 = 0; i5 < memhash_len; i5++)
                h = (h ^ (u64)g_m.ram[memhash_start + i5]) * 0x100000001b3ull;
            printf("[MEMR] %llx\n", (unsigned long long)h);
        }
        {
            u32 chunk = 0;
            for (chunk = 0; chunk < (u32)(RAM_SIZE / 0x100000); chunk++) {
                u64 h = 0xcbf29ce484222325ull;
                u32 i4 = 0;
                u32 base = chunk * 0x100000u;
                for (i4 = 0; i4 < 0x100000u; i4++)
                    h = (h ^ (u64)g_m.ram[base + i4]) * 0x100000001b3ull;
                printf("[MEMH] %u %llx\n", chunk, (unsigned long long)h);
            }
        }
        fflush(stdout);
    }
#endif
    printf("\n[c6sim] halted, instructions=%llu, exit=%d ser_out=%llu irq4=%llu\n",
           g_m.instructions, g_m.exit_code,
           (unsigned long long)g_ser_out_bytes,
           (unsigned long long)g_irq4_raises);
    if (dumpregs)
    printf("[UART] rd=%u/%u/%u/%u/%u/%u/%u/%u wr=%u/%u/%u/%u/%u/%u/%u/%u ier=%x mcr=%x lsr=%x\n",
           g_ser_rd[0], g_ser_rd[1], g_ser_rd[2], g_ser_rd[3],
           g_ser_rd[4], g_ser_rd[5], g_ser_rd[6], g_ser_rd[7],
           g_ser_wr[0], g_ser_wr[1], g_ser_wr[2], g_ser_wr[3],
           g_ser_wr[4], g_ser_wr[5], g_ser_wr[6], g_ser_wr[7],
           g_ser_last_ier, g_ser_last_mcr, g_ser_last_lsr);
    return g_m.exit_code & 0xff;
}
