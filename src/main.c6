/* main.c6 —— native CLI（这里集中使用 c6 的 defer / errdefer / err/try/catch /
 * f-string / 枚举命名空间 / 方法；wasm 构建不含本文件） */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <poll.h>
#include <unistd.h>
#include "c6sim.h"

enum Err {
    Err.IO = 1,
    Err.BAD_FW = 2,
    Err.BOOT = 3,
    Err.USAGE = 4,
};

/* c6: 拿到资源就登记清理，错误路径单独回滚 */
static int!error read_firmware(const char *path, u8 **out, u32 *len)
{
    FILE *f = fopen(path, "rb");
    if (!f)
        return err(Err.IO, f"cannot open {path}");
    defer fclose(f);

    if (fseek(f, 0, SEEK_END) != 0)
        return err(Err.IO, "seek failed");
    long n = ftell(f);
    if (n <= 0 || n > (64 << 20))
        return err(Err.IO, f"bad firmware size {n}");
    if (fseek(f, 0, SEEK_SET) != 0)
        return err(Err.IO, "rewind failed");

    u8 *buf = (u8 *)malloc((size_t)n);
    if (!buf)
        return err(Err.IO, "out of memory");
    errdefer free(buf);

    size_t got = fread(buf, 1, (size_t)n, f);
    if (got != (size_t)n)
        return err(Err.IO, "short read");

    *out = buf;
    *len = (u32)n;
    return 0;
}

static int!error check(int rc, const char *what)
{
    if (rc != 0)
        return err(Err.BAD_FW, f"{what} failed: rc={rc}");
    return 0;
}

static int!error boot_all(u8 *fw, u32 len, const char *cmdline)
{
    try check(machine_load_firmware(fw, len), "load firmware");
    if (cmdline != 0)
        machine_set_cmdline(cmdline);
    try check(machine_boot(), "boot kernel");
    return 0;
}

/* ---- 指令级差分测试：在裸长模式下执行一段机器码并导出状态 ---- */
static u64 blob_hash(u64 h, u64 v)
{
    u32 i = 0;
    for (i = 0; i < 8; i++)
        h = (h ^ ((v >> (i * 8)) & 0xff)) * 0x100000001b3ULL;
    return h;
}

/* 架构顺序 rax,rbx,rcx,rdx,rsi,rdi,rbp,rsp -> CPUState.r[] 顺序
 * rax,rcx,rdx,rbx,rsp,rbp,rsi,rdi */
static const u8 arch2cpu[16] = {0, 3, 1, 2, 6, 7, 5, 4, 8, 9, 10, 11, 12, 13, 14, 15};

static int run_blob(const char *path, u64 limit)
{
    FILE *f = fopen(path, "rb");
    u8 hdr[160] = {0};
    u8 code[4096] = {0};
    u64 *q = 0;
    u32 i = 0, n = 0;
    u64 h = 0xcbf29ce484222325ULL;
    if (!f) {
        printf("cannot open %s\n", path);
        return 1;
    }
    defer fclose(f);
    if (fread(hdr, 1, 160, f) != 160)
        return 1;
    n = (u32)fread(code, 1, sizeof(code), f);
    q = (u64 *)hdr;
    machine_reset_noram();
    /* 恒等映射 0..1GiB（2MiB 大页） */
    for (i = 0; i < 512; i++)
        mem_w64(0x3000 + (u64)i * 8, ((u64)i << 21) | 0x83);
    mem_w64(0x2000, 0x3000 | 3);
    mem_w64(0x1000, 0x2000 | 3);
    g_m.cpu.cr[3] = 0x1000;
    g_m.cpu.cr[4] = 0x20;
    g_m.cpu.cr[0] = 0x80000001;
    g_m.cpu.efer = 0x500;
    g_m.cpu.sel[1] = 0x10;
    g_m.cpu.sel[2] = 0x10;
    g_m.cpu.seg_base[1] = 0;
    g_m.cpu.seg_base[2] = 0;
    for (i = 0; i < 16; i++)
        g_m.cpu.r[arch2cpu[i]] = q[i];
    g_m.cpu.rip = q[16];
    g_m.cpu.flags = q[17];
    for (i = 0; i < 4096; i++)
        mem_w8(0x200000 + (u64)i, (u8)((i * 37 + 11) & 0xff));
    for (i = 0; i < n; i++)
        mem_w8(g_m.cpu.rip + (u64)i, code[i]);
    machine_run(limit);
    for (i = 0; i < 4096; i++)
        h = blob_hash(h, (u64)mem_r8(0x200000 + (u64)i));
    printf("RES");
    for (i = 0; i < 16; i++)
        printf(" %llx", (unsigned long long)g_m.cpu.r[arch2cpu[i]]);
    printf(" %llx %llx %llx %u\n",
           (unsigned long long)g_m.cpu.rip, (unsigned long long)g_m.cpu.flags,
           (unsigned long long)h, (u32)g_m.halted);
    return 0;
}

static void parse_memrange(const char *s, u64 *st, u64 *len)
{
    int k = 0;
    u64 a = 0, b = 0;
    while (s[k] >= '0' && s[k] <= '9') { a = a * 10ull + (u64)(s[k] - '0'); k++; }
    if (s[k] == ',') k++;
    while (s[k] >= '0' && s[k] <= '9') { b = b * 10ull + (u64)(s[k] - '0'); k++; }
    *st = a;
    *len = b;
}

static u64 parse_u64(const char *s)
{
    u64 v = 0;
    int k = 0;
    while (s[k] >= '0' && s[k] <= '9') {
        v = v * 10ull + (u64)(s[k] - '0');
        k++;
    }
    return v;
}

int main(int argc, char **argv)
{
    const char *path = 0;
    const char *cmdline = 0;
    u8 *fw = 0;
    u32 len = 0;
    u8 out[8192] = {0};
    int a = 1;
    (void)0;
    int payload = 0;
    int ppt = 0;
    int sample = 0;
    int sys_trace = 0;
    int riptrace = 0;
    int dumpregs = 0;
    u64 dumpmem_start = 0;
    u64 dumpmem_len = 0;
    u64 memhash_start = 0;
    u64 memhash_len = 0;
    u64 stopt = 0;
    const char *blob = 0;

    for (a = 1; a < argc; a++) {
        if (strcmp(argv[a], "--payload") == 0)
            payload = 1;
        else if (strncmp(argv[a], "--cmdline=", 10) == 0)
            cmdline = argv[a] + 10;
        else if (strcmp(argv[a], "--ppt") == 0)
            ppt = 1;
        else if (strncmp(argv[a], "--stopt=", 8) == 0)
            stopt = parse_u64(argv[a] + 8);
        else if (strncmp(argv[a], "--memhash=", 10) == 0)
            parse_memrange(argv[a] + 10, &memhash_start, &memhash_len);
        else if (strncmp(argv[a], "--dumpmem=", 10) == 0)
            parse_memrange(argv[a] + 10, &dumpmem_start, &dumpmem_len);
        else if (strcmp(argv[a], "--dumpregs") == 0)
            dumpregs = 1;
        else if (strcmp(argv[a], "--riptrace") == 0)
            riptrace = 1;
        else if (strcmp(argv[a], "--sys") == 0)
            sys_trace = 1;
        else if (strcmp(argv[a], "--sample") == 0)
            sample = 1;
        else if (strcmp(argv[a], "--blob") == 0 && a + 1 < argc)
            blob = argv[++a];
        else if (argv[a][0] == '-') {
            printf("unknown option: %s\n", argv[a]);
            return Err.USAGE;
        } else
            path = argv[a];
    }
    if (blob != 0)
        return run_blob(blob, 1000);
    if (path == 0) {
        printf("usage: %s [--cmdline=...] firmware.bin\n", argv[0]);
        return Err.USAGE;
    }

    {
        int rc = read_firmware(path, &fw, &len) catch e {
            printf("load error %d: %s\n", e.id, e.msg);
            return 1;
        };
        if (rc != 0 || fw == 0)
            return 1;
    }
    defer free(fw);

    machine_init();
    if (ppt)
        g_m.rip_dump_en = 1;
    if (sys_trace)
        g_m.sys_trace = 1;
    if (riptrace)
        g_m.rip_trace_on = 1;
    g_m.stopt = stopt;
    if (sample)
        g_m.sample_on = 1;   /* 调试：低地址 #PF 时打印最近 64 条 RIP */
    if (payload) {
        int rc = machine_boot_payload(fw, len, 0x10000);
        if (rc != 0) {
            printf("payload boot failed: %d\n", rc);
            return 1;
        }
    } else {
        int rc = boot_all(fw, len, cmdline) catch e {
            printf("boot error %d: %s\n", e.id, e.msg);
            return 1;
        };
        if (rc != 0)
            return 1;
    }

    g_m.watch_fd = -1;
#if !defined(C6_WASM)
    g_m.watch_fd = open("/tmp/simwatch.bin", 1 | 0x40 | 0x200 | 0x400, 0644);
#endif
    while (!g_m.halted) {
        struct pollfd pfd[1] = {0};
        machine_run(200000);
        {
            int n = serial_take_output(out, (int)sizeof(out));
            if (n > 0) {
                fwrite(out, 1, (size_t)n, stdout);
                fflush(stdout);
            }
        }
        pfd[0].fd = 0;
        pfd[0].events = 1; /* POLLIN */
        if (poll(pfd, 1, 0) > 0) {
            char in[256] = {0};
            ssize_t got = read(0, in, sizeof(in) - 1);
            if (got > 0)
                serial_feed((u8 *)in, (int)got);
        }
    }
    {
        int n = serial_take_output(out, (int)sizeof(out));
        if (n > 0)
            fwrite(out, 1, (size_t)n, stdout);
    }

#if !defined(C6_WASM)
    if (dumpregs) {
        u32 k3 = 0;
        for (k3 = 0; k3 < 16; k3++)
            printf("[REG] %u %llx\n", k3, (unsigned long long)g_m.cpu.r[k3]);
        printf("[REG] rip %llx\n", (unsigned long long)g_m.cpu.rip);
        printf("[REG] flags %llx\n", (unsigned long long)g_m.cpu.flags);
        printf("[REG] insns %llu\n", (unsigned long long)g_m.instructions);
        {
            u32 i6 = 0;
            printf("[BYTE] ");
            for (i6 = 0; i6 < 24; i6++)
                printf("%02x", (u32)g_m.ram[0x7000 + i6]);
            printf(" | ");
            for (i6 = 0; i6 < 32; i6++)
                printf("%02x", (u32)g_m.ram[0x9200 + i6]);
            printf("\n");
        }
        if (dumpmem_len > 0) {
            u64 o = 0;
            for (o = 0; o + 16 <= dumpmem_len; o += 16) {
                u32 j = 0;
                printf("[MEM] %llx ", (unsigned long long)(dumpmem_start + o));
                for (j = 0; j < 16; j++)
                    printf("%02x", (u32)g_m.ram[dumpmem_start + o + j]);
                printf("\n");
            }
        }
        if (memhash_len > 0) {
            u64 h = 0xcbf29ce484222325ull;
            u64 i5 = 0;
            for (i5 = 0; i5 < memhash_len; i5++)
                h = (h ^ (u64)g_m.ram[memhash_start + i5]) * 0x100000001b3ull;
            printf("[MEMR] %llx\n", (unsigned long long)h);
        }
        {
            u32 chunk = 0;
            for (chunk = 0; chunk < (u32)(RAM_SIZE / 0x100000); chunk++) {
                u64 h = 0xcbf29ce484222325ull;
                u32 i4 = 0;
                u32 base = chunk * 0x100000u;
                for (i4 = 0; i4 < 0x100000u; i4++)
                    h = (h ^ (u64)g_m.ram[base + i4]) * 0x100000001b3ull;
                printf("[MEMH] %u %llx\n", chunk, (unsigned long long)h);
            }
        }
        fflush(stdout);
    }
#endif
    printf("\n[c6sim] halted, instructions=%llu, exit=%d\n",
           g_m.instructions, g_m.exit_code);
    return g_m.exit_code & 0xff;
}
