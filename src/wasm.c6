/* wasm.c6 —— 浏览器侧的导出 API（wasm-ld --export-all 会全部导出） */
#include "c6sim.h"

/* Alpine 固件约 34 MiB（内核 30 MiB + initrd 3.4 MiB），staging 必须放得下 */
static u8 g_fw_stage[48u << 20];
/* sim_set_cmdline 可能在 sim_init 之前调用；sim_init 里的 machine_init
 * 会先把 cmdline 重置成默认值，所以这里存一份，boot 前重新套用。 */
static char g_sim_cmdline[256];
static int g_sim_cmdline_set = 0;

/* 解析 C6FW 头（内联读 static staging，不把指针传进带指针参数的函数——
 * c6 wasm 后端在这类函数上有已知栈槽问题，见 DESIGN 第 10 条）。 */
static u32 fw_rd32(u32 off)
{
    return (u32)g_fw_stage[off] | ((u32)g_fw_stage[off + 1] << 8) |
           ((u32)g_fw_stage[off + 2] << 16) | ((u32)g_fw_stage[off + 3] << 24);
}

void sim_set_paced(int v)
{
    machine_set_paced(v);
}

u32 sim_fw_stage_ptr(void)
{
    return (u32)(unsigned long)g_fw_stage;
}

int sim_init(u8 *fw, int len)
{
    u32 i = 0;
    u32 mag = 0, hver = 0, ko = 0, kl = 0, io = 0, il = 0, co = 0, cl = 0;
    if (fw == 0 || len <= 0 || len > (int)sizeof(g_fw_stage)) return -1;
    for (i = 0; i < (u32)len; i++) g_fw_stage[i] = fw[i];
    machine_init();
    g_m.watch_fd = -1;      /* wasm 没有 main() 的初始化；默认 -1 才不关快通道/JIT */

    mag = fw_rd32(0);
    hver = fw_rd32(4);
    ko = fw_rd32(16);
    kl = fw_rd32(20);
    io = fw_rd32(24);
    il = fw_rd32(28);
    co = fw_rd32(32);
    cl = fw_rd32(36);
    if (mag != 0x57463643u || hver != 1u) return -2;
    if (kl == 0 || ko + kl > (u32)len || io + il > (u32)len) return -4;
    g_boot_user_cmdline_set = g_sim_cmdline_set ? 1u : 0u;
    if (g_sim_cmdline_set)
        machine_set_cmdline(g_sim_cmdline);
    return machine_boot_staged(g_fw_stage, ko, kl, io, il, co, cl, 0);
}

static u8 g_payload_stage[8192];

int sim_load_payload(u8 *code, int len)
{
    u32 i = 0;
    if (code == 0 || len <= 0 || len > 8192) return -1;
    for (i = 0; i < (u32)len; i++) g_payload_stage[i] = code[i];
    machine_init();
    return machine_boot_payload(g_payload_stage, (u32)len, 0x10000);
}

int sim_reset(void)
{
    machine_reset();
    return 0;
}

int sim_run(int n)
{
    return machine_run((u64)n);
}

/* 诊断用：1=machine halted（0xf4 关机口），2=cpu halted（hlt），
 * 4=有 pending 异常，8=被 fault_abort 打断过 */
int sim_halt_info(void)
{
    int r = 0;
    if (g_m.halted) r |= 1;
    if (g_m.cpu.halted) r |= 2;
    if (g_m.cpu.exc_pending) r |= 4;
    if (g_m.cpu.fault_abort) r |= 8;
    return r;
}

u64 sim_last_rip(void)
{
    return g_m.cpu.rip;
}

u64 sim_cpu_flags(void)
{
    return g_m.cpu.flags;
}

u64 sim_insns(void)
{
    return g_m.instructions;
}

void sim_riptrace_start(void)
{
    g_m.rip_trace_n = 0;
    g_m.rip_trace_on = 1;
}

u32 sim_rip_trace(int i)
{
    u32 off = 0;
    if (i < 0 || (u32)i >= 20000u) return 0;
    off = 0x07ff0000u + (u32)i * 4u;
    return (u32)g_m.ram[off] | ((u32)g_m.ram[off + 1] << 8) |
           ((u32)g_m.ram[off + 2] << 16) | ((u32)g_m.ram[off + 3] << 24);
}

void sim_set_stopt(u64 n)
{
    g_m.stopt = n;
    g_m.halted = 0;
    g_m.cpu.halted = 0;
}

u32 sim_rsp_trace(int i)
{
    u32 off = 0;
    if (i < 0 || (u32)i >= 20000u) return 0;
    off = 0x07ff0000u + 80000u + (u32)i * 4u;
    return (u32)g_m.ram[off] | ((u32)g_m.ram[off + 1] << 8) |
           ((u32)g_m.ram[off + 2] << 16) | ((u32)g_m.ram[off + 3] << 24);
}

int sim_rip_trace_n(void)
{
    return (int)g_m.rip_trace_n;
}

u64 sim_cpu_reg(int i)
{
    if (i < 0 || i > 15) return 0;
    return g_m.cpu.r[i];
}

u64 sim_clock_state(void)
{
    return clock_state_pack();
}

u64 sim_raise_state(void)
{
    return raise_state_pack();
}

u64 sim_pit_phase(void)
{
    return pit_phase_pack();
}

u64 sim_pic_state(void)
{
    return pic_state_pack() | ((u64)(g_m.cpu.exc_pending & 0xff) << 48);
}

u32 sim_ram_byte(u32 pa)
{
    if (pa >= (u32)RAM_SIZE) return 0;
    return (u32)g_m.ram[pa];
}

u64 sim_mem_hash_region(u32 start, u32 len)
{
    u64 h = 0xcbf29ce484222325ull;
    u64 i = 0;
    if (len > (u64)RAM_SIZE || start >= (u64)RAM_SIZE) return h;
    if (start + len > (u64)RAM_SIZE) len = (u64)RAM_SIZE - start;
    for (i = 0; i < len; i++)
        h = (h ^ (u64)g_m.ram[start + i]) * 0x100000001b3ull;
    return h;
}

int sim_status(void)
{
    return (g_m.halted || g_m.cpu.halted) ? 1 : 0;
}

int sim_serial_out(u8 *dst, int cap)
{
    return serial_take_output(dst, cap);
}

int sim_serial_in(u8 *src, int len)
{
    serial_feed(src, len);
    return len;
}

/* 网络代理：JS <-> COM2 的 SLIP 字节流。页面从 WebSocket 收到代理帧后
 * 调 sim_net_rx()，运行循环里用 sim_net_tx() 把 guest 的帧发回去。 */
int sim_net_rx(u8 *src, int len)
{
    return serial2_feed(src, (u32)len);
}

int sim_net_tx(u8 *dst, int cap)
{
    return serial2_out_take(dst, cap);
}

/* 宿主时间（Unix 秒）：页面启动时传进来，guest 的 CMOS RTC 用它，
 * HTTPS 证书校验不会因为固定常量过期。 */
int sim_set_rtc(u32 t)
{
    rtc_set_epoch((u64)t);
    return 0;
}

/* 宿主毫秒（Date.now() & 0xffffffff）：wasm 的空闲快进用它把 guest 钟
 * 对齐墙钟（否则 ping RTT 被快进撑大、DNS 提前超时）。 */
u32 g_host_ms = 0;

int sim_set_host_ms(u32 ms)
{
    g_host_ms = ms;
    return 0;
}

int sim_set_cmdline(const char *s)
{
    u32 i = 0;
    if (s == 0) return -1;
    for (i = 0; s[i] != 0 && i < sizeof(g_sim_cmdline) - 1; i++)
        g_sim_cmdline[i] = s[i];
    g_sim_cmdline[i] = 0;
    g_sim_cmdline_set = 1;
    machine_set_cmdline(s);
    return 0;
}

u64 sim_stat_insns(void)
{
    return g_m.instructions;
}

u8 *sim_ram_base(void)
{
    return g_m.ram;
}

/* 临时调试用：验证 wasm 后端上各种移位原语的正确性（DESIGN §69） */
u64 sim_dbg_shl(u64 v, u64 n)
{
    return v << (u32)n;
}

u64 sim_dbg_shr(u64 v, u64 n)
{
    return v >> (u32)n;
}

u64 sim_dbg_bitshl(u64 v, u64 cnt, u64 w)
{
    return v << (u32)(w - cnt);
}

u64 sim_dbg_bitshr(u64 v, u64 cnt, u64 w)
{
    return v >> (u32)(w - cnt);
}

u64 sim_dbg_loopshl(u64 v, u64 n)
{
    u64 r = 0;
    u64 i = 0;
    r = v;
    i = n;
    while (i > 0) {
        r = r * 2u;
        i = i - 1;
    }
    return r;
}

/* ---- wasm JIT POC 入口（JIT=1 构建时 jit_wasm.c 提供 jit_poc）----
 * 只用于链路验证：把当前 RIP 处的一条 mov eax,imm32 编译成 wasm 块并执行。
 * 返回值 0 = 成功，负值是编码/编译/执行失败的阶段号。 */
int sim_jit_poc(u64 rip)
{
#if defined(C6_JIT)
    g_m.cpu.cr[0] = 0;      /* POC 用物理地址直接跑，避开分页 */
    return jit_poc(rip);
#else
    (void)rip;
    return -99;             /* 默认构建未链接 jit_wasm.c */
#endif
}

int sim_jit_block(u64 rip)
{
#if defined(C6_JIT)
    g_m.cpu.cr[0] = 0;      /* 块级测试用物理地址直接跑，避开分页 */
    return jit_block(rip);
#else
    (void)rip;
    return -99;             /* 默认构建未链接 jit_wasm.c */
#endif
}

int sim_jit_try(u64 rip)
{
#if defined(C6_JIT)
    return jit_try(rip);
#else
    (void)rip;
    return 0;
#endif
}

int sim_jit_try2(u64 rip, u32 max_ins)
{
#if defined(C6_JIT)
    return jit_try2(rip, max_ins);
#else
    (void)rip;
    (void)max_ins;
    return 0;
#endif
}

void sim_set_jit_no_mem(int v)
{
#if defined(C6_JIT)
    jit_set_no_mem(v);
#else
    (void)v;
#endif
}

void sim_set_jit_min_n(int n)
{
#if defined(C6_JIT)
    jit_set_min_n(n);
#else
    (void)n;
#endif
}

void sim_set_jit_mask(int v)
{
#if defined(C6_JIT)
    jit_set_mask(v);
#else
    (void)v;
#endif
}

void sim_set_jit_trace(int v)
{
#if defined(C6_JIT)
    jit_set_trace(v);
#else
    (void)v;
#endif
}

void sim_set_jit(int v)
{
#if defined(C6_JIT)
    jit_set_on(v);
#else
    (void)v;
#endif
}

void sim_set_jit_window(u64 lo, u64 hi)
{
#if defined(C6_JIT)
    jit_set_window(lo, hi);
#else
    (void)lo;
    (void)hi;
#endif
}

int sim_jit_compile_only(u64 rip)
{
#if defined(C6_JIT)
    return jit_compile_only(rip);
#else
    (void)rip;
    return -1;
#endif
}

void sim_set_cr(int i, u64 v)
{
    if (i >= 0 && i < 16) {
        g_m.cpu.cr[i] = v;
        mem_tlb_flush();
    }
}

void sim_set_efer(u64 v)
{
    g_m.cpu.efer = v;
}

void sim_set_sel(int i, u64 v)
{
    if (i >= 0 && i < 8)
        g_m.cpu.sel[i] = (u16)v;
}

int sim_jit_pending(void)
{
#if defined(C6_JIT)
    return jit_pending();
#else
    return 0;
#endif
}

int sim_cpu_halted(void)
{
    return g_m.cpu.halted ? 1 : 0;
}

int sim_jit_synth(u64 a, u64 b, u32 ia, u32 ib, u32 mode)
{
#if defined(C6_JIT)
    return jit_synth_chain(a, b, ia, ib, mode);
#else
    (void)a; (void)b; (void)ia; (void)ib; (void)mode;
    return 0;
#endif
}

u64 sim_jit_stat(int i)
{
#if defined(C6_JIT)
    return jit_stat(i);
#else
    (void)i;
    return 0;
#endif
}

u64 sim_get_flags(void)
{
    return g_m.cpu.flags;
}

u64 sim_tsc(void)
{
    return g_m.tsc;
}

u64 sim_pit_count(void)
{
    return g_m.pit.count[0];
}

u64 sim_last_pit_tsc(void)
{
    return g_m.last_pit_tsc;
}

void sim_set_flags(u64 v)
{
    g_m.cpu.flags = v;
}

u64 sim_get_reg(int i)
{
    if (i < 0 || i > 15)
        return 0;
    return g_m.cpu.r[i];
}

void sim_set_reg(int i, u64 v)
{
    if (i >= 0 && i < 16)
        g_m.cpu.r[i] = v;
}

void sim_set_rip(u64 v)
{
    g_m.cpu.rip = v;
}

u64 sim_get_rip(void)
{
    return g_m.cpu.rip;
}
