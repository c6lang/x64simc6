/* hostfs.c6 —— wasm 侧的"页面存储文件系统"
 * 文件表固定 32 槽，每槽 256 KiB，共 8 MiB。JS 启动时 import IndexedDB，
 * 运行中 export dirty 槽写回。wasm 后端对局部指针变量有栈槽踩踏问题，
 * 因此所有跨调用数据指针都先存进全局，再在循环里通过全局访问。 */
#include "c6sim.h"

#define FS_SLOTS     32
#define FS_SLOT_SIZE (256u << 10)
#define FS_NAME_LEN  40

struct FsEntry {
    u8 name[FS_NAME_LEN];
    u32 len;
    u32 len_name;
    u32 dirty;
    u32 used;
};

static struct FsEntry fs_tab[FS_SLOTS];
static u8 fs_data[FS_SLOTS * FS_SLOT_SIZE];
static u8 *g_fs_name = 0;
static u32 g_fs_name_len = 0;
static u8 *g_fs_data = 0;
static u8 *g_fs_buf = 0;
static u32 g_fs_bridge_len = 0;
static u8 *g_fs_dst = 0;
static u8 *g_fs_src = 0;

static u32 ld16(u32 i)
{
    return (u32)g_fs_buf[i] | ((u32)g_fs_buf[i + 1] << 8);
}

static u32 ld32(u32 i)
{
    return (u32)g_fs_buf[i] | ((u32)g_fs_buf[i + 1] << 8) |
           ((u32)g_fs_buf[i + 2] << 16) | ((u32)g_fs_buf[i + 3] << 24);
}

static void st16(u32 i, u32 x)
{
    g_fs_buf[i] = (u8)x;
    g_fs_buf[i + 1] = (u8)(x >> 8);
}

static void st32(u32 i, u32 x)
{
    g_fs_buf[i] = (u8)x;
    g_fs_buf[i + 1] = (u8)(x >> 8);
    g_fs_buf[i + 2] = (u8)(x >> 16);
    g_fs_buf[i + 3] = (u8)(x >> 24);
}

static int name_eq(u32 slot)
{
    u32 i = 0;
    if (fs_tab[slot].len_name != g_fs_name_len) return 0;
    for (i = 0; i < g_fs_name_len; i++) {
        if (fs_tab[slot].name[i] != g_fs_name[i]) return 0;
    }
    return 1;
}

static int find_file(void)
{
    int i = 0;
    for (i = 0; i < FS_SLOTS; i++) {
        if (fs_tab[i].used && name_eq((u32)i)) return i;
    }
    return -1;
}

int sim_hostfs_put(u8 *name, u32 name_len, u8 *data, u32 len)
{
    u32 i = 0;
    int slot = 0;
    if (name == 0 || data == 0 || name_len == 0 || name_len >= FS_NAME_LEN) return -1;
    if (len > FS_SLOT_SIZE) return -2;
    g_fs_name = name;
    g_fs_name_len = name_len;
    g_fs_data = data;
    slot = find_file();
    if (slot < 0) {
        for (i = 0; i < FS_SLOTS; i++) {
            if (!fs_tab[i].used) { slot = (int)i; break; }
        }
    }
    if (slot < 0) return -3;
    g_fs_dst = fs_tab[slot].name;
    i = 0;
    for (i = 0; i < FS_NAME_LEN; i++) g_fs_dst[i] = (i < name_len) ? g_fs_name[i] : 0;
    g_fs_dst = fs_data + slot * FS_SLOT_SIZE;
    i = 0;
    for (i = 0; i < len; i++) g_fs_dst[i] = g_fs_data[i];
    fs_tab[slot].len = len;
    fs_tab[slot].len_name = name_len;
    fs_tab[slot].used = 1;
    fs_tab[slot].dirty = 1;
    return 0;
}

int sim_hostfs_get(u8 *name, u32 name_len, u8 *dst, u32 cap)
{
    int slot = 0;
    u32 n = 0, i = 0;
    if (name == 0 || dst == 0) return -1;
    g_fs_name = name;
    g_fs_name_len = name_len;
    g_fs_data = dst;
    slot = find_file();
    if (slot < 0) return -1;
    n = fs_tab[slot].len;
    if (n > cap) n = cap;
    g_fs_src = fs_data + slot * FS_SLOT_SIZE;
    i = 0;
    for (i = 0; i < n; i++)
        g_fs_data[i] = g_fs_src[i];
    return (int)n;
}

/* 记录格式：u16 name_len, u16 pad, u32 data_len, name[name_len], data[data_len] */
int sim_hostfs_import(u8 *buf, u32 len)
{
    u32 off = 0, nl = 0, dl = 0, i = 0;
    int count = 0;
    u8 name[FS_NAME_LEN] = {0};
    if (buf == 0) return -1;
    g_fs_buf = buf;
    while (off + 8 <= len) {
        nl = ld16(off);
        dl = ld32(off + 4);
        off += 8;
        if (nl == 0) break;
        if (nl >= FS_NAME_LEN || off + nl + dl > len) return -1;
        for (i = 0; i < nl; i++) name[i] = g_fs_buf[off + i];
        name[nl] = 0;
        off += nl;
        if (sim_hostfs_put(name, nl, buf + off, dl) != 0) return -2;
        off += dl;
        count++;
    }
    return count;
}

int sim_hostfs_export(u8 *buf, u32 cap)
{
    u32 off = 0, nl = 0, i = 0, j = 0;
    int count = 0;
    if (buf == 0 || cap < 8) return -1;
    g_fs_buf = buf;
    for (i = 0; i < FS_SLOTS; i++) {
        if (!fs_tab[i].used || !fs_tab[i].dirty) continue;
        nl = fs_tab[i].len_name;
        if (off + 8 + nl + fs_tab[i].len > cap) break;
        st16(off, nl);
        st16(off + 2, 0);
        st32(off + 4, fs_tab[i].len);
        off += 8;
        for (j = 0; j < nl; j++) g_fs_buf[off + j] = fs_tab[i].name[j];
        off += nl;
        for (j = 0; j < fs_tab[i].len; j++)
            g_fs_buf[off + j] = fs_data[i * FS_SLOT_SIZE + j];
        off += fs_tab[i].len;
        fs_tab[i].dirty = 0;
        count++;
    }
    st16(off, 0);
    st16(off + 2, 0);
    st32(off + 4, 0);
    return (int)(off + 8);
}

/* 共享内存邮箱：JS 写入字节，再调用 sim_host_event(code, len) */
static u8 g_bridge[65536];

u8 *sim_host_bridge(void)
{
    return g_bridge;
}

int sim_host_event(u32 code, u32 len)
{
    if (len > sizeof(g_bridge)) return -1;
    if (code == 1) return 0;  /* NET_RESPONSE：JS 已通过 sim_hostfs_put 写入 __net/last */
    if (code == 2) return 0;
    if (code == 3) { serial_feed(g_bridge, (int)len); return 0; }
    return -2;
}

u32 sim_bridge_len(void)
{
    return g_fs_bridge_len;
}
