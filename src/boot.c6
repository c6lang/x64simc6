/* boot.c6 —— C6FW 固件解析 + Linux x86-64 直接引导 */
#if !defined(C6_WASM)
#include <stdio.h>
#endif
#include "c6sim.h"

#define BP_HDR_OFF   0x1f1u
#define E820_OFF     0x2d0u
#define E820_COUNT   0x1e8u

#define H_TYPE_LOADER    0x1fu
#define H_LOADFLAGS      0x20u
#define H_SETUP_MOVE     0x21u
#define H_CODE32_START   0x23u
#define H_RAMDISK_IMAGE  0x27u
#define H_RAMDISK_SIZE   0x2bu
#define H_HEAP_END       0x33u
#define H_CMDLINE_PTR    0x37u
#define H_INITRD_MAX     0x3bu
#define H_VERSION        0x15u
#define H_HEADER_MAGIC   0x11u

/* 固件长度单独放全局：c6 的 wasm 后端在「结构体里紧跟在指针后的 u32 成员」上
 * 读写偏移不一致（native 正常），用它绕开，保证浏览器也能引导完整固件。 */
u32 g_fw_klen = 0;
u32 g_fw_ilen = 0;

static u32 rd32(const u8 *p)
{
    return (u32)p[0] | ((u32)p[1] << 8) | ((u32)p[2] << 16) | ((u32)p[3] << 24);
}

/* 固件解析；wasm 路径不用 err/f-string（运行库 ABI 不匹配），错误用返回码 */
int machine_load_firmware(u8 *fw, u32 len)
{
    struct Machine *m = &g_m;
    if (len < FW_HDR_SIZE) return -1;
    if (fw[0] != FW_MAGIC0 || fw[1] != FW_MAGIC1 ||
        fw[2] != FW_MAGIC2 || fw[3] != FW_MAGIC3) return -2;
    if (rd32(fw + 4) != FW_VERSION) return -3;
    m->fw_kernel = fw + rd32(fw + 16);
    m->fw_kernel_len = rd32(fw + 20);
    m->fw_initrd = fw + rd32(fw + 24);
    m->fw_initrd_len = rd32(fw + 28);
    g_fw_klen = m->fw_kernel_len;
    g_fw_ilen = m->fw_initrd_len;
    if (m->fw_kernel_len == 0) return -4;
    if (rd32(fw + 8) + m->fw_kernel_len > len) return -5;
    if (rd32(fw + 8) > len || rd32(fw + 24) > len) return -6;
    if (rd32(fw + 24) + m->fw_initrd_len > len) return -7;
    if (rd32(fw + 32) != 0 && rd32(fw + 36) != 0) {
        u32 n = rd32(fw + 36);
        if (n > sizeof(m->cmdline) - 1) n = sizeof(m->cmdline) - 1;
        m->cmdline_len = n;
        {
            u32 i = 0;
            for (i = 0; i < n; i++)
                m->cmdline[i] = fw[rd32(fw + 32) + i];
        }
        m->cmdline[n] = 0;
    }
    return 0;
}

void machine_set_cmdline(const char *s)
{
    u32 i = 0;
    for (i = 0; s[i] != 0 && i < sizeof(g_m.cmdline) - 1; i++)
        g_m.cmdline[i] = (u8)s[i];
    g_m.cmdline[i] = 0;
    g_m.cmdline_len = i;
}

static void zero_boot_params(void)
{
    u32 i = 0;
    for (i = 0; i < 4096; i++)
        mem_w8(BOOTPARAMS_PA + i, 0);
}

static void build_e820(struct Machine *m)
{
    struct E { u64 base; u64 size; u32 type; };
    struct E tab[4] = {0};
    u32 i = 0, o = 0;

    tab[0].base = 0;
    tab[0].size = 0x9fc00u;
    tab[0].type = 1;
    tab[1].base = 0x9fc00u;
    tab[1].size = 0x400u;
    tab[1].type = 2;
    tab[2].base = 0xf0000u;
    tab[2].size = 0x10000u;
    tab[2].type = 2;
    tab[3].base = 0x100000u;
    tab[3].size = RAM_TOP - 0x100000u;
    tab[3].type = 1;

    for (i = 0; i < 4; i++) {
        u64 v = tab[i].base;
        u64 sz = tab[i].size;
        u32 t = tab[i].type;
        for (o = 0; o < 8; o++) {
            mem_w8(BOOTPARAMS_PA + E820_OFF + i * 20 + o, (u8)(v & 0xff));
            v >>= 8;
        }
        for (o = 0; o < 8; o++) {
            mem_w8(BOOTPARAMS_PA + E820_OFF + i * 20 + 8 + o, (u8)(sz & 0xff));
            sz >>= 8;
        }
        mem_w32(BOOTPARAMS_PA + E820_OFF + i * 20 + 16, t);
    }
    mem_w8(BOOTPARAMS_PA + E820_COUNT, 4);
    mem_w16(BOOTPARAMS_PA + 0x1e0, (u16)(0x9fc00u >> 10));  /* alt_mem_k */
    (void)m;
}

static void build_page_tables(void)
{
    u32 i = 0;
    u64 pml4 = PML4_PA;
    u64 pdpt = PDPT_PA;
    u64 pd = PD_PA;
    u64 pd3 = 0x0000b000u;

    for (i = 0; i < 512; i++) {
        mem_w64(pml4 + i * 8, 0);
        mem_w64(pdpt + i * 8, 0);
        mem_w64(pd + i * 8, 0);
        mem_w64(pd3 + i * 8, 0);
    }
    mem_w64(pml4, pdpt | 3);
    mem_w64(pml4 + 3 * 8, pdpt | 3);          /* 3GiB 区：APIC */
    mem_w64(pml4 + 511 * 8, pdpt | 3);        /* 内核高半区 -2GiB */
    mem_w64(pdpt, pd | 3);
    mem_w64(pdpt + 3 * 8, pd3 | 3);
    for (i = 504; i < 512; i++)              /* 高半区多个 PDPT 窗口映射到 0..1GiB */
        mem_w64(pdpt + i * 8, pd | 3);
    for (i = 0; i < 64; i++)                  /* 0..128MiB，2MiB 大页 */
        mem_w64(pd + i * 8, ((u64)i << 21) | 0x83);
    mem_w64(pd3 + 0xf6 * 8, 0xfec00000u | 0x83); /* IOAPIC */
    mem_w64(pd3 + 0xf7 * 8, 0xfee00000u | 0x83); /* LAPIC */
}

static void build_gdt_idt(void)
{
    u32 i = 0;
    for (i = 0; i < 8; i++)
        mem_w64(GDT_PA + i * 8, 0);
    /* 不用 u64 常量直接 mem_w64：c6 的 wasm 后端会把这种字面量截断成低 32 位，
     * 导致 GDT 描述符的 access/flags 字节全变 0。显式写两半最稳。 */
    mem_w32(GDT_PA + 8,  0x0000ffffu);           /* 64-bit code: limit */
    mem_w32(GDT_PA + 12, 0x00af9b00u);           /* 64-bit code: base/flags */
    mem_w32(GDT_PA + 16, 0x0000ffffu);           /* 64-bit data: limit */
    mem_w32(GDT_PA + 20, 0x00cf9300u);           /* 64-bit data: base/flags */
    for (i = 0; i < 256; i++) {
        mem_w64(IDT_PA + i * 16, 0);
        mem_w64(IDT_PA + i * 16 + 8, 0);
    }
}

#define PVH_START_PA 0x0000c000u
#define PVH_MMAP_PA  0x0000c400u

/* PVH 启动协议：EBX 指向 struct hvm_start_info。 */
static void build_pvh_start_info(void)
{
    u32 i = 0;
    for (i = 0; i < 0x500; i++) {
        mem_w8(PVH_START_PA + i, 0);
        mem_w8(PVH_MMAP_PA + i, 0);
    }
    mem_w32(PVH_START_PA + 0, 0x336ec578u);  /* XEN_HVM_START_MAGIC_VALUE */
    mem_w32(PVH_START_PA + 4, 1);             /* version */
    mem_w32(PVH_START_PA + 8, 0);             /* flags */
    mem_w32(PVH_START_PA + 12, 0);            /* nr_modules */
    mem_w64(PVH_START_PA + 16, 0);            /* modlist_paddr */
    mem_w64(PVH_START_PA + 24, CMDLINE_PA);   /* cmdline_paddr */
    mem_w64(PVH_START_PA + 32, 0);            /* rsdp_paddr */
    mem_w64(PVH_START_PA + 40, PVH_MMAP_PA);  /* memmap_paddr */
    mem_w32(PVH_START_PA + 48, 4);            /* memmap_entries */
    mem_w32(PVH_START_PA + 52, 0);
    /* PVH memmap 条目是 24 字节：addr(8) size(8) type(4) reserved(4) */
    for (i = 0; i < 4; i++) {
        mem_w64(PVH_MMAP_PA + i * 24, mem_r64(E820_OFF + i * 20));
        mem_w64(PVH_MMAP_PA + i * 24 + 8, mem_r64(E820_OFF + i * 20 + 8));
        mem_w32(PVH_MMAP_PA + i * 24 + 16, mem_r32(E820_OFF + i * 20 + 16));
        mem_w32(PVH_MMAP_PA + i * 24 + 20, 0);
    }
    for (i = 0; i < 56; i++)
        mem_w8(0x2b2bb60 + i, mem_r8(PVH_START_PA + i));
}

u64 boot_probe(void)
{
    return (g_m.fw_kernel_len << 8) | ((g_m.fw_kernel != 0) ? 1u : 0u);
}

/* 把固件按 4 字节块搬进 0..128MiB 的恒等映射区 */
static void copy_to_ram(u32 pa, const u8 *src, u32 len)
{
    u32 i = 0;
    u32 n4 = len / 4u;
    u32 *d = (u32 *)&g_m.ram[pa];
    const u32 *s = (const u32 *)src;
    for (i = 0; i < n4; i++) d[i] = s[i];
    for (i = n4 * 4u; i < len; i++) g_m.ram[pa + i] = src[i];
}

/* wasm 专用入口：c6 的 wasm 后端在不同 TU 里对同一结构体成员的偏移不一致
 * （实测 wasm.c6 写 fw_kernel_len、boot.c6 读出来是 0），所以固件字段的
 * 写入必须和 machine_boot() 在同一个 TU 内完成。 */
int machine_boot_staged(u8 *base, u32 koff, u32 klen,
                        u32 ioff, u32 ilen, u32 coff, u32 clen)
{
    u32 k = 0;
    g_m.fw_kernel = base + koff;
    g_m.fw_kernel_len = klen;
    g_m.fw_initrd = base + ioff;
    g_m.fw_initrd_len = ilen;
    g_fw_klen = klen;
    g_fw_ilen = ilen;
    if (coff != 0 && clen != 0) {
        u32 n = clen;
        if (n > sizeof(g_m.cmdline) - 1) n = sizeof(g_m.cmdline) - 1;
        for (k = 0; k < n; k++) g_m.cmdline[k] = base[coff + k];
        g_m.cmdline[k] = 0;
        g_m.cmdline_len = n;
    }
    return machine_boot();
}

int machine_boot(void)
{
    struct Machine *m = &g_m;
    struct CPUState *c = &m->cpu;
    u32 i = 0;
    u64 cmdlen = 0;

    /* 这里刻意用全局 g_m 而不是 m->：c6 的 wasm 后端在「通过局部指针读结构体
     * 成员」时会取到 0（写进去是对的），表现为 machine_boot 立即返回 -1。 */
    if (g_m.fw_kernel == 0 || g_fw_klen == 0) return -1;
    if (g_fw_klen > (RAM_TOP - KERNEL_PA)) return -2;
    if (g_fw_ilen > (RAM_TOP - INITRD_PA)) return -3;

    zero_boot_params();
    /* 内核/initrd 落在 0..128MiB 的恒等映射区，直接搬进 RAM 即可。
       逐字节 mem_w8 要 5.5G 条宿主指令（约 1.5 秒）；c6 运行时的 memcpy
       也是字节循环，这里按 4 字节块搬（wasm32 下 u32 指针最稳）。 */
    copy_to_ram(KERNEL_PA, g_m.fw_kernel, g_fw_klen);
    copy_to_ram(INITRD_PA, g_m.fw_initrd, g_fw_ilen);
    for (i = 0; i < g_m.cmdline_len; i++)
        mem_w8(CMDLINE_PA + i, g_m.cmdline[i]);
    mem_w8(CMDLINE_PA + g_m.cmdline_len, 0);
    cmdlen = g_m.cmdline_len;

    build_e820(m);
    build_pvh_start_info();

    /* setup_header：直接引导所需字段 */
    mem_w16(BOOTPARAMS_PA + BP_HDR_OFF + H_HEADER_MAGIC, 0x6448); /* 'Hd' */
    mem_w16(BOOTPARAMS_PA + BP_HDR_OFF + H_HEADER_MAGIC + 2, 0x5372); /* 'rS' */
    mem_w16(BOOTPARAMS_PA + BP_HDR_OFF + H_VERSION, 0x020f);
    mem_w8(BOOTPARAMS_PA + BP_HDR_OFF + H_TYPE_LOADER, 0xff);
    mem_w8(BOOTPARAMS_PA + BP_HDR_OFF + H_LOADFLAGS, 0x81);
    mem_w16(BOOTPARAMS_PA + BP_HDR_OFF + H_SETUP_MOVE, 0x9000);
    mem_w32(BOOTPARAMS_PA + BP_HDR_OFF + H_CODE32_START, KERNEL_PA);
    mem_w32(BOOTPARAMS_PA + BP_HDR_OFF + H_RAMDISK_IMAGE, INITRD_PA);
    mem_w32(BOOTPARAMS_PA + BP_HDR_OFF + H_RAMDISK_SIZE, g_fw_ilen);
    mem_w16(BOOTPARAMS_PA + BP_HDR_OFF + H_HEAP_END, 0xdf00);
    mem_w32(BOOTPARAMS_PA + BP_HDR_OFF + H_CMDLINE_PTR, CMDLINE_PA);
    mem_w32(BOOTPARAMS_PA + BP_HDR_OFF + H_INITRD_MAX, RAM_TOP - 1);
    mem_w32(BOOTPARAMS_PA + BP_HDR_OFF + 0x6f, RAM_TOP); /* init_size */
    mem_w8(BOOTPARAMS_PA + 0x1ef, 0);                   /* sentinel：清零表示 bootloader 可信 */
    mem_w16(BOOTPARAMS_PA + BP_HDR_OFF + 0x0d, 0xaa55);  /* boot_flag */

    build_page_tables();
    build_gdt_idt();

    cpu_init(c);
    c->r[4] = 0x38000;                 /* 早期栈 */
    c->r[3] = 0;                       /* 非 PVH：EBX 不使用 */
    c->r[6] = BOOTPARAMS_PA;           /* RSI：boot_params */
    c->rip = KERNEL_PA + 0x90;         /* startup_64（跳过 pvh_start_xen） */
    c->cr[3] = PML4_PA;
    c->cr[4] = CR4_PAE | CR4_PSE | CR4_OSFXSR;
    c->efer = EFER_SCE | EFER_LME | EFER_LMA | EFER_NXE;
    c->cr[0] = CR0_PE | CR0_MP | CR0_PG;
    c->gdtr_base = GDT_PA;
    c->gdtr_limit = 0x17;
    c->idtr_base = IDT_PA;
    c->idtr_limit = 0xfff;
    c->sel[1] = 0x10;                  /* CS */
    c->sel[2] = 0x18;                  /* DS */
    c->sel[3] = 0x18;                  /* ES */
    c->sel[4] = 0;                     /* FS */
    c->sel[5] = 0;                     /* GS */
    c->sel[0] = 0x18;                  /* SS */
    c->msr_apicbase = 0xfee00800u;
    c->msr_lstar = 0xffffffffffff0000u;

    m->halted = 0;
    m->exit_code = 0;
    m->instructions = 0;
    m->tsc = 0;
    m->last_pit_tsc = 0;
    mem_tlb_flush();
    dev_init();
    (void)cmdlen;
    return 0;
}

/* 手汇编 payload：不装内核，只在长模式里执行一段代码（冒烟用） */
int machine_boot_payload(u8 *code, u32 len, u64 addr)
{
    struct Machine *m = &g_m;
    struct CPUState *c = &m->cpu;
    u32 i = 0;

    if (code == 0 || len == 0 || addr + len > RAM_TOP)
        return -1;
    zero_boot_params();
    build_page_tables();
    build_gdt_idt();
    for (i = 0; i < len; i++)
        mem_w8(addr + i, code[i]);
    cpu_init(c);
    c->r[4] = 0x38000;
    c->rip = addr;
    c->cr[3] = PML4_PA;
    c->cr[4] = CR4_PAE | CR4_PSE | CR4_OSFXSR;
    c->efer = EFER_SCE | EFER_LME | EFER_LMA;
    c->cr[0] = CR0_PE | CR0_MP | CR0_PG;
    c->gdtr_base = GDT_PA;
    c->gdtr_limit = 0x17;
    c->idtr_base = IDT_PA;
    c->idtr_limit = 0xfff;
    c->sel[1] = 0x10;
    c->sel[2] = 0x18;
    c->sel[0] = 0x18;
    m->halted = 0;
    m->exit_code = 0;
    m->instructions = 0;
    m->tsc = 0;
    m->last_pit_tsc = 0;
    mem_tlb_flush();
    dev_init();
    return 0;
}
