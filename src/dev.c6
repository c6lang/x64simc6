/* dev.c6 —— 最小设备模型：16550A / 8259A / 8254 / CMOS / PCI / LAPIC */
#if !defined(C6_WASM)
#include <stdio.h>
#endif
#include "c6sim.h"

/* ---------------- 串口环形缓冲 ---------------- */

/* c6 wasm 后端对「结构体内的数组元素」读写会出错（isr/irr/imr 位丢失），
 * 这三组 PIC 位图改用独立全局，读写都走平坦地址。 */
u8 g_pic_irr[2] = {0, 0};
u8 g_pic_isr[2] = {0, 0};
u8 g_pic_imr[2] = {0, 0};
u32 g_raise_cnt[2] = {0, 0};   /* 调试：pic_raise 的调用次数（主片/从片） */
u32 g_tick_cnt = 0;
u64 g_ser_out_bytes = 0;
u32 g_ser_rd[8] = {0};
u32 g_ser_wr[8] = {0};
u32 g_ser_last_ier = 0;
u32 g_ser_last_mcr = 0;
u32 g_ser_last_lsr = 0;
u64 g_irq4_raises = 0;            /* 调试：dev_tick 实际推进 PIT 的次数 */
int serial_take_output(u8 *dst, int cap)
{
    int n = 0;
    while (n < cap && g_m.serial.out_tail != g_m.serial.out_head) {
        dst[n] = g_m.serial.out[(u32)g_m.serial.out_tail & 0xffff];
        g_m.serial.out_tail++;
        n++;
    }
    return n;
}

void serial_feed(const u8 *src, int len)
{
    int i = 0;
    for (i = 0; i < len; i++) {
        g_m.serial.in[(u32)g_m.serial.in_head & 0xfff] = src[i];
        g_m.serial.in_head++;
    }
    if (len > 0) {
        if (!(g_m.serial.lsr & 1)) {
            g_m.serial.lsr |= 1;                 /* DR */
            if (g_m.serial.ier & 1)
                pic_raise(&g_m, 4);
        }
    }
}

static u8 serial_read(u32 port)
{
    u32 off = port & 7;
    g_ser_rd[off & 7] = g_ser_rd[off & 7] + 1;
    if (g_m.serial.lcr & 0x80) {
        if (off == 0) return g_m.serial.dll;
        if (off == 1) return g_m.serial.dlm;
    }
    if (off == 0) {
        if (g_m.serial.in_tail != g_m.serial.in_head) {
            g_m.serial.rbr = g_m.serial.in[(u32)g_m.serial.in_tail & 0xfff];
            g_m.serial.in_tail++;
            if (g_m.serial.in_tail == g_m.serial.in_head)
                g_m.serial.lsr &= ~((u8)1);
        }
        return g_m.serial.rbr;
    }
    if (off == 1) return g_m.serial.ier;
    if (off == 2) {
        if ((g_m.serial.ier & 1) && (g_m.serial.in_tail != g_m.serial.in_head)) return 4;  /* RBR */
        if (g_m.serial.ier & 2) return 2;                                  /* THRE */
        return 1;                                                  /* none */
    }
    if (off == 3) return g_m.serial.lcr;
    if (off == 4) return g_m.serial.mcr;
    if (off == 5) { g_ser_last_lsr = g_m.serial.lsr; return g_m.serial.lsr; }
    if (off == 6) return g_m.serial.msr;
    return g_m.serial.fcr;
}

static void serial_write(u32 port, u8 v)
{
    u32 off = port & 7;
    g_ser_wr[off & 7] = g_ser_wr[off & 7] + 1;
    if (off == 1) g_ser_last_ier = v;
    if (off == 4) g_ser_last_mcr = v;
    if (g_m.serial.lcr & 0x80) {
        if (off == 0) { g_m.serial.dll = v; return; }
        if (off == 1) { g_m.serial.dlm = v; return; }
    }
    switch (off) {
    case 0:
        g_ser_out_bytes = g_ser_out_bytes + 1;
        g_m.serial.out[(u32)g_m.serial.out_head & 0xffff] = v;
        g_m.serial.out_head++;
        g_m.serial.lsr |= 0x40;
        if (g_m.serial.ier & 2)
            pic_raise(&g_m, 4);
        break;
    case 1:
        g_m.serial.ier = v;
        /*
         * 16550 的 THRE/RX 中断是**电平**语义：驱动在 start_tx 里只把
         * UART_IER_THRI 置上就返回，真正把字节塞进 THR 是中断处理里做的。
         * 如果这里不主动再拉一次 IRQ4，第一次 tty 写就会永久卡住
         * （表现为用户态 write() 不返回、串口一个字节都不出）。
         */
        if ((v & 2) && (g_m.serial.lsr & 0x20))
            pic_raise(&g_m, 4);
        if ((v & 1) && (g_m.serial.in_head != g_m.serial.in_tail))
            pic_raise(&g_m, 4);
        break;
    case 2: g_m.serial.fcr = v; break;
    case 3: g_m.serial.lcr = v; break;
    case 4: g_m.serial.mcr = v; break;
    default: break;
    }
}

/* ---------------- COM2 (ttyS1)：SLIP 网关 ----------------
 * 第二个 16550A，落在标准 COM2 端口 0x2f8、IRQ3。guest 用 slattach 把
 * /dev/ttyS1 切到 N_SLIP，IP 包按 RFC 1055 搬运：
 *   - native：串口字节 <-> src/net.c6 的用户态 NAT（或 --netshim 的 stdout）；
 *   - wasm：串口字节 <-> JS（sim_net_tx/sim_net_rx），页面再通过 WebSocket
 *     代理到宿主上的 --netshim 进程。
 * 环放在全局数组里（wasm 后端对结构体内数组下标的读写有坑）。
 */
#define SER2_RING 131072u
static u8 g_s2_in[SER2_RING];
static u8 g_s2_out[SER2_RING];
struct Serial2State {
    u8 ier, fcr, lcr, mcr, scr, dll, dlm, lsr, rbr, thre_pending;
    u32 in_head, in_tail;
    u32 out_head, out_tail;
};
static struct Serial2State g_s2;

static void serial2_reset(void)
{
    u32 i = 0;
    for (i = 0; i < (u32)sizeof(g_s2); i++) ((u8 *)&g_s2)[i] = 0;
    for (i = 0; i < SER2_RING; i++) {
        g_s2_in[i] = 0;
        g_s2_out[i] = 0;
    }
    g_s2.lcr = 0x03;
    g_s2.lsr = 0x60;
    g_s2.ier = 0;
    g_s2.thre_pending = 1;    /* 复位后 THR 为空，允许驱动使能 THRI 后立刻进中断 */
}

int serial2_space(void)
{
    return (int)(SER2_RING - (g_s2.in_head - g_s2.in_tail));
}

int serial2_feed(const u8 *buf, u32 n)
{
    u32 i = 0;
    if (n == 0) return 0;
#if !defined(C6_WASM)
    if (g_net_shim) {                         /* --netshim：帧直接写 stdout 给代理 */
        size_t w = fwrite(buf, 1, (size_t)n, stdout);
        fflush(stdout);
        return (w == (size_t)n) ? (int)n : 0;
    }
#endif
    if (n > (u32)serial2_space()) return 0;   /* 整帧要么全进、要么等下一轮 */
    for (i = 0; i < n; i++) {
        g_s2_in[g_s2.in_head & (SER2_RING - 1u)] = buf[i];
        g_s2.in_head++;
    }
    g_s2.lsr |= 1;                            /* DR */
    if (g_s2.ier & 1) pic_raise(&g_m, 3);
#if !defined(C6_WASM)
    if (g_ntrace) printf("[NT] feed n=%u ier=%02x\n", n, (unsigned)g_s2.ier);
#endif
    return (int)n;
}

/* guest 写到 THR 的字节（wasm 侧由 JS 取走送 WebSocket）；native 不用 */
int serial2_out_take(u8 *dst, int cap)
{
    int n = 0;
    while (n < cap && g_s2.out_tail != g_s2.out_head) {
        dst[n] = g_s2_out[g_s2.out_tail & (SER2_RING - 1u)];
        g_s2.out_tail++;
        n++;
    }
    return n;
}

static u8 serial2_read(u32 port)
{
    u32 off = port & 7;
    if (g_s2.lcr & 0x80) {
        if (off == 0) return g_s2.dll;
        if (off == 1) return g_s2.dlm;
    }
    if (off == 0) {
        if (g_s2.in_tail != g_s2.in_head) {
            g_s2.rbr = g_s2_in[g_s2.in_tail & (SER2_RING - 1u)];
            g_s2.in_tail++;
            if (g_s2.in_tail == g_s2.in_head) g_s2.lsr &= (u8)~1;
        }
        return g_s2.rbr;
    }
    if (off == 1) return g_s2.ier;
    if (off == 2) {
        /* 16550 优先级：RX(4) 高于 THRE(2)。THRE 挂起态被读 IIR 清除
         * （或写 THR），否则 dev_tick 会一直重拉 IRQ3，guest 卡死在
         * THRE 中断风暴里（表现：sl0 TX queue timed out）。
         * RX 挂起不能在这里清，它由读 RBR 清。 */
        if ((g_s2.ier & 1) && (g_s2.in_tail != g_s2.in_head)) return 4;
        if ((g_s2.ier & 2) && g_s2.thre_pending) {
            g_s2.thre_pending = 0;
            return 2;
        }
        return 1;
    }
    if (off == 3) return g_s2.lcr;
    if (off == 4) return g_s2.mcr;
    if (off == 5) return (u8)(g_s2.lsr | 0x60);
    if (off == 6) return 0xb0;
    return g_s2.scr;
}

static void serial2_write(u32 port, u8 v)
{
    u32 off = port & 7;
    if (g_s2.lcr & 0x80) {
        if (off == 0) { g_s2.dll = v; return; }
        if (off == 1) { g_s2.dlm = v; return; }
    }
    switch (off) {
    case 0:
        g_s2.lsr |= 0x40;
        g_s2.thre_pending = 1;   /* 发送"瞬时"完成：THR 又空了 */
#if defined(C6_WASM)
        if ((g_s2.out_head - g_s2.out_tail) < SER2_RING) {
            g_s2_out[g_s2.out_head & (SER2_RING - 1u)] = v;
            g_s2.out_head++;
        }
#else
        slip_rx_byte((u32)v);
#endif
        if (g_s2.ier & 2) pic_raise(&g_m, 3);
        break;
    case 1:
        g_s2.ier = v;
        if ((v & 2) && g_s2.thre_pending) pic_raise(&g_m, 3);
        if ((v & 1) && (g_s2.in_head != g_s2.in_tail)) pic_raise(&g_m, 3);
        break;
    case 2: g_s2.fcr = v; break;
    case 3: g_s2.lcr = v; break;
    case 4: g_s2.mcr = v; break;
    case 7: g_s2.scr = v; break;
    default: break;
    }
}

/* ---------------- 8259A PIC ---------------- */

void pic_raise(struct Machine *m, u8 irq)
{
    u8 bit = (u8)(1 << (irq & 7));
    (void)m;
    if (irq > 15) return;
    if (irq == 4) g_irq4_raises = g_irq4_raises + 1;
    if (irq < 8) {
        g_raise_cnt[0] = g_raise_cnt[0] + 1;
    } else {
        g_raise_cnt[1] = g_raise_cnt[1] + 1;
    }
    if (irq < 8) {
        if (!(g_pic_imr[0] & bit)) {
            u8 t0 = g_pic_irr[0];
            t0 = (u8)(t0 | bit);
            g_pic_irr[0] = t0;
        }
    } else {
        if (!(g_pic_imr[1] & bit)) {
            u8 t1 = g_pic_irr[1];
            t1 = (u8)(t1 | bit);
            g_pic_irr[1] = t1;
        }
    }
}

static u8 pic_read(u32 port)
{
    if (port == 0x20 || port == 0xa0) {
        u32 i = (port == 0xa0) ? 1 : 0;
        return g_m.pic.read_isr ? g_pic_isr[i] : g_pic_irr[i];
    }
    if (port == 0x21) return g_pic_imr[0];
    if (port == 0xa1) return g_pic_imr[1];
    return 0xff;
}

static void pic_write(u32 port, u8 v)
{
    u32 slave = (port >= 0xa0) ? 1 : 0;
    u32 cmd_port = slave ? 0xa0 : 0x20;
    u32 data_port = slave ? 0xa1 : 0x21;
    /* 初始化序列期间，数据口上的写是 ICW2/ICW3/ICW4，不是 IMR */
    if (port == data_port && g_m.pic.init_state[slave] != 0) {
        if (g_m.pic.init_state[slave] == 1) { g_m.pic.icw2[slave] = v; g_m.pic.init_state[slave] = 2; return; }
        if (g_m.pic.init_state[slave] == 2) { g_m.pic.icw3[slave] = v; g_m.pic.init_state[slave] = 3; return; }
        g_m.pic.icw4[slave] = v;
        g_m.pic.init_state[slave] = 0;
        return;
    }
    if (port == data_port) { g_pic_imr[slave] = v; return; }
    if (port != cmd_port) return;

    if (v & 0x10) {                    /* ICW1 */
        g_m.pic.icw1 = v;
        g_m.pic.init_state[slave] = ((v & 1) != 0) ? 2 : 3;   /* 是否需要 ICW4 */
        g_m.pic.icw4[slave] = 0;
        if (v & 1) g_m.pic.init_state[slave] = 1;
        g_pic_imr[slave] = 0xff;
        g_pic_irr[slave] = 0;
        g_pic_isr[slave] = 0;
        g_m.pic.icw2[slave] = slave ? 0x28 : 0x20;
        return;
    }
    if (v & 0x08) { g_m.pic.read_isr = (v & 2) ? 1 : 0; return; }   /* OCW3 */
    if (v & 0x20) {                                            /* EOI */
        u8 bit = 0;
        if ((v & 0xc0) == 0x40) {           /* 非指定 EOI：清掉全部在服务的位 */
            g_pic_isr[0] = 0;
            g_pic_isr[1] = 0;
            return;
        }
        /* OCW2 = 0110 0L2L1L0（指定 EOI）或 0010 0000（非指定）：
         * 指定 EOI 的低 3 位是**这一片的 IRQ 号**，必须只清对应那一位。
         * Linux 的 8259 驱动只发指定 EOI；以前我们无脑清「最低的置位位」，
         * 定时器（IRQ0）和串口（IRQ4）同时在服务时，EOI(4) 会把 IRQ0 的
         * 服务位清掉、IRQ4 永远留在 ISR 里 —— 之后 IRQ4 一律不再投递，
         * 表现为控制台输出卡在一行中间、top 不刷新、提示符只出一半。 */
        if (v & 0x40) {
            bit = (u8)(1 << (v & 7));
            if (slave)
                g_pic_isr[1] = (u8)(g_pic_isr[1] & (u8)~bit);
            else
                g_pic_isr[0] = (u8)(g_pic_isr[0] & (u8)~bit);
            return;
        }
        /* 非指定 EOI：清最高优先级（编号最低）的在服务位 */
        {
            u32 i = 0;
            for (i = 0; i < 8; i++) {
                u8 b = (u8)(1 << i);
                if (g_pic_isr[0] & b) { g_pic_isr[0] = (u8)(g_pic_isr[0] & (u8)~b); return; }
                if (g_pic_isr[1] & b) { g_pic_isr[1] = (u8)(g_pic_isr[1] & (u8)~b); return; }
            }
        }
    }
}

/* ---------------- 8254 PIT ---------------- */

static u8 pit_read(u32 port)
{
    u32 ch = port - 0x40;
    if (ch > 2) return 0xff;
    if (g_m.pit.rw_phase[ch] == 2) {
        g_m.pit.rw_phase[ch] = 1;
        return (u8)(g_m.pit.count[ch] >> 8);
    }
    if (g_m.pit.access[ch] == 3)
        g_m.pit.rw_phase[ch] = 2;
    return (u8)g_m.pit.count[ch];
}

static void pit_write(u32 port, u8 v)
{
    if (port == 0x43) {
        u32 ch = (u32)(v >> 6);
        if (ch == 3) return;
        g_m.pit.access[ch] = (u8)((v >> 4) & 3);
        g_m.pit.mode[ch] = (u8)((v >> 1) & 7);
        g_m.pit.rw_phase[ch] = 0;
        return;
    }
    {
        u32 ch = port - 0x40;
        u32 hi = 0;
        if (ch > 2) return;
        if (g_m.pit.access[ch] == 1) { g_m.pit.reload[ch] = v; return; }
        if (g_m.pit.access[ch] == 2) { g_m.pit.reload[ch] = (u32)v << 8; return; }
        hi = (g_m.pit.rw_phase[ch] == 1) ? 1 : 0;
        if (hi) {
            g_m.pit.reload[ch] = (g_m.pit.reload[ch] & 0xff) | ((u32)v << 8);
            g_m.pit.count[ch] = g_m.pit.reload[ch];
            g_m.pit.rw_phase[ch] = 0;
        } else {
            g_m.pit.reload[ch] = v;
            g_m.pit.rw_phase[ch] = 1;
        }
    }
}

/* ---------------- CMOS / RTC ----------------
 * 以前 0x71 一律返回 0，guest 开机时间停在 1999-11-30，HTTPS 的 X.509
 * 证书校验必然失败（certificate verify failed）。这里按 mc146818 的
 * 寄存器布局返回宿主 UTC 时间：BCD、24 小时制、状态 A 无 UIP、状态 D
 * 置 VRT。只读；guest 写时间不落盘（内核启动后自己用 PIT/TSC 走时）。
 */
static u8 g_cmos_idx = 0;

/* 页面/Node 前端可以调 sim_set_rtc() 把宿主时间传进来（wasm 没有
 * CLOCK_REALTIME；固定常量会让 HTTPS 证书随时间过期）。 */
static u64 g_rtc_override = 0;

void rtc_set_epoch(u64 t)
{
    g_rtc_override = t;
}

#if !defined(C6_WASM)
struct rtc_ts { long tv_sec; long tv_nsec; };
extern int clock_gettime(int clk, struct rtc_ts *ts);
#define RTC_CLOCK_REALTIME 0

static u64 rtc_epoch(void)
{
    struct rtc_ts ts = {0};
    if (g_rtc_override != 0) return g_rtc_override;
    if (clock_gettime(RTC_CLOCK_REALTIME, &ts) != 0) return 0;
    return (u64)ts.tv_sec;
}
#else
static u64 rtc_epoch(void)
{
    return g_rtc_override ? g_rtc_override : 1795000000ull;
}
#endif

static u8 rtc_bcd(u32 v)
{
    return (u8)((((v / 10u) & 0x0fu) << 4) | (v % 10u));
}

static u8 cmos_read(void)
{
    u64 t = rtc_epoch();
    u64 days = 0, z = 0, era = 0, doe = 0, yoe = 0, y = 0, doy = 0, mp = 0;
    u64 dd = 0, mm = 0;
    u32 sod = 0, hh = 0, mi = 0, ss = 0, wd = 0;
    days = t / 86400ull;
    sod = (u32)(t % 86400ull);
    /* days -> 公历年月日（civil_from_days，1970-01-01 起） */
    z = days + 719468ull;
    era = z / 146097ull;
    doe = z - era * 146097ull;
    yoe = (doe - doe / 1460ull + doe / 36524ull - doe / 146096ull) / 365ull;
    y = yoe + era * 400ull;
    doy = doe - (365ull * yoe + yoe / 4ull - yoe / 100ull);
    mp = (5ull * doy + 2ull) / 153ull;
    dd = doy - (153ull * mp + 2ull) / 5ull + 1ull;
    mm = (mp < 10ull) ? (mp + 3ull) : (mp - 9ull);
    if (mm <= 2ull) y = y + 1ull;
    hh = sod / 3600u;
    mi = (sod / 60u) % 60u;
    ss = sod % 60u;
    wd = (u32)((days + 4ull) % 7ull) + 1u;   /* 1970-01-01 是周四；CMOS 1=周日 */
    switch (g_cmos_idx) {
    case 0x00: return rtc_bcd(ss);
    case 0x02: return rtc_bcd(mi);
    case 0x04: return rtc_bcd(hh);
    case 0x06: return rtc_bcd(wd);
    case 0x07: return rtc_bcd((u32)dd);
    case 0x08: return rtc_bcd((u32)mm);
    case 0x09: return rtc_bcd((u32)(y % 100ull));
    case 0x0a: return 0x26;   /* 状态 A：UIP=0，DV=010，RS=0110 */
    case 0x0b: return 0x02;   /* 状态 B：24 小时制 + BCD，不使能中断 */
    case 0x0c: return 0x00;   /* 状态 C：无中断 */
    case 0x0d: return 0x80;   /* 状态 D：VRT（RAM/时间有效） */
    case 0x32: return rtc_bcd((u32)(y / 100ull));   /* 世纪（acpi=off 时不读） */
    default: return 0x00;
    }
}

/* ---------------- I/O 端口分派 ---------------- */

u8 io_r8(u32 port)
{
    if (port >= 0x3f8 && port <= 0x3ff) return serial_read(port);
    if (port >= 0x2f8 && port <= 0x2ff) return serial2_read(port);   /* COM2 */
    if (port >= 0x3f0 && port <= 0x3f7) return 0xff;   /* COM3 未装 */
    if (port == 0x20 || port == 0x21 || port == 0xa0 || port == 0xa1)
        return pic_read(port);
    if (port >= 0x40 && port <= 0x43) return pit_read(port);
    if (port == 0x71) return cmos_read();
    /* PCI 配置地址寄存器 0xcf8..0xcfb 必须能读回（真 82371/440FX 就是这样）：
     * Linux 的 pci_check_type1() 先 outl 0x80000000 再读回比对，读不到就判定
     * "no config space access function found"，整条 PCI 枚举被放弃。 */
    if (port >= 0xcf8 && port <= 0xcfb)
        return (u8)(g_m.pci.addr >> ((port - 0xcf8) * 8));
    /* 配置数据口 0xcfc..0xcff：按字节通道从 config[] 取，inb/inw/inl 都靠
     * 这里的四次 io_r8 拼出来（pci_conf1_read 的 1/2/4 字节读都走这条）。 */
    if (port >= 0xcfc && port <= 0xcff) {
        u32 a = g_m.pci.addr;
        if (!(a & 0x80000000)) return 0xff;
        if (((a >> 16) & 0xff) == 0 && ((a >> 11) & 0x1f) == 0 && ((a >> 8) & 7) == 0)
            return g_m.pci.config[(a & 0xfc) | (port & 3)];
        return 0xff;
    }
    return 0xff;
}

u16 io_r16(u32 port)
{
    return (u16)io_r8(port) | ((u16)io_r8(port + 1) << 8);
}

u32 io_r32(u32 port)
{
    return (u32)io_r8(port) | ((u32)io_r8(port + 1) << 8) |
           ((u32)io_r8(port + 2) << 16) | ((u32)io_r8(port + 3) << 24);
}

void io_w8(u32 port, u8 v)
{
    if (port >= 0x3f8 && port <= 0x3ff) { serial_write(port, v); return; }
    if (port >= 0x2f8 && port <= 0x2ff) { serial2_write(port, v); return; }
    if (port == 0x20 || port == 0x21 || port == 0xa0 || port == 0xa1) {
        pic_write(port, v);
        return;
    }
    if (port >= 0x40 && port <= 0x43) { pit_write(port, v); return; }
    if (port == 0x70) { g_cmos_idx = (u8)(v & 0x7fu); return; }
    if (port == 0x71) return;   /* RTC 只读：写时间不落盘 */
    /* 配置地址/数据口的字节写：按字节通道落到 addr / config[]，和真硬件
     * 一致（outb 到 0xcfb 只能改地址最高字节）。inb/inw/inl 写由 io_w32
     * 拆成四次 io_w8。 */
    if (port >= 0xcf8 && port <= 0xcfb) {
        u32 sh = (port - 0xcf8) * 8;
        u32 m = 0xffu << sh;
        g_m.pci.addr = (g_m.pci.addr & ~m) | ((((u32)v) << sh) & m);
        return;
    }
    if (port >= 0xcfc && port <= 0xcff) {
        u32 a = g_m.pci.addr;
        if ((a & 0x80000000) && ((a >> 16) & 0xff) == 0 &&
            ((a >> 11) & 0x1f) == 0 && ((a >> 8) & 7) == 0) {
            u32 off = (a & 0xfc) | (port & 3);
            /* 0x10..0x30 是 6 个 BAR + CardBus/子系统 + ROM BAR：本机一个都
             * 没实现，按真硬件语义读回 0、忽略写。否则内核探测 BAR 大小时
             * 写 0xffffffff 会把这个「假设备」报成 4GiB 资源。 */
            if (off < 0x10 || off > 0x30)
                g_m.pci.config[off] = v;
        }
        return;
    }
#if !defined(C6_WASM)
    /* 0xf4/0xfe 是 QEMU 风格的关机端口，只有 native 的验收脚本需要；
     * wasm 里内核早期偶发误写这个端口会把整机停掉，这里在 wasm 侧忽略。 */
    if (port == 0xf4 || port == 0xfe) {
#if !defined(C6_WASM)
        printf("[OFF] port=%x val=%x rip=%llx insns=%llu\n",
               port, (u32)v, (unsigned long long)g_m.cur_rip,
               (unsigned long long)g_m.instructions);
        fflush(stdout);
#endif
        g_m.halted = 1;
        g_m.exit_code = (u32)v;
        g_m.cpu.halted = 1;
    }
#endif
}

void io_w16(u32 port, u16 v)
{
    if (port == 0xcf8) { g_m.pci.addr = v | (g_m.pci.addr & 0xffff0000); return; }
    io_w8(port, (u8)v);
    io_w8(port + 1, (u8)(v >> 8));
}

void io_w32(u32 port, u32 v)
{
    if (port == 0xcf8) { g_m.pci.addr = v; return; }
    io_w8(port, (u8)v);
    io_w8(port + 1, (u8)(v >> 8));
    io_w8(port + 2, (u8)(v >> 16));
    io_w8(port + 3, (u8)(v >> 24));
}

/* ---------------- LAPIC MMIO ---------------- */

static u32 g_virtio_net_regs[64];
static u32 g_c6blk_regs[64];

u64 mmio_r(u64 addr, u32 size)
{
    u64 off = addr - LAPIC_PA;
    u64 v = 0;
    if (addr >= VIRTIO_NET_PA && addr < VIRTIO_NET_PA + 0x1000)
        return g_virtio_net_regs[(addr - VIRTIO_NET_PA) >> 2];
    if (addr >= C6BLK_PA && addr < C6BLK_PA + 0x1000)
        return g_c6blk_regs[(addr - C6BLK_PA) >> 2];
    if (off == 0x20) v = 0;                  /* ID */
    else if (off == 0x30) v = 0x00050014;    /* LVR */
    else if (off == 0x80) v = g_m.lapic_tpr;
    else if (off == 0xd0) v = g_m.lapic_ldr;
    else if (off == 0xe0) v = 0xffffffff;
    else if (off == 0xf0) v = g_m.lapic_svr;
    else if (off == 0x300) v = g_m.lapic_icr;
    else if (off == 0x320) v = 0;
    else if (off == 0x328) v = 0;
    else if (off == 0x380) v = 0;
    return v;
}

void mmio_w(u64 addr, u32 size, u64 val)
{
    u64 off = addr - LAPIC_PA;
    if (addr >= VIRTIO_NET_PA && addr < VIRTIO_NET_PA + 0x1000) {
        g_virtio_net_regs[(addr - VIRTIO_NET_PA) >> 2] = (u32)val;
        return;
    }
    if (addr >= C6BLK_PA && addr < C6BLK_PA + 0x1000) {
        g_c6blk_regs[(addr - C6BLK_PA) >> 2] = (u32)val;
        return;
    }
    if (off == 0x20) g_m.lapic_id = (u32)val & 0xff;
    else if (off == 0x80) g_m.lapic_tpr = (u32)val & 0xff;
    else if (off == 0xb0) g_m.lapic_eoi = (u32)val;
    else if (off == 0xd0) g_m.lapic_ldr = (u32)val;
    else if (off == 0xf0) g_m.lapic_svr = (u32)val;
    else if (off == 0x310) g_m.lapic_icr2 = (u32)val;
    else if (off == 0x300) {
        /* ICR 低半：向量 0..7、投递模式 8..10、简写 18..19。
         * 单 CPU 上 self/broadcast 的 fixed IPI 与 NMI 也必须真的投递，
         * 否则内核的自检/唤醒路径会空转。 */
        u32 lo = (u32)val;
        u32 dm = (lo >> 8) & 7;
        u32 sh = (lo >> 18) & 3;
        u32 vec = lo & 0xff;
        g_m.lapic_icr = lo;
        if (dm == 4) {
            raise_irq(&g_m.cpu, 2);                 /* NMI */
        } else if (dm == 0 && vec != 0) {
            if (sh != 0 || (g_m.lapic_icr2 >> 24) == (g_m.lapic_id & 0xff))
                raise_irq(&g_m.cpu, vec);
        }
    }
}

/* ---------------- 初始化与时钟 ---------------- */

void dev_init(void)
{
    struct SerialState *s = &g_m.serial;
    u32 i = 0;
    s->lcr = 0x03;
    s->lsr = 0x60;
    s->msr = 0xb0;
    s->iir = 1;
    g_m.pic.icw2[0] = 0x20;
    g_m.pic.icw2[1] = 0x28;
    g_pic_imr[0] = 0xff;
    g_pic_imr[1] = 0xff;
    g_m.lapic_svr = 0x000001ff;
    g_m.lapic_lvr = 0x00050014;
    for (i = 0; i < 3; i++) {
        g_m.pit.access[i] = 3;
        g_m.pit.mode[i] = 3;
    }
    g_m.pit.reload[0] = 11932;
    g_m.pit.count[0] = 11932;
    /* 0 号设备 = i440FX 主机桥（8086:1237），只放一个设备让内核有东西可枚举。
     * 头布局按 PCI 规范：0x09 prog-if / 0x0a subclass / 0x0b base class，
     * 0x0e header type。status 不带 capability 链（0x10 位），否则内核会去
     * 0x34 找空指针。 */
    g_m.pci.config[0] = 0x86;             /* vendor 0x8086 */
    g_m.pci.config[1] = 0x80;
    g_m.pci.config[2] = 0x37;             /* device 0x1237 */
    g_m.pci.config[3] = 0x12;
    g_m.pci.config[4] = 0x00;             /* COMMAND */
    g_m.pci.config[5] = 0x00;
    g_m.pci.config[6] = 0x00;             /* STATUS */
    g_m.pci.config[7] = 0x00;
    g_m.pci.config[8] = 0x02;             /* revision */
    g_m.pci.config[9] = 0x00;             /* prog-if */
    g_m.pci.config[10] = 0x00;            /* subclass */
    g_m.pci.config[11] = 0x06;            /* base class: 0x060000 host bridge */
    g_m.pci.config[12] = 0x00;            /* cache line */
    g_m.pci.config[13] = 0x00;            /* latency */
    g_m.pci.config[14] = 0x00;            /* header type: 普通设备 */
    g_m.pci.config[15] = 0x00;            /* BIST */
    g_virtio_net_regs[0] = 0x74726976;  /* 'virt' */
    g_c6blk_regs[0] = 0x74726976;
    serial2_reset();
#if !defined(C6_WASM)
    net_reset();
#endif
}

/* 每个 run slice 末尾调用：推进 PIT，投递最高优先级的未屏蔽中断 */
u64 raise_state_pack(void)
{
    u64 v = 0;
    v |= (u64)(g_raise_cnt[0] & 0xffffffffu);
    v |= (u64)(g_raise_cnt[1] & 0xffffffffu) << 32;
    v |= (u64)(g_tick_cnt & 0xffffu) << 48;   /* 可能回绕，够用 */
    return v;
}

u64 pit_phase_pack(void)
{
    u64 v = 0;
    v |= (g_m.last_pit_tsc & 0xffffffffull);
    v |= (u64)(g_m.pit.mode[0] & 0x7u) << 32;
    v |= (u64)(g_m.pit.access[0] & 0x3u) << 35;
    v |= (u64)(g_m.pit.count[0] & 0xffffu) << 40;
    v |= (u64)(g_m.pit.reload[0] & 0xffffu) << 56;
    return v;
}

u64 clock_state_pack(void)
{
    u64 v = 0;
    v |= (g_m.tsc & 0xffffffffull);
    v |= (u64)(g_m.pit.count[0] & 0xffffu) << 32;
    v |= (u64)(g_m.pit.reload[0] & 0xffffu) << 48;
    return v;
}

u64 pic_state_pack(void)
{
    u64 v = 0;
    v |= (u64)(g_pic_irr[0] & 0xff);
    v |= (u64)(g_pic_isr[0] & 0xff) << 8;
    v |= (u64)(g_pic_imr[0] & 0xff) << 16;
    v |= (u64)(g_pic_irr[1] & 0xff) << 24;
    v |= (u64)(g_pic_isr[1] & 0xff) << 32;
    v |= (u64)(g_pic_imr[1] & 0xff) << 40;
    return v;
}

void dev_tick(void)
{
        u64 delta = g_m.tsc - g_m.last_pit_tsc;
    u32 i = 0;
    u8 irq = 0;
    u8 found = 0;

#if !defined(C6_WASM)
    /* 网络在设备轮询里推进：HLT 等网络包时 dev_tick 会在 idle 循环里被高频
     * 调用，net_tick() 内部按墙钟 1ms 节流，不会空转。 */
    net_tick();
#endif
    /* COM2 的 RX/THRE 同样是电平中断（wasm 侧 ISR 由 JS 喂字节/回包） */
    if ((g_s2.ier & 1) && g_s2.in_head != g_s2.in_tail)
        pic_raise(&g_m, 3);
    else if ((g_s2.ier & 2) && g_s2.thre_pending)
        pic_raise(&g_m, 3);

    /* 串口的 RX/THRE 是**电平**中断：只要使能位还开着、条件还成立，中断线就
     * 一直有效。只在「写 THR / 写 IER」补边沿会丢中断：驱动在 tx_loadsz 一批
     * 写完之后 THRI 仍然开着，tty 层这时再排数据进来只会调 start_tx，而
     * start_tx 看到 THRI 已置位就不再写 IER —— 边沿没了，驱动永远等不到发送
     * 完成中断，tty 写永久阻塞（控制台输出卡在一行中间、top 不刷新）。
     * 这里按硬件语义在每次设备轮询（每 0x40000 条指令）把电平重新拉进 IRR。
     * 代价是引导期 irq4 从 181 涨到约 4.2k（每 200k 条一次），实测 900M 引导
     * 墙钟仍在 47~53s 区间，可忽略。 */
    if ((g_m.serial.ier & 1) && g_m.serial.in_head != g_m.serial.in_tail)
        pic_raise(&g_m, 4);
    else if ((g_m.serial.ier & 2) && (g_m.serial.lsr & 0x20))
        pic_raise(&g_m, 4);

    if (delta > 0) {
        g_tick_cnt = g_tick_cnt + 1;
        /* mode 2 = 频率发生器，mode 3 = 方波，两者都是周期性中断 */
        if (g_m.pit.reload[0] > 0 && (g_m.pit.mode[0] == 2 || g_m.pit.mode[0] == 3)) {
            u64 sub = delta;
            if (sub > 0xffffffffu) sub = 0xffffffffu;
            if (g_m.pit.count[0] > sub)
                g_m.pit.count[0] -= (u32)sub;
            else {
                g_m.pit.count[0] = g_m.pit.reload[0];
                pic_raise(&g_m, 0);
            }
        }
        g_m.last_pit_tsc = g_m.tsc;
    }

    if (!(g_m.cpu.flags & RF_IF) || g_m.cpu.exc_pending)
        return;

    /* 主片：最低优先级的未屏蔽、未在服务中的请求 */
    {
        u8 pm = (u8)(g_pic_irr[0] & ~g_pic_isr[0] & ~g_pic_imr[0]);
        u8 ps = (u8)(g_pic_irr[1] & ~g_pic_isr[1] & ~g_pic_imr[1]);
        u32 vec = 0;
        u32 deliver = 0;
        u32 b = 0;
        u32 c = 0;
        if (pm != 0) {
            for (b = 0; b < 8; b++) {
                if (pm & (1u << b)) break;
            }
            if (b != 2) {
                { u8 t2 = g_pic_irr[0]; t2 = (u8)(t2 & (u8)~(1u << b)); g_pic_irr[0] = t2; }
                { u8 t3 = g_pic_isr[0]; t3 = (u8)(t3 | (u8)(1u << b)); g_pic_isr[0] = t3; }
                vec = g_m.pic.icw2[0] + b;
                deliver = 1;
            } else if (ps != 0) {
                for (c = 0; c < 8; c++) {
                    if (ps & (1u << c)) break;
                }
                /* 级联：主片 IRQ2 进入服务，从片对应位进入服务 */
                { u8 t4 = g_pic_irr[0]; t4 = (u8)(t4 & (u8)~4); g_pic_irr[0] = t4; }
                { u8 t5 = g_pic_isr[0]; t5 = (u8)(t5 | 4); g_pic_isr[0] = t5; }
                { u8 t6 = g_pic_irr[1]; t6 = (u8)(t6 & (u8)~(1u << c)); g_pic_irr[1] = t6; }
                { u8 t7 = g_pic_isr[1]; t7 = (u8)(t7 | (u8)(1u << c)); g_pic_isr[1] = t7; }
                vec = g_m.pic.icw2[1] + c;
                deliver = 1;
            }
        }
        (void)i;
        (void)irq;
        (void)found;
        if (deliver)
            raise_irq(&g_m.cpu, vec);
    }
}
