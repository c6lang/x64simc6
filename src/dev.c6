/* dev.c6 —— 最小设备模型：16550A / 8259A / 8254 / CMOS / PCI / LAPIC */
#include "c6sim.h"

/* ---------------- 串口环形缓冲 ---------------- */

/* c6 wasm 后端对「结构体内的数组元素」读写会出错（isr/irr/imr 位丢失），
 * 这三组 PIC 位图改用独立全局，读写都走平坦地址。 */
u8 g_pic_irr[2] = {0, 0};
u8 g_pic_isr[2] = {0, 0};
u8 g_pic_imr[2] = {0, 0};
int serial_take_output(u8 *dst, int cap)
{
    int n = 0;
    while (n < cap && g_m.serial.out_tail != g_m.serial.out_head) {
        dst[n] = g_m.serial.out[(u32)g_m.serial.out_tail & 0xffff];
        g_m.serial.out_tail++;
        n++;
    }
    return n;
}

void serial_feed(const u8 *src, int len)
{
    int i = 0;
    for (i = 0; i < len; i++) {
        g_m.serial.in[(u32)g_m.serial.in_head & 0xfff] = src[i];
        g_m.serial.in_head++;
    }
    if (len > 0) {
        if (!(g_m.serial.lsr & 1)) {
            g_m.serial.lsr |= 1;                 /* DR */
            if (g_m.serial.ier & 1)
                pic_raise(&g_m, 4);
        }
    }
}

static u8 serial_read(u32 port)
{
    u32 off = port & 7;
    if (g_m.serial.lcr & 0x80) {
        if (off == 0) return g_m.serial.dll;
        if (off == 1) return g_m.serial.dlm;
    }
    if (off == 0) {
        if (g_m.serial.in_tail != g_m.serial.in_head) {
            g_m.serial.rbr = g_m.serial.in[(u32)g_m.serial.in_tail & 0xfff];
            g_m.serial.in_tail++;
            if (g_m.serial.in_tail == g_m.serial.in_head)
                g_m.serial.lsr &= ~((u8)1);
        }
        return g_m.serial.rbr;
    }
    if (off == 1) return g_m.serial.ier;
    if (off == 2) {
        if ((g_m.serial.ier & 1) && (g_m.serial.in_tail != g_m.serial.in_head)) return 4;  /* RBR */
        if (g_m.serial.ier & 2) return 2;                                  /* THRE */
        return 1;                                                  /* none */
    }
    if (off == 3) return g_m.serial.lcr;
    if (off == 4) return g_m.serial.mcr;
    if (off == 5) return g_m.serial.lsr;
    if (off == 6) return g_m.serial.msr;
    return g_m.serial.fcr;
}

static void serial_write(u32 port, u8 v)
{
    u32 off = port & 7;
    if (g_m.serial.lcr & 0x80) {
        if (off == 0) { g_m.serial.dll = v; return; }
        if (off == 1) { g_m.serial.dlm = v; return; }
    }
    switch (off) {
    case 0:
        g_m.serial.out[(u32)g_m.serial.out_head & 0xffff] = v;
        g_m.serial.out_head++;
        g_m.serial.lsr |= 0x40;
        if (g_m.serial.ier & 2)
            pic_raise(&g_m, 4);
        break;
    case 1: g_m.serial.ier = v; break;
    case 2: g_m.serial.fcr = v; break;
    case 3: g_m.serial.lcr = v; break;
    case 4: g_m.serial.mcr = v; break;
    default: break;
    }
}

/* ---------------- 8259A PIC ---------------- */

void pic_raise(struct Machine *m, u8 irq)
{
    u8 bit = (u8)(1 << (irq & 7));
    (void)m;
    if (irq > 15) return;
    if (irq < 8) {
        if (!(g_pic_imr[0] & bit)) {
            u8 t0 = g_pic_irr[0];
            t0 = (u8)(t0 | bit);
            g_pic_irr[0] = t0;
        }
    } else {
        if (!(g_pic_imr[1] & bit)) {
            u8 t1 = g_pic_irr[1];
            t1 = (u8)(t1 | bit);
            g_pic_irr[1] = t1;
        }
    }
}

static u8 pic_read(u32 port)
{
    if (port == 0x20 || port == 0xa0) {
        u32 i = (port == 0xa0) ? 1 : 0;
        return g_m.pic.read_isr ? g_pic_isr[i] : g_pic_irr[i];
    }
    if (port == 0x21) return g_pic_imr[0];
    if (port == 0xa1) return g_pic_imr[1];
    return 0xff;
}

static void pic_write(u32 port, u8 v)
{
    u32 slave = (port >= 0xa0) ? 1 : 0;
    u32 cmd_port = slave ? 0xa0 : 0x20;
    u32 data_port = slave ? 0xa1 : 0x21;
    /* 初始化序列期间，数据口上的写是 ICW2/ICW3/ICW4，不是 IMR */
    if (port == data_port && g_m.pic.init_state[slave] != 0) {
        if (g_m.pic.init_state[slave] == 1) { g_m.pic.icw2[slave] = v; g_m.pic.init_state[slave] = 2; return; }
        if (g_m.pic.init_state[slave] == 2) { g_m.pic.icw3[slave] = v; g_m.pic.init_state[slave] = 3; return; }
        g_m.pic.icw4[slave] = v;
        g_m.pic.init_state[slave] = 0;
        return;
    }
    if (port == data_port) { g_pic_imr[slave] = v; return; }
    if (port != cmd_port) return;

    if (v & 0x10) {                    /* ICW1 */
        g_m.pic.icw1 = v;
        g_m.pic.init_state[slave] = ((v & 1) != 0) ? 2 : 3;   /* 是否需要 ICW4 */
        g_m.pic.icw4[slave] = 0;
        if (v & 1) g_m.pic.init_state[slave] = 1;
        g_pic_imr[slave] = 0xff;
        g_pic_irr[slave] = 0;
        g_pic_isr[slave] = 0;
        g_m.pic.icw2[slave] = slave ? 0x28 : 0x20;
        return;
    }
    if (v & 0x08) { g_m.pic.read_isr = (v & 2) ? 1 : 0; return; }   /* OCW3 */
    if (v & 0x20) {                                            /* EOI */
        u32 i = 0;
        u8 b = 0;
        if (v & 0x40) { g_pic_isr[0] = 0; g_pic_isr[1] = 0; return; }
        for (i = 0; i < 8; i++) {
            b = (u8)(1 << i);
            if (g_pic_isr[1] & b) { g_pic_isr[1] = (u8)(g_pic_isr[1] & (u8)~b); return; }
            if (g_pic_isr[0] & b) { g_pic_isr[0] = (u8)(g_pic_isr[0] & (u8)~b); return; }
        }
    }
}

/* ---------------- 8254 PIT ---------------- */

static u8 pit_read(u32 port)
{
    u32 ch = port - 0x40;
    if (ch > 2) return 0xff;
    if (g_m.pit.rw_phase[ch] == 2) {
        g_m.pit.rw_phase[ch] = 1;
        return (u8)(g_m.pit.count[ch] >> 8);
    }
    if (g_m.pit.access[ch] == 3)
        g_m.pit.rw_phase[ch] = 2;
    return (u8)g_m.pit.count[ch];
}

static void pit_write(u32 port, u8 v)
{
    if (port == 0x43) {
        u32 ch = (u32)(v >> 6);
        if (ch == 3) return;
        g_m.pit.access[ch] = (u8)((v >> 4) & 3);
        g_m.pit.mode[ch] = (u8)((v >> 1) & 7);
        g_m.pit.rw_phase[ch] = 0;
        return;
    }
    {
        u32 ch = port - 0x40;
        u32 hi = 0;
        if (ch > 2) return;
        if (g_m.pit.access[ch] == 1) { g_m.pit.reload[ch] = v; return; }
        if (g_m.pit.access[ch] == 2) { g_m.pit.reload[ch] = (u32)v << 8; return; }
        hi = (g_m.pit.rw_phase[ch] == 1) ? 1 : 0;
        if (hi) {
            g_m.pit.reload[ch] = (g_m.pit.reload[ch] & 0xff) | ((u32)v << 8);
            g_m.pit.count[ch] = g_m.pit.reload[ch];
            g_m.pit.rw_phase[ch] = 0;
        } else {
            g_m.pit.reload[ch] = v;
            g_m.pit.rw_phase[ch] = 1;
        }
    }
}

/* ---------------- I/O 端口分派 ---------------- */

u8 io_r8(u32 port)
{
    if (port >= 0x3f8 && port <= 0x3ff) return serial_read(port);
    if (port >= 0x3f0 && port <= 0x3f7) return 0xff;   /* COM2 未装 */
    if (port == 0x20 || port == 0x21 || port == 0xa0 || port == 0xa1)
        return pic_read(port);
    if (port >= 0x40 && port <= 0x43) return pit_read(port);
    if (port == 0x71) return 0;
    if (port == 0xcfc) {
        u32 a = g_m.pci.addr;
        if (!(a & 0x80000000)) return 0xff;
        if (((a >> 16) & 0xff) == 0 && ((a >> 11) & 0x1f) == 0 && ((a >> 8) & 7) == 0)
            return g_m.pci.config[a & 0xfc];
        return 0xff;
    }
    if (port == 0xcfd || port == 0xcfe || port == 0xcff)
        return 0xff;
    return 0xff;
}

u16 io_r16(u32 port)
{
    return (u16)io_r8(port) | ((u16)io_r8(port + 1) << 8);
}

u32 io_r32(u32 port)
{
    return (u32)io_r8(port) | ((u32)io_r8(port + 1) << 8) |
           ((u32)io_r8(port + 2) << 16) | ((u32)io_r8(port + 3) << 24);
}

void io_w8(u32 port, u8 v)
{
    if (port >= 0x3f8 && port <= 0x3ff) { serial_write(port, v); return; }
    if (port == 0x20 || port == 0x21 || port == 0xa0 || port == 0xa1) {
        pic_write(port, v);
        return;
    }
    if (port >= 0x40 && port <= 0x43) { pit_write(port, v); return; }
    if (port == 0x70) return;
    if (port == 0x71) return;
    if (port == 0xcf8) {
        g_m.pci.addr = ((u32)v) | (g_m.pci.addr & 0xffffff00);
        return;
    }
    if (port == 0xcfc) {
        u32 a = g_m.pci.addr;
        if ((a & 0x80000000) && ((a >> 16) & 0xff) == 0 &&
            ((a >> 11) & 0x1f) == 0 && ((a >> 8) & 7) == 0)
            g_m.pci.config[a & 0xfc] = v;
        return;
    }
#if !defined(C6_WASM)
    /* 0xf4/0xfe 是 QEMU 风格的关机端口，只有 native 的验收脚本需要；
     * wasm 里内核早期偶发误写这个端口会把整机停掉，这里在 wasm 侧忽略。 */
    if (port == 0xf4 || port == 0xfe) {
#if !defined(C6_WASM)
        printf("[OFF] port=%x val=%x rip=%llx insns=%llu\n",
               port, (u32)v, (unsigned long long)g_m.cur_rip,
               (unsigned long long)g_m.instructions);
        fflush(stdout);
#endif
        g_m.halted = 1;
        g_m.exit_code = (u32)v;
        g_m.cpu.halted = 1;
    }
#endif
}

void io_w16(u32 port, u16 v)
{
    if (port == 0xcf8) { g_m.pci.addr = v | (g_m.pci.addr & 0xffff0000); return; }
    io_w8(port, (u8)v);
    io_w8(port + 1, (u8)(v >> 8));
}

void io_w32(u32 port, u32 v)
{
    if (port == 0xcf8) { g_m.pci.addr = v; return; }
    io_w8(port, (u8)v);
    io_w8(port + 1, (u8)(v >> 8));
    io_w8(port + 2, (u8)(v >> 16));
    io_w8(port + 3, (u8)(v >> 24));
}

/* ---------------- LAPIC MMIO ---------------- */

static u32 g_virtio_net_regs[64];
static u32 g_c6blk_regs[64];

u64 mmio_r(u64 addr, u32 size)
{
    u64 off = addr - LAPIC_PA;
    u64 v = 0;
    if (addr >= VIRTIO_NET_PA && addr < VIRTIO_NET_PA + 0x1000)
        return g_virtio_net_regs[(addr - VIRTIO_NET_PA) >> 2];
    if (addr >= C6BLK_PA && addr < C6BLK_PA + 0x1000)
        return g_c6blk_regs[(addr - C6BLK_PA) >> 2];
    if (off == 0x20) v = 0;                  /* ID */
    else if (off == 0x30) v = 0x00050014;    /* LVR */
    else if (off == 0x80) v = g_m.lapic_tpr;
    else if (off == 0xd0) v = g_m.lapic_ldr;
    else if (off == 0xe0) v = 0xffffffff;
    else if (off == 0xf0) v = g_m.lapic_svr;
    else if (off == 0x300) v = g_m.lapic_icr;
    else if (off == 0x320) v = 0;
    else if (off == 0x328) v = 0;
    else if (off == 0x380) v = 0;
    return v;
}

void mmio_w(u64 addr, u32 size, u64 val)
{
    u64 off = addr - LAPIC_PA;
    if (addr >= VIRTIO_NET_PA && addr < VIRTIO_NET_PA + 0x1000) {
        g_virtio_net_regs[(addr - VIRTIO_NET_PA) >> 2] = (u32)val;
        return;
    }
    if (addr >= C6BLK_PA && addr < C6BLK_PA + 0x1000) {
        g_c6blk_regs[(addr - C6BLK_PA) >> 2] = (u32)val;
        return;
    }
    if (off == 0x20) g_m.lapic_id = (u32)val & 0xff;
    else if (off == 0x80) g_m.lapic_tpr = (u32)val & 0xff;
    else if (off == 0xb0) g_m.lapic_eoi = (u32)val;
    else if (off == 0xd0) g_m.lapic_ldr = (u32)val;
    else if (off == 0xf0) g_m.lapic_svr = (u32)val;
    else if (off == 0x310) g_m.lapic_icr2 = (u32)val;
    else if (off == 0x300) {
        /* ICR 低半：向量 0..7、投递模式 8..10、简写 18..19。
         * 单 CPU 上 self/broadcast 的 fixed IPI 与 NMI 也必须真的投递，
         * 否则内核的自检/唤醒路径会空转。 */
        u32 lo = (u32)val;
        u32 dm = (lo >> 8) & 7;
        u32 sh = (lo >> 18) & 3;
        u32 vec = lo & 0xff;
        g_m.lapic_icr = lo;
        if (dm == 4) {
            raise_irq(&g_m.cpu, 2);                 /* NMI */
        } else if (dm == 0 && vec != 0) {
            if (sh != 0 || (g_m.lapic_icr2 >> 24) == (g_m.lapic_id & 0xff))
                raise_irq(&g_m.cpu, vec);
        }
    }
}

/* ---------------- 初始化与时钟 ---------------- */

void dev_init(void)
{
    struct SerialState *s = &g_m.serial;
    u32 i = 0;
    s->lcr = 0x03;
    s->lsr = 0x60;
    s->msr = 0xb0;
    s->iir = 1;
    g_m.pic.icw2[0] = 0x20;
    g_m.pic.icw2[1] = 0x28;
    g_pic_imr[0] = 0xff;
    g_pic_imr[1] = 0xff;
    g_m.lapic_svr = 0x000001ff;
    g_m.lapic_lvr = 0x00050014;
    for (i = 0; i < 3; i++) {
        g_m.pit.access[i] = 3;
        g_m.pit.mode[i] = 3;
    }
    g_m.pit.reload[0] = 11932;
    g_m.pit.count[0] = 11932;
    g_m.pci.config[0] = 0x86;             /* vendor 0x8086 */
    g_m.pci.config[1] = 0x80;
    g_m.pci.config[2] = 0x37;             /* device 0x1237 */
    g_m.pci.config[3] = 0x12;
    g_m.pci.config[4] = 0x07;             /* COMMAND */
    g_m.pci.config[6] = 0x10;
    g_m.pci.config[8] = 0x00;             /* class 0x060000 */
    g_m.pci.config[9] = 0x00;
    g_m.pci.config[10] = 0x00;
    g_m.pci.config[12] = 0x00;            /* header type */
    g_m.pci.config[15] = 0x00;
    g_virtio_net_regs[0] = 0x74726976;  /* 'virt' */
    g_c6blk_regs[0] = 0x74726976;
}

/* 每个 run slice 末尾调用：推进 PIT，投递最高优先级的未屏蔽中断 */
u64 pic_state_pack(void)
{
    u64 v = 0;
    v |= (u64)(g_pic_irr[0] & 0xff);
    v |= (u64)(g_pic_isr[0] & 0xff) << 8;
    v |= (u64)(g_pic_imr[0] & 0xff) << 16;
    v |= (u64)(g_pic_irr[1] & 0xff) << 24;
    v |= (u64)(g_pic_isr[1] & 0xff) << 32;
    v |= (u64)(g_pic_imr[1] & 0xff) << 40;
    return v;
}

void dev_tick(void)
{
        u64 delta = g_m.tsc - g_m.last_pit_tsc;
    u32 i = 0;
    u8 irq = 0;
    u8 found = 0;

    if (delta > 0) {
        /* mode 2 = 频率发生器，mode 3 = 方波，两者都是周期性中断 */
        if (g_m.pit.reload[0] > 0 && (g_m.pit.mode[0] == 2 || g_m.pit.mode[0] == 3)) {
            u64 sub = delta;
            if (sub > 0xffffffffu) sub = 0xffffffffu;
            if (g_m.pit.count[0] > sub)
                g_m.pit.count[0] -= (u32)sub;
            else {
                g_m.pit.count[0] = g_m.pit.reload[0];
                pic_raise(&g_m, 0);
            }
        }
        g_m.last_pit_tsc = g_m.tsc;
    }

    if (!(g_m.cpu.flags & RF_IF) || g_m.cpu.exc_pending)
        return;

    /* 主片：最低优先级的未屏蔽、未在服务中的请求 */
    {
        u8 pm = (u8)(g_pic_irr[0] & ~g_pic_isr[0] & ~g_pic_imr[0]);
        u8 ps = (u8)(g_pic_irr[1] & ~g_pic_isr[1] & ~g_pic_imr[1]);
        u32 vec = 0;
        u32 deliver = 0;
        u32 b = 0;
        u32 c = 0;
        if (pm != 0) {
            for (b = 0; b < 8; b++) {
                if (pm & (1u << b)) break;
            }
            if (b != 2) {
                { u8 t2 = g_pic_irr[0]; t2 = (u8)(t2 & (u8)~(1u << b)); g_pic_irr[0] = t2; }
                { u8 t3 = g_pic_isr[0]; t3 = (u8)(t3 | (u8)(1u << b)); g_pic_isr[0] = t3; }
                vec = g_m.pic.icw2[0] + b;
                deliver = 1;
            } else if (ps != 0) {
                for (c = 0; c < 8; c++) {
                    if (ps & (1u << c)) break;
                }
                /* 级联：主片 IRQ2 进入服务，从片对应位进入服务 */
                { u8 t4 = g_pic_irr[0]; t4 = (u8)(t4 & (u8)~4); g_pic_irr[0] = t4; }
                { u8 t5 = g_pic_isr[0]; t5 = (u8)(t5 | 4); g_pic_isr[0] = t5; }
                { u8 t6 = g_pic_irr[1]; t6 = (u8)(t6 & (u8)~(1u << c)); g_pic_irr[1] = t6; }
                { u8 t7 = g_pic_isr[1]; t7 = (u8)(t7 | (u8)(1u << c)); g_pic_isr[1] = t7; }
                vec = g_m.pic.icw2[1] + c;
                deliver = 1;
            }
        }
        (void)i;
        (void)irq;
        (void)found;
        if (deliver)
            raise_irq(&g_m.cpu, vec);
    }
}
