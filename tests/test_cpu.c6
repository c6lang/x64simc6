/* native 单元测试：链接核心源文件后运行，退出码 0 表示全绿。 */
#include "c6sim.h"

static int failures = 0;

static void check(int ok, const char *what)
{
    if (!ok) { printf("FAIL: %s\n", what); failures++; }
}

static void exec_bytes(u8 *code, u32 len)
{
    u32 i = 0;
    machine_reset();
    g_m.cpu.efer = EFER_SCE | EFER_LME | EFER_LMA | EFER_NXE;
    for (i = 0; i < len; i++) g_m.ram[0x10000 + i] = code[i];
    g_m.cpu.rip = 0x10000;
    cpu_step(&g_m.cpu);
}

int main(void)
{
    u8 name[4] = {97,98,99,100};
    u8 data[5] = {1,2,3,4,5};
    u8 out[5] = {0};
    u8 payload[3] = {0xf4, 0x90, 0xf4};

    machine_reset();
    check(g_m.instructions == 0, "reset instructions");
    check(g_m.halted == 0, "reset halted");
    check(g_m.serial.lsr == 0x60, "serial LSR");
    check(g_m.serial.msr == 0xb0, "serial MSR");
    check(g_m.ram[0] == 0 && g_m.ram[RAM_SIZE - 1] == 0, "RAM zeroed");

    check(sim_hostfs_put(name, 4, data, 5) == 0, "hostfs put");
    check(sim_hostfs_get(name, 4, out, 5) == 5, "hostfs get len");
    check(out[0] == 1 && out[4] == 5, "hostfs get data");

    check(machine_boot_payload(payload, 3, 0x10000) == 0, "boot payload");
    check(g_m.cpu.rip == 0x10000, "boot rip");
    check(g_m.cpu.cr[3] == PML4_PA, "boot cr3");
    check(machine_run(10) == 0, "run payload");
    check(g_m.cpu.halted == 1, "payload halted");

    {
        u8 jne[4] = {0x75, 0x02, 0x90, 0x90};
        exec_bytes(jne, 4);
        g_m.cpu.flags |= RF_ZF;
        g_m.cpu.rip = 0x10000;
        cpu_step(&g_m.cpu);   /* 重新执行 jne：ZF=1 时不跳转 */
        check(g_m.cpu.rip == 0x10002, "JNE with ZF=1 falls through");
        g_m.cpu.flags &= ~RF_ZF;
        g_m.cpu.rip = 0x10000;
        cpu_step(&g_m.cpu);
        check(g_m.cpu.rip == 0x10004, "JNE with ZF=0 jumps");
    }
    {
        u8 lea[8] = {0x48, 0x8d, 0x04, 0x85, 0x78, 0x56, 0x34, 0x12};
        exec_bytes(lea, 8);
        g_m.cpu.r[0] = 2;
        g_m.cpu.rip = 0x10000;
        cpu_step(&g_m.cpu);
        check(g_m.cpu.r[0] == 0x12345680u, "SIB lea rax*4+disp32");
    }

    {
        machine_reset();
        g_m.cpu.efer = EFER_SCE | EFER_LME | EFER_LMA | EFER_NXE;
        g_m.ram[0x10000] = 0x0f;   /* syscall */
        g_m.ram[0x10001] = 0x05;
        g_m.ram[0x10010] = 0x0f;   /* sysret */
        g_m.ram[0x10011] = 0x07;
        g_m.cpu.msr_star = ((u64)0x23 << 48) | ((u64)0x10 << 32);
        g_m.cpu.msr_lstar = 0x10010;
        g_m.cpu.msr_sfmask = 0;
        g_m.cpu.flags = 0x202;
        g_m.cpu.sel[1] = 0x33;
        g_m.cpu.rip = 0x10000;
        cpu_step(&g_m.cpu);
        check(g_m.cpu.rip == 0x10010, "syscall -> LSTAR");
        check(g_m.cpu.r[1] == 0x10002, "syscall saves RIP in RCX");
        check(g_m.cpu.r[11] == 0x202, "syscall saves RFLAGS in R11");
        check(g_m.cpu.sel[1] == 0x10, "syscall CS=STAR[47:32]");
        cpu_step(&g_m.cpu);
        check(g_m.cpu.rip == 0x10002, "sysret restores RCX to RIP");
        check((g_m.cpu.sel[1] & 0xffff) == 0x33, "sysret CS=STAR[63:48]+16|3");
        check(g_m.cpu.flags == 0x202, "sysret restores RFLAGS from R11");
    }

    {
        /* iretq 回用户态：5 槽帧 {RIP,CS,RFLAGS,RSP,SS} */
        u64 sp = 0x14000;
        machine_reset();
        g_m.cpu.efer = EFER_SCE | EFER_LME | EFER_LMA | EFER_NXE;
        g_m.cpu.cr[0] = 0;
        g_m.ram[0x10000] = 0xcf;            /* iretq */
        mem_w64(sp + 0, 0x20000);
        mem_w64(sp + 8, 0x33);
        mem_w64(sp + 16, 0x202);
        mem_w64(sp + 24, 0x30000);
        mem_w64(sp + 32, 0x2b);
        g_m.cpu.r[4] = sp;
        g_m.cpu.rip = 0x10000;
        cpu_step(&g_m.cpu);
        check(g_m.cpu.rip == 0x20000, "iretq returns to user RIP");
        check(g_m.cpu.sel[1] == 0x33, "iretq restores user CS");
        check(g_m.cpu.sel[2] == 0x2b, "iretq restores user SS");
        check(g_m.cpu.r[4] == 0x30000, "iretq restores user RSP");
        check(g_m.cpu.flags == 0x202, "iretq restores RFLAGS");
    }

    {
        /* CPL3 中断换栈：GDT 第 1 项放 64 位 TSS 描述符，TSS.sp0 = 0x15000。
         * TSS 基址特意取 0x07000000（base[31:24] != 0），用来回归描述符基址
         * 解析：把 d1 低 16 位当 base[39:32] 会让基址整体错位。 */
        u64 gdt = 0x1000;
        u64 tss = 0x07000000;
        u64 lim = 0x67;
        u64 d0 = 0;
        u64 d1 = 0;
        machine_reset();
        g_m.cpu.efer = EFER_SCE | EFER_LME | EFER_LMA | EFER_NXE;
        g_m.cpu.cr[0] = 0;                  /* 关分页，测试里全用物理地址 */
        g_m.cpu.cr[3] = 0;
        d0 = (lim & 0xffff) | ((tss & 0xffff) << 16) |
             (((tss >> 16) & 0xff) << 32) | ((u64)0x89 << 40) |
             (((lim >> 16) & 0xf) << 48) | (((tss >> 24) & 0xff) << 56);
        d1 = (tss >> 32) & 0xffffffffull;
        mem_w64(gdt + 8, d0);
        mem_w64(gdt + 16, d1);
        mem_w64(tss + 4, 0x15000);          /* sp0：内核栈顶 */
        g_m.cpu.gdtr_base = gdt;
        g_m.cpu.tr_sel = 0x08;
        /* IDT 第 14 号门（#PF）：selector=0x10，处理器入口 0x30000 */
        mem_w16(0x6000 + 14 * 16 + 0, (u16)(0x30000 & 0xffff));
        mem_w16(0x6000 + 14 * 16 + 2, 0x10);
        mem_w16(0x6000 + 14 * 16 + 4, 0x8e00);
        mem_w16(0x6000 + 14 * 16 + 6, (u16)((0x30000 >> 16) & 0xffff));
        mem_w32(0x6000 + 14 * 16 + 8, (u32)(0x30000 >> 32));
        g_m.cpu.idtr_base = 0x6000;
        g_m.cpu.idtr_limit = 0x0fff;
        g_m.cpu.msr_star = ((u64)0x23 << 48) | ((u64)0x10 << 32);
        g_m.cpu.sel[1] = 0x33;              /* 被中断时在 CPL3 */
        g_m.cpu.sel[2] = 0x2b;
        g_m.cpu.r[4] = 0x30000;             /* 用户栈 */
        g_m.cpu.rip = 0x20000;
        g_m.cpu.flags = 0x202;
        raise_exception(&g_m.cpu, EXC_PF, 1, 4);
        cpu_deliver(&g_m.cpu);
        check(g_m.cpu.r[4] == 0x15000 - 48, "CPL3 delivery switches to TSS.sp0");
        check(g_m.cpu.sel[1] == 0x10, "CPL3 delivery enters kernel CS");
        check(g_m.cpu.rip == 0x30000, "CPL3 delivery jumps to gate offset");
        check(g_m.cpu.sel[2] == 0x18, "CPL3 delivery sets kernel SS");
        check(mem_r64(0x15000 - 48) == 4, "CPL3 frame: error code on top");
        check(mem_r64(0x15000 - 40) == 0x20000, "CPL3 frame: user RIP");
        check(mem_r64(0x15000 - 32) == 0x33, "CPL3 frame: user CS");
        check(mem_r64(0x15000 - 24) == 0x202, "CPL3 frame: RFLAGS");
        check(mem_r64(0x15000 - 16) == 0x30000, "CPL3 frame: user RSP");
        check(mem_r64(0x15000 - 8) == 0x2b, "CPL3 frame: user SS");
    }

    {
        /* 指令长度回归：_start 序言 push rbp; mov rbp,rsp */
        machine_reset();
        g_m.cpu.cr[0] = 0;
        g_m.cpu.sel[1] = 0x10;
        g_m.ram[0x10000] = 0x55;            /* push rbp */
        g_m.ram[0x10001] = 0x48;            /* mov rbp,rsp */
        g_m.ram[0x10002] = 0x89;
        g_m.ram[0x10003] = 0xe5;
        g_m.ram[0x10004] = 0xf4;            /* hlt */
        g_m.cpu.rip = 0x10000;
        g_m.cpu.r[4] = 0x20000;
        g_m.cpu.r[5] = 0x1111;
        cpu_step(&g_m.cpu);
        printf("[L] after push rip=%llx rsp=%llx\n",
               (unsigned long long)g_m.cpu.rip, (unsigned long long)g_m.cpu.r[4]);
        check(g_m.cpu.rip == 0x10001, "push rbp is 1 byte");
        check(g_m.cpu.r[4] == 0x1fff8, "push rbp decrements rsp");
        check(mem_r64(0x1fff8) == 0x1111, "push rbp stores rbp");
        cpu_step(&g_m.cpu);
        check(g_m.cpu.rip == 0x10004, "mov rbp,rsp is 3 bytes");
        check(g_m.cpu.r[5] == 0x1fff8, "mov rbp,rsp copies rsp");
    }

    if (failures == 0) printf("all unit tests passed\n");
    return failures == 0 ? 0 : 1;
}
