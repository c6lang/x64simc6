/* 工具链探针：native + wasm 同一份源码，验证大静态数组与导出函数 */
#include <stdint.h>

static uint8_t g_ram[128U << 20];

int sim_add(int a, int b) { return a + b; }

uint64_t sim_probe(uint64_t x) { return x * 3 + 7; }

int main(void)
{
    g_ram[0] = 42;
    g_ram[(128U << 20) - 1] = 9;
    return (sim_add(g_ram[0], 1) == 43 && sim_probe(5) == 22 &&
            g_ram[(128U << 20) - 1] == 9) ? 0 : 1;
}
